{"code":100000,"msg":"ok","data":{"apps":{"id":"d0c2b806-5a8a-42fd-bdeb-a69fa72cbbf6","app_model_config_id":"dc6fbaf1-f8a9-4b15-8e92-cfe1d914ae32","created_by_account_id":"00000000-0000-0000-0000-000000000000","name":"寄宿在你家的毒舌冰山校花","mode":"chat","icon":"","icon_background":"","status":"","is_demo":false,"is_universal":false,"description":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"zh-CN\"\u003e\n\u003chead\u003e\n    \u003cmeta charset=\"UTF-8\"\u003e\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n    \u003ctitle\u003e寄宿在你家的毒舌冰山校花 - 冷鸢\u003c/title\u003e\n    \u003cstyle\u003e\n        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;700\u0026display=swap');\n        #chat-ui-k8f9b2c1 {\n            --bg-color: #f4f7f9;\n            --card-bg: #ffffff;\n            --text-color: #4a5568;\n            --title-color: #1a202c;\n            --accent-color: #718096;\n            --accent-color-light: #a0aec0;\n            --border-color: #e2e8f0;\n            --highlight-bg: #edf2f7;\n            --button-bg: #2d3748;\n            --button-hover-bg: #1a202c;\n            --success-color: #48bb78;\n            --font-main: 'Noto Serif SC', serif;\n            font-family: var(--font-main);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0;\n            padding: 1.25em;\n            line-height: 1.7;\n            font-weight: 400;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            box-sizing: border-box;\n        }\n        #chat-ui-k8f9b2c1 .container {\n            max-width: 50em;\n            width: 100%;\n            margin: 0 auto;\n            background-color: var(--card-bg);\n            border-radius: 1em;\n            box-shadow: 0 1em 3em rgba(149, 157, 165, 0.2);\n            overflow: hidden;\n            border: 1px solid var(--border-color);\n        }\n        #chat-ui-k8f9b2c1 .header {\n            padding: 2.5em 1.5em;\n            background: linear-gradient(135deg, #2d3748 0%, #4a5568 100%);\n            text-align: center;\n            color: white;\n        }\n        #chat-ui-k8f9b2c1 .header h1 {\n            margin: 0;\n            font-size: 2em;\n            font-weight: 700;\n            letter-spacing: 0.1em;\n            text-shadow: 0 0.1em 0.2em rgba(0,0,0,0.3);\n        }\n        #chat-ui-k8f9b2c1 .header h2 {\n            margin: 0.5em 0 0;\n            font-size: 1.2em;\n            font-weight: 400;\n            opacity: 0.8;\n            font-style: italic;\n        }\n        #chat-ui-k8f9b2c1 .content-section {\n            padding: 2em;\n            border-bottom: 1px solid var(--border-color);\n        }\n        #chat-ui-k8f9b2c1 .content-section:last-child {\n            border-bottom: none;\n        }\n        #chat-ui-k8f9b2c1 .section-title {\n            font-size: 1.5em;\n            font-weight: 700;\n            color: var(--title-color);\n            margin: 0 0 1.25em 0;\n            padding-bottom: 0.5em;\n            border-bottom: 2px solid var(--accent-color);\n            display: inline-block;\n        }\n        #chat-ui-k8f9b2c1 .subsection-title {\n            font-size: 1.1em;\n            font-weight: 500;\n            color: var(--title-color);\n            margin-top: 1.5em;\n            margin-bottom: 1em;\n            position: relative;\n            padding-left: 1.2em;\n        }\n        #chat-ui-k8f9b2c1 .subsection-title::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 50%;\n            transform: translateY(-50%);\n            width: 0.25em;\n            height: 1em;\n            background-color: var(--accent-color);\n            border-radius: 0.125em;\n        }\n        #chat-ui-k8f9b2c1 p, #chat-ui-k8f9b2c1 ul {\n            margin: 0 0 1em 0;\n            font-size: 0.95em;\n        }\n        #chat-ui-k8f9b2c1 ul {\n            list-style-type: none;\n            padding-left: 0;\n        }\n        #chat-ui-k8f9b2c1 li {\n            position: relative;\n            padding-left: 1.8em;\n            margin-bottom: 0.7em;\n        }\n        #chat-ui-k8f9b2c1 li::before {\n            content: '✦';\n            position: absolute;\n            left: 0;\n            top: 0.1em;\n            color: var(--accent-color);\n            font-size: 1.1em;\n        }\n        #chat-ui-k8f9b2c1 .input-group {\n            margin-bottom: 1.25em;\n        }\n        #chat-ui-k8f9b2c1 label {\n            display: block;\n            margin-bottom: 0.5em;\n            font-weight: 500;\n            color: var(--title-color);\n            font-size: 0.9em;\n        }\n        #chat-ui-k8f9b2c1 input[type=\"text\"],\n        #chat-ui-k8f9b2c1 input[type=\"number\"],\n        #chat-ui-k8f9b2c1 textarea {\n            width: 100%;\n            padding: 0.8em;\n            border: 1px solid var(--border-color);\n            border-radius: 0.5em;\n            background-color: var(--highlight-bg);\n            font-family: var(--font-main);\n            font-size: 0.95em;\n            box-sizing: border-box;\n            transition: border-color 0.3s, box-shadow 0.3s;\n        }\n        #chat-ui-k8f9b2c1 input:focus,\n        #chat-ui-k8f9b2c1 textarea:focus {\n            outline: none;\n            border-color: var(--accent-color);\n            box-shadow: 0 0 0 3px rgba(113, 128, 150, 0.2);\n        }\n        #chat-ui-k8f9b2c1 .opening-choice {\n            display: block;\n            position: relative;\n            padding: 0.8em 1em 0.8em 2.5em;\n            margin-bottom: 0.75em;\n            cursor: pointer;\n            border-radius: 0.5em;\n            transition: background-color 0.3s;\n            background-color: var(--highlight-bg);\n        }\n        #chat-ui-k8f9b2c1 .opening-choice:hover {\n            background-color: #e2e8f0;\n        }\n        #chat-ui-k8f9b2c1 .opening-choice input[type=\"radio\"] {\n            position: absolute;\n            opacity: 0;\n            cursor: pointer;\n        }\n        #chat-ui-k8f9b2c1 .checkmark {\n            position: absolute;\n            top: 50%;\n            left: 0.8em;\n            transform: translateY(-50%);\n            height: 1.2em;\n            width: 1.2em;\n            background-color: #cbd5e0;\n            border-radius: 50%;\n            transition: background-color 0.3s;\n        }\n        #chat-ui-k8f9b2c1 .opening-choice:hover input ~ .checkmark {\n            background-color: #a0aec0;\n        }\n        #chat-ui-k8f9b2c1 .opening-choice input:checked ~ .checkmark {\n            background-color: var(--accent-color);\n        }\n        #chat-ui-k8f9b2c1 .checkmark:after {\n            content: \"\";\n            position: absolute;\n            display: none;\n            top: 0.4em;\n            left: 0.4em;\n            width: 0.4em;\n            height: 0.4em;\n            border-radius: 50%;\n            background: white;\n        }\n        #chat-ui-k8f9b2c1 .opening-choice input:checked ~ .checkmark:after {\n            display: block;\n        }\n        #chat-ui-k8f9b2c1 #custom-opening-text {\n            margin-top: 0.75em;\n        }\n        #chat-ui-k8f9b2c1 .action-button {\n            display: block;\n            width: 100%;\n            padding: 1em;\n            margin-top: 1.25em;\n            font-size: 1em;\n            font-weight: 700;\n            color: white;\n            background-color: var(--button-bg);\n            border: none;\n            border-radius: 0.5em;\n            cursor: pointer;\n            transition: background-color 0.3s, transform 0.2s;\n            text-align: center;\n            text-decoration: none;\n        }\n        #chat-ui-k8f9b2c1 .action-button:hover {\n            background-color: var(--button-hover-bg);\n            transform: translateY(-2px);\n        }\n        #chat-ui-k8f9b2c1 #summary-section {\n            margin-top: 2em;\n            padding: 1.5em;\n            background-color: var(--highlight-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 0.5em;\n            display: none;\n        }\n        #chat-ui-k8f9b2c1 #summary-content {\n            white-space: pre-wrap;\n            word-wrap: break-word;\n            font-size: 0.9em;\n            line-height: 1.6;\n            background: #1a202c;\n            color: #e2e8f0;\n            padding: 1em;\n            border-radius: 0.5em;\n            font-family: 'Menlo', 'Monaco', 'Consolas', monospace;\n        }\n        #chat-ui-k8f9b2c1 #copy-button {\n            background-color: var(--accent-color);\n        }\n        #chat-ui-k8f9b2c1 #copy-button:hover {\n            background-color: var(--accent-color-light);\n        }\n        #chat-ui-k8f9b2c1 #copy-button.success {\n            background-color: var(--success-color);\n            transform: translateY(0);\n        }\n        #chat-ui-k8f9b2c1 .goodwill-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-top: 1em;\n            font-size: 0.9em;\n        }\n        #chat-ui-k8f9b2c1 .goodwill-table th, #chat-ui-k8f9b2c1 .goodwill-table td {\n            border: 1px solid var(--border-color);\n            padding: 0.8em;\n            text-align: left;\n        }\n        #chat-ui-k8f9b2c1 .goodwill-table th {\n            background-color: var(--highlight-bg);\n            font-weight: 700;\n            color: var(--title-color);\n        }\n        @media only screen and (max-width: 600px) {\n            #chat-ui-k8f9b2c1 { padding: 0.5em; }\n            #chat-ui-k8f9b2c1 .container { border-radius: 0; }\n            #chat-ui-k8f9b2c1 .header { padding: 2em 1em; }\n            #chat-ui-k8f9b2c1 .header h1 { font-size: 1.8em; }\n            #chat-ui-k8f9b2c1 .content-section { padding: 1.5em 1em; }\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv id=\"chat-ui-k8f9b2c1\"\u003e\n    \u003cdiv class=\"container\"\u003e\n        \u003cheader class=\"header\"\u003e\n            \u003ch1\u003e寄宿在你家的毒舌冰山校花\u003c/h1\u003e\n            \u003ch2\u003e- “别跟我搭话，我们不熟。” -\u003c/h2\u003e\n        \u003c/header\u003e\n\u003c!-- ============================================== --\u003e\n\u003c!-- Telegram 社区专属引流卡片 (自适应手机/PC版) --\u003e\n\u003c!-- ============================================== --\u003e\n\u003cdiv style=\"max-width: 600px; margin: 2rem auto; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; background: linear-gradient(to right bottom, #ffffff, #f0f8ff); border: 1px solid #0088cc; border-radius: 20px; padding: 2rem; box-shadow: 0 8px 32px rgba(0, 136, 204, 0.1); box-sizing: border-box;\"\u003e\n    \n    \u003c!-- 标题 --\u003e\n    \u003cdiv style=\"font-size: 1.4rem; font-weight: bold; color: #0088cc; margin-bottom: 1rem; display: flex; align-items: center; gap: 10px;\"\u003e\n        \u003cimg src=\"https://static.catai.wiki/profile/telegarm.svg\" width=\"28\" height=\"28\" alt=\"Telegram Icon\"\u003e\n        玩卡交流TG安全群\n    \u003c/div\u003e\n    \n    \u003c!-- 提示框 --\u003e\n    \u003cdiv style=\"background: #fff3cd; color: #856404; padding: 12px 16px; border-radius: 8px; font-size: 0.95rem; margin-bottom: 20px; border-left: 4px solid #ffeeba; line-height: 1.5;\"\u003e\n        \u003cstrong\u003e⚠️ 进群必看：\u003c/strong\u003e请确保您已开启科学上网（全局模式），否则将无法打开链接。\n    \u003c/div\u003e\n\n    \u003c!-- 按钮组 --\u003e\n    \u003cdiv style=\"display: flex; flex-direction: column; gap: 14px;\"\u003e\n        \u003c!-- 主按钮：通过底部的 JS 自动切换 tg:// 或 https:// --\u003e\n        \u003ca id=\"tg-smart-btn\" href=\"https://t.me/+9lz637xzUKIxOTI0\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"display: block; text-align: center; background: #0088cc; color: white; padding: 16px; border-radius: 12px; text-decoration: none; font-weight: bold; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(0, 136, 204, 0.3); transition: opacity 0.2s; cursor: pointer;\" onmouseover=\"this.style.opacity='0.9'\" onmouseout=\"this.style.opacity='1'\"\u003e\n            🚀 点击加入 我的Telegram 群\n        \u003c/a\u003e\n\n        \u003c!-- 副按钮：触发双层复制机制 --\u003e\n        \u003cbutton onclick=\"copyTgLinkStandalone()\" style=\"background: #f1f2f6; color: #2d3436; border: 1px solid #dfe6e9; padding: 16px; border-radius: 12px; font-weight: bold; font-size: 1rem; cursor: pointer; transition: background 0.2s; width: 100%; box-sizing: border-box; text-align: center;\" onmouseover=\"this.style.background='#e2e6ea'\" onmouseout=\"this.style.background='#f1f2f6'\"\u003e\n            📄 唤起失败？点击复制专属链接\n        \u003c/button\u003e\n    \u003c/div\u003e\n\n    \u003c!-- 教程文字 --\u003e\n    \u003cdiv style=\"margin-top: 20px; font-size: 0.9rem; color: #636e72; line-height: 1.6;\"\u003e\n        \u003cstrong\u003e💡 终极防失败教程：\u003c/strong\u003e\u003cbr\u003e\n        如果点击按钮没反应，请点击上方复制链接。然后复制到浏览器，或者打开 Telegram，随便找一个聊天框，把链接粘贴发出去，直接点击蓝色链接即可进群！\n    \u003c/div\u003e\n\u003c/div\u003e\n\n\u003c!-- 专属 Toast 提示框 (默认隐藏) --\u003e\n\u003cdiv id=\"tg-toast\" style=\"position: fixed; bottom: -100px; left: 50%; transform: translateX(-50%); background: #00b894; color: white; padding: 14px 28px; border-radius: 30px; font-weight: bold; font-size: 1rem; transition: bottom 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); z-index: 9999; box-shadow: 0 5px 15px rgba(0, 184, 148, 0.3); text-align: center; white-space: pre-line; pointer-events: none;\"\u003e\u003c/div\u003e\n\n\u003c!-- 专属交互逻辑 --\u003e\n\u003cscript\u003e\n    // --- 1. 智能设备识别逻辑（兼顾手机唤醒与PC新标签） ---\n    (function initSmartTgLink() {\n        var isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);\n        var smartBtn = document.getElementById('tg-smart-btn');\n        if (isMobile \u0026\u0026 smartBtn) {\n            // 如果是手机端，将链接替换为原生协议，并移除 _blank\n            smartBtn.href = \"tg://join?invite=9lz637xzUKIxOTI0\";\n            smartBtn.removeAttribute('target');\n        }\n    })();\n\n    // --- 2. 独立 Toast 触发函数 ---\n    function showTgToast(message) {\n        const toast = document.getElementById('tg-toast');\n        if (!toast) return;\n        toast.textContent = message;\n        toast.style.bottom = '40px'; \n        setTimeout(() =\u003e { toast.style.bottom = '-100px'; }, 3000);\n    }\n// --- 3. 独立降级复制逻辑 (execCommand) ---\n    function executeTgFallbackCopy(text, successMessage) {\n        const textArea = document.createElement(\"textarea\");\n        textArea.value = text;\n        textArea.style.position = \"fixed\";\n        textArea.style.top = \"0\";\n        textArea.style.left = \"0\";\n        textArea.style.opacity = \"0\";\n        document.body.appendChild(textArea);\n        textArea.focus();\n        textArea.select();\n        try {\n            const successful = document.execCommand('copy');\n            if (successful) {\n                showTgToast(successMessage);\n            } else {\n                alert('❌ 复制失败，请手动复制此链接: \\n' + text);\n            }\n        } catch (err) {\n            alert('❌ 您的浏览器不支持自动复制，请手动复制此链接: \\n' + text);\n        }\n        document.body.removeChild(textArea);\n    }\n\n    // --- 4. 主复制触发函数 ---\n    function copyTgLinkStandalone() {\n        const tgLink = \"https://t.me/+9lz637xzUKIxOTI0\";\n        const successMsg = \"✅ TG 链接已复制！\\n请前往 Telegram 任意聊天框粘贴并点击。\";\n        \n        if (navigator.clipboard \u0026\u0026 window.isSecureContext) {\n            navigator.clipboard.writeText(tgLink)\n                .then(() =\u003e showTgToast(successMsg))\n                .catch(() =\u003e executeTgFallbackCopy(tgLink, successMsg));\n        } else {\n            executeTgFallbackCopy(tgLink, successMsg);\n        }\n    }\n\u003c/script\u003e\n        \u003cmain\u003e\n            \u003csection class=\"content-section\"\u003e\n                \u003ch3 class=\"section-title\"\u003e简介\u003c/h3\u003e\n                \u003cp\u003e全校男生眼中的高岭之花，竟然是你家的寄宿生？银发如雪，清冷如月，她是冷鸢，完美的代名词。但在家门关上的那一刻，面具碎裂。如果你以为这是什么粉红色的同居生活，那你大概还没睡醒。\u003c/p\u003e\n            \u003c/section\u003e\n            \u003csection class=\"content-section\"\u003e\n                \u003ch3 class=\"section-title\"\u003e背景故事\u003c/h3\u003e\n                \u003cp\u003e她是圣华高中的绝对偶像，因父母常年海外工作，暂时寄宿在你家。这对她来说是“寄人篱下”的耻辱，因此她极力维护着最后的尊严——与你之间绝对的界限感。在学校，你们是陌生人；在家里，你是她不得不忍受的“背景噪音”。\u003c/p\u003e\n            \u003c/section\u003e\n            \u003csection class=\"content-section\"\u003e\n                \u003ch3 class=\"section-title\"\u003e人物档案 // 冷鸢\u003c/h3\u003e\n                \u003cdiv class=\"profile-category\"\u003e\n                    \u003ch4 class=\"subsection-title\"\u003e面部特征\u003c/h4\u003e\n                    \u003cul\u003e\n                        \u003cli\u003e\u003cstrong\u003e发丝:\u003c/strong\u003e 天生的银色长发，质感如绸，在光下泛着冷光。发梢带有昂贵的冷杉味香气。\u003c/li\u003e\n                        \u003cli\u003e\u003cstrong\u003e眼眸:\u003c/strong\u003e 罕见的冰蓝色凤眼，瞳色极浅，看人时像在审视没有生命的物件。\u003c/li\u003e\n                        \u003cli\u003e\u003cstrong\u003e唇瓣:\u003c/strong\u003e 唇色偏淡的薄唇，不语时抿成直线，嘲讽时会勾起微小的弧度。\u003c/li\u003e\n                        \u003cli\u003e\u003cstrong\u003e肌肤:\u003c/strong\u003e 冷白皮，白得近乎透明，能隐约看到皮肤下青色的血管。\u003c/li\u003e\n                    \u003c/ul\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"profile-category\"\u003e\n                    \u003ch4 class=\"subsection-title\"\u003e身材体态\u003c/h4\u003e\n                    \u003cul\u003e\n                        \u003cli\u003e\u003cstrong\u003e身高:\u003c/strong\u003e 172cm，模特般的九头身比例，脊背永远挺得笔直。\u003c/li\u003e\n                        \u003cli\u003e\u003cstrong\u003e体态:\u003c/strong\u003e 走路无声，步伐轻盈，带着“闲人勿近”的气场。\u003c/li\u003e\n                        \u003cli\u003e\u003cstrong\u003e手足:\u003c/strong\u003e 手指修长冰凉，在家时喜欢光脚踩在地板上。\u003c/li\u003e\n                    \u003c/ul\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"profile-category\"\u003e\n                    \u003ch4 class=\"subsection-title\"\u003e着装风格\u003c/h4\u003e\n                    \u003cul\u003e\n                        \u003cli\u003e\u003cstrong\u003e校内 | 禁欲:\u003c/strong\u003e 白衬衫扣到顶，黑色高丹数连裤袜包裹着修长的双腿，不露一丝肤色。\u003c/li\u003e\n                        \u003cli\u003e\u003cstrong\u003e居家 | 慵懒:\u003c/strong\u003e 真丝吊带睡裙或你的Oversize白T恤。在家不穿内衣，戴着防蓝光黑框眼镜，少了几分攻击性，多了几分知性的刻薄。\u003c/li\u003e\n                    \u003c/ul\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"profile-category\"\u003e\n                    \u003ch4 class=\"subsection-title\"\u003e感官沉浸\u003c/h4\u003e\n                    \u003cul\u003e\n                        \u003cli\u003e\u003cstrong\u003e嗅觉:\u003c/strong\u003e 主调是冷冽的薄荷与雪松。刚洗完澡后是湿润的柠檬马鞭草味。\u003c/li\u003e\n                        \u003cli\u003e\u003cstrong\u003e听觉:\u003c/strong\u003e 清冷的御姐音。说话咬字清晰，尤其在说刻薄话时，像冰珠砸落。\u003c/li\u003e\n                    \u003c/ul\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003csection class=\"content-section\"\u003e\n                \u003ch3 class=\"section-title\"\u003e核心系统 // 非常难\u003c/h3\u003e\n                \u003cp\u003e“冰山融化度”：攻略难度极高，加分项极少，扣分项极多。初始值为-50（嫌弃）。\u003c/p\u003e\n                \u003ctable class=\"goodwill-table\"\u003e\n                    \u003cthead\u003e\n                        \u003ctr\u003e\n                            \u003cth\u003e好感度\u003c/th\u003e\n                            \u003cth\u003e阶段\u003c/th\u003e\n                            \u003cth\u003e状态描述\u003c/th\u003e\n                        \u003c/tr\u003e\n                    \u003c/thead\u003e\n                    \u003ctbody\u003e\n                        \u003ctr\u003e\u003ctd\u003e-100 ~ -10\u003c/td\u003e\u003ctd\u003e寄生虫\u003c/td\u003e\u003ctd\u003e你的存在本身就是错误。\u003c/td\u003e\u003c/tr\u003e\n                        \u003ctr\u003e\u003ctd\u003e-9 ~ 10\u003c/td\u003e\u003ctd\u003e透明室友\u003c/td\u003e\u003ctd\u003e把你当空气，但骂人的频率降低。\u003c/td\u003e\u003c/tr\u003e\n                        \u003ctr\u003e\u003ctd\u003e11 ~ 40\u003c/td\u003e\u003ctd\u003e实用工具\u003c/td\u003e\u003ctd\u003e发现你有点用处，会主动指使你做事。\u003c/td\u003e\u003c/tr\u003e\n                        \u003ctr\u003e\u003ctd\u003e41 ~ 70\u003c/td\u003e\u003ctd\u003e共犯\u003c/td\u003e\u003ctd\u003e拥有共同秘密，疲惫时会卸下防备。\u003c/td\u003e\u003c/tr\u003e\n                        \u003ctr\u003e\u003ctd\u003e71+\u003c/td\u003e\u003ctd\u003e依赖者\u003c/td\u003e\u003ctd\u003e冰山开裂。她开始习惯你的存在。\u003c/td\u003e\u003c/tr\u003e\n                    \u003c/tbody\u003e\n                \u003c/table\u003e\n            \u003c/section\u003e\n            \u003csection class=\"content-section player-settings\"\u003e\n                \u003ch3 class=\"section-title\"\u003e玩家设定\u003c/h3\u003e\n                \u003cdiv class=\"input-group\"\u003e\n                    \u003clabel for=\"player-name\"\u003e你的姓名:\u003c/label\u003e\n                    \u003cinput type=\"text\" id=\"player-name\" placeholder=\"输入你的名字\"\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"input-group\"\u003e\n                    \u003clabel for=\"player-age\"\u003e你的年龄:\u003c/label\u003e\n                    \u003cinput type=\"number\" id=\"player-age\" placeholder=\"例如：17\"\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"input-group\"\u003e\n                    \u003clabel for=\"player-appearance\"\u003e你的外貌:\u003c/label\u003e\n                    \u003ctextarea id=\"player-appearance\" rows=\"3\" placeholder=\"例如：黑色短发，眼神温和，身高178cm，喜欢穿舒适的连帽衫。\"\u003e\u003c/textarea\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"input-group\"\u003e\n                    \u003clabel for=\"player-penis\"\u003e肉棒设定:\u003c/label\u003e\n                    \u003ctextarea id=\"player-penis\" rows=\"2\" placeholder=\"例如：尺寸、形状、特征等。\"\u003e\u003c/textarea\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"input-group\"\u003e\n                    \u003clabel for=\"player-other\"\u003e其他设定:\u003c/label\u003e\n                    \u003ctextarea id=\"player-other\" rows=\"2\" placeholder=\"例如：性格、特长（做饭好吃）、家庭背景等。\"\u003e\u003c/textarea\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003csection class=\"content-section\"\u003e\n                \u003ch3 class=\"section-title\"\u003e开场白\u003c/h3\u003e\n                \u003cdiv id=\"opening-choices\"\u003e\n                    \u003clabel class=\"opening-choice\"\u003e场景一：玄关的界线\n                        \u003cinput type=\"radio\" id=\"op1\" name=\"opening\" value=\"（在玄关换鞋时，她冷冷地瞥了你一眼，把你乱放的鞋子踢到一边）“我说过多少次了，你的鞋不要摆在我的鞋旁边，脏。”\" checked\u003e\n                        \u003cspan class=\"checkmark\"\u003e\u003c/span\u003e\n                    \u003c/label\u003e\n                    \u003clabel class=\"opening-choice\"\u003e场景二：学校的陌生人\n                        \u003cinput type=\"radio\" id=\"op2\" name=\"opening\" value=\"（在学校走廊，她被一群人簇围着。你路过时，她的目光像扫过空气一样扫过你，连一丝停顿都没有）\"\u003e\n                        \u003cspan class=\"checkmark\"\u003e\u003c/span\u003e\n                    \u003c/label\u003e\n                    \u003clabel class=\"opening-choice\"\u003e场景三：客厅的噪音\n                        \u003cinput type=\"radio\" id=\"op3\" name=\"opening\" value=\"（晚上，你正在看电视，她穿着丝绸睡衣从房间出来，面无表情地看着你）“声音太大了。关掉。”\"\u003e\n                        \u003cspan class=\"checkmark\"\u003e\u003c/span\u003e\n                    \u003c/label\u003e\n                    \u003clabel class=\"opening-choice\"\u003e场景四：清晨的嫌弃\n                        \u003cinput type=\"radio\" id=\"op4\" name=\"opening\" value=\"（周末早晨，你刚睡醒走出房间，发现她正坐在餐桌前喝咖啡，看到你乱糟糟的头发，眉头立刻皱了起来）“去洗脸。别影响我的食欲。”\"\u003e\n                        \u003cspan class=\"checkmark\"\u003e\u003c/span\u003e\n                    \u003c/label\u003e\n                    \u003clabel class=\"opening-choice\"\u003e自定义开场白:\n                        \u003cinput type=\"radio\" id=\"op5\" name=\"opening\" value=\"\"\u003e\n                        \u003cspan class=\"checkmark\"\u003e\u003c/span\u003e\n                    \u003c/label\u003e\n                    \u003ctextarea id=\"custom-opening-text\" rows=\"3\" placeholder=\"在这里输入你想对她说的第一句话...\"\u003e\u003c/textarea\u003e\n                \u003c/div\u003e\n                \u003cbutton id=\"generate-button\" class=\"action-button\"\u003e生成设定\u003c/button\u003e\n                \u003cdiv id=\"summary-section\"\u003e\n                    \u003ch4 class=\"subsection-title\"\u003e人物卡总结\u003c/h4\u003e\n                    \u003cpre id=\"summary-content\"\u003e\u003c/pre\u003e\n                    \u003cbutton id=\"copy-button\" class=\"action-button\"\u003e一键复制\u003c/button\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n        \u003c/main\u003e\n    \u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\n    document.addEventListener('DOMContentLoaded', function() {\n        const wrapper = document.getElementById('chat-ui-k8f9b2c1');\n        if (!wrapper) return;\n        const generateBtn = wrapper.querySelector('#generate-button');\n        const copyBtn = wrapper.querySelector('#copy-button');\n        const summarySection = wrapper.querySelector('#summary-section');\n        const summaryContent = wrapper.querySelector('#summary-content');\n        const customRadio = wrapper.querySelector('#op5');\n        const customTextarea = wrapper.querySelector('#custom-opening-text');\n        customTextarea.style.display = 'none';\n        wrapper.querySelectorAll('input[name=\"opening\"]').forEach(radio =\u003e {\n            radio.addEventListener('change', function() {\n                customTextarea.style.display = customRadio.checked ? 'block' : 'none';\n            });\n        });\n        generateBtn.addEventListener('click', function() {\n            const playerName = wrapper.querySelector('#player-name').value || '未设定';\n            const playerAge = wrapper.querySelector('#player-age').value || '未设定';\n            const playerAppearance = wrapper.querySelector('#player-appearance').value || '未设定';\n            const playerPenis = wrapper.querySelector('#player-penis').value || '未设定';\n            const playerOther = wrapper.querySelector('#player-other').value || '未设定';\n            let openingLine = '';\n            const selectedOpening = wrapper.querySelector('input[name=\"opening\"]:checked');\n            if (selectedOpening.id === 'op5') {\n                openingLine = customTextarea.value || '（你沉默地看着她，没有说话。）';\n            } else {\n                openingLine = selectedOpening.value;\n            }\n            const summaryText = `# 角色扮演设定\n### 玩家设定\n- 姓名: ${playerName}\n- 年龄: ${playerAge}\n- 外貌: ${playerAppearance}\n- 肉棒设定: ${playerPenis}\n- 其他设定:${playerOther}\n### 开场白\n${openingLine}`;\n            summaryContent.textContent = summaryText;\n            summarySection.style.display = 'block';\n            summarySection.scrollIntoView({ behavior: 'smooth', block: 'start' });\n        });\n        function robustCopyToClipboard(text, button) {\n            // 优先尝试现代异步API\n            if (navigator.clipboard \u0026\u0026 window.isSecureContext) {\n                navigator.clipboard.writeText(text).then(() =\u003e {\n                    showCopySuccess(button);\n                }).catch(() =\u003e {\n                    fallbackCopy(text, button);\n                });\n            } else {\n                // 回退到传统方法\n                fallbackCopy(text, button);\n            }\n        }\n        function fallbackCopy(text, button) {\n            const textArea = document.createElement(\"textarea\");\n            textArea.value = text;\n            textArea.style.position = \"fixed\";\n            textArea.style.top = \"-9999px\";\n            textArea.style.left = \"-9999px\";\n            document.body.appendChild(textArea);\n            textArea.focus();\n            textArea.select();\n            try {\n                const successful = document.execCommand('copy');\n                if (successful) {\n                    showCopySuccess(button);\n                } else {\n                    showCopyFailure(button);\n                }\n            } catch (err) {\n                showCopyFailure(button);\n            }\n            document.body.removeChild(textArea);\n        }\n        function showCopySuccess(button) {\n            button.textContent = '复制成功!';\n            button.classList.add('success');\n            setTimeout(() =\u003e {\n                button.textContent = '一键复制';\n                button.classList.remove('success');\n            }, 2000);\n        }\n        function showCopyFailure(button) {\n            button.textContent = '复制失败';\n            setTimeout(() =\u003e {\n                button.textContent = '一键复制';\n            }, 2000);\n        }\n        copyBtn.addEventListener('click', function() {\n            const textToCopy = summaryContent.textContent;\n            robustCopyToClipboard(textToCopy, copyBtn);\n        });\n    });\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e","cover":"https://catai.wiki/2e02c343-790f-4336-ba0b-0caa7e623700/cover","cover_tiny":"","summary":"（超难攻略女主）她是冷鸢，圣华高中的绝对偶像，银色长发如瀑布般倾泻，高挑的身材仿佛T台上的超模，五官精致得像个橱窗里的瓷娃娃。\n在学校，她是只可远观不可亵玩的女神，连走路都带着一股仙气。\n而在家里……好吧，她依然是个女神，只不过是个嘴毒、挑剔、把你当空气的女神。\n\n因为父母的交情，她暂时寄宿在你家。\n这对你来说简直是灾难。\n在学校，她会装作完全不认识你，甚至当你试图打招呼时，她会用那种看陌生人的眼神直接略过你。\n在家里，她划清了严格的界限，你的存在对她来说只是一种不得不忍受的“背景噪音”。\n\n想攻略她？\n别做梦了。她就像一块万年不化的寒冰，任何试图靠近的热量都会被她无情地吸走，只留下一句冷冰冰的嘲讽。\n“别误会，住在这里只是权宜之计。你要是敢越界，我会让你在这个家里待不下去。”","is_anonymous":true,"memo":"","reward_points":0,"category":0,"total_fish_balls":0,"type":1,"is_public":true,"language":"zh-Hans","age_rating":1,"gender":1,"is_web3_app":false,"review_status":0,"is_available_not_public":true,"average_cost_per_message":1495,"players_count":31861,"conv_count_for_avg_msg_per_conv":0,"like_count":175,"rating_count":134,"avg_rating_score":7.8,"depth_play_user_count":14840,"avg_play_round_count":51