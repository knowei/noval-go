rtant;\n}\n\n/* 终极移除聚焦轮廓 */\n*:focus, *:active, *:focus-visible {\n    outline: 0 !important;\n    outline-color: transparent !important;\n    outline-style: none !important;\n    box-shadow: none !important; \n}\n\n/* --- 容器美化：清冷冰晶感 --- */\n.bg-gray-100\\/90.relative.inline-block {\n    /* 背景：极淡的冰川渐变，从纯白过渡到微蓝 */\n    background: #F0F8FF !important; \n    background: linear-gradient(180deg, #FFFFFF 0%, #F0F8FF 60%, #E6F2FF 100%) !important;\n    \n    /* 边框：细致的银蓝色，比粉色版更细，显精致 */\n    border: 1px solid #B0C4DE !important; \n    \n    /* 圆角：稍微减小圆角半径，显得更克制、高冷 */\n    border-radius: 12px !important;\n    \n    padding: 18px !important;\n    margin: 10px auto !important;\n    max-width: 100% !important;\n    \n    /* 阴影：极冷的蓝灰色微光，替代暖色阴影 */\n    box-shadow: 0 4px 12px rgba(176, 196, 222, 0.3) !important;\n}\n\n/* --- 文本内容区域：雪原白 --- */\n.markdown-body {\n    background-color: rgba(255, 255, 255, 0.95) !important; /* 增加一点点通透感 */\n    color: #2F4F4F !important; /* 深岩灰色，比纯黑更有质感 */\n    \n    border-radius: 8px !important; /* 锐利一点的圆角 */\n    padding: 15px !important;\n    line-height: 1.7 !important; /* 行高稍微加大，体现从容 */\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n    \n    box-shadow: none !important;\n    border: 1px solid #E1EDF9 !important; /* 极淡的冰纹边框 */\n}\n\n/* 标题：冷艳蓝 */\n.markdown-body h1, .markdown-body h2, .markdown-body h3 {\n    color: #4682B4 !important; /* 钢蓝色 */\n    margin-top: 1.2em !important;\n    margin-bottom: 0.6em !important;\n    letter-spacing: 0.5px !important; /* 字间距微增，显疏离 */\n    text-shadow: none !important;\n    border-bottom: 1px solid #E6F2FF !important; /* 标题下加一条细线 */\n    padding-bottom: 5px !important;\n}\n\n/* --- 代码块：极地实验室风格 --- */\n.markdown-body pre, .markdown-body code {\n    background-color: #F5F9FC !important; /* 极淡蓝灰背景 */\n    color: #1E3A8A !important; /* 深邃蓝文字 */\n    \n    /* 边框：实线，防止手机黑边 */\n    border: 1px solid #D1E3F6 !important; \n    border-radius: 6px !important;\n    \n    /* 核心修复保持 */\n    box-shadow: none !important;\n    outline: none !important;\n    text-shadow: none !important;\n    background-clip: padding-box !important;\n    \n    font-family: \"Menlo\", \"Monaco\", monospace !important;\n    font-size: 0.85em !important; /* 字体稍微调小，显精致 */\n    padding: 10px !important;\n    margin: 10px 0 !important;\n    white-space: pre-wrap !important;\n    word-break: break-all !important;\n}\n\n/* --- 交互面板 (details)：冰封档案 --- */\ndetails {\n    background-color: #FFFFFF !important;\n    /* 边框：冷银色 */\n    border: 1px solid #CEDBEB !important;\n    border-radius: 8px !important;\n    margin-bottom: 12px !important;\n    padding: 10px !important;\n    \n    box-shadow: none !important;\n    -webkit-tap-highlight-color: transparent !important;\n}\n\n/* 摘要 (summary) */\nsummary {\n    color: #5F9EA0 !important; /* 军校蓝/灰绿蓝，低调冷感 */\n    font-weight: 600 !important;\n    cursor: pointer !important;\n    padding: 5px !important;\n    \n    outline: 0 !important;\n    outline: none !important;\n    border: none !important;\n    box-shadow: none !important;\n    background: transparent !important;\n    list-style: none !important;\n}\n\nsummary::-webkit-details-marker {\n    display: none !important;\n}\n\n/* 图标：替换为雪花/冰晶 */\nsummary::before {\n    content: '❄️ ' !important; /* 未展开状态 */\n    margin-right: 6px !important;\n    opacity: 0.7 !important;\n}\n\ndetails[open] summary::before {\n    content: '🧊 ' !important; /* 展开状态 */\n    opacity: 1 !important;\n}\n\n/* --- 输入框：如履薄冰 --- */\ntextarea, input[type=\"text\"] {\n    background: #FAFDFF !important;\n    border: 1px solid #D6E4F0 !important;\n    border-radius: 6px !important;\n    padding: 8px !important;\n    color: #2C3E50 !important;\n    -webkit-appearance: none !important;\n    box-shadow: none !important;\n}\n\ntextarea:focus, input[type=\"text\"]:focus {\n    border-color: #87CEEB !important; /* 聚焦时变为天蓝色 */\n    background-color: #FFFFFF !important;\n    outline: none !important;\n}\n\n/* --- 按钮：寒冰护盾 --- */\n.MuiButtonBase-root.MuiButton-root {\n    background: linear-gradient(135deg, #F0F8FF 0%, #E6F2FF 100%) !important;\n    color: #4682B4 !important;\n    border-radius: 8px !important;\n    box-shadow: none !important;\n    border: 1px solid #B0C4DE !important;\n    font-weight: 500 !important;\n    letter-spacing: 1px !important;\n}\n\n/* 隐藏多余元素 */\n[class*=\"bg-[#F1CBCB]\"], [class*=\"bg-[#c9e1e9]\"] {\n    display: none !important;\n}\n\n/* 链接：冰链 */\n.markdown-body a {\n    color: #1E90FF !important; /* 闪亮的道奇蓝 */\n    text-decoration: none !important;\n    border-bottom: 1px dashed #1E90FF !important; /* 虚线下划线 */\n}","shortcut_commands":[],"preset_type":1,"preset_chats":[],"is_have_cg_image":false,"bgm":{"autoplay":true},"dmm_points":0,"default_sent_message_count":6,"regex_replaces":[],"ai_variable_prompt":"","ai_variable_json":"","ai_variable_template":"","extend":{}},"tags":[{"id":"150685c9-598e-4995-854d-5429f027159c","name":"单人卡"},{"id":"ddd8a601-6db6-4c4c-a2fe-ba06530b2127","name":"已破甲"},{"id":"4a857ea4-fba0-458f-a8d2-976f089efed5","name":"可剧情可涩涩"},{"id":"1a6822bd-dc63-4349-8c8c-88df524e87be","name":"高自由度"},{"id":"38c0fddc-2383-4c33-aedb-fad3b0a0c0fb","name":"纯爱"},{"id":"a5bc9b34-db00-43a5-a6ff-50e8b612a4f4","name":"低消耗"}],"author":{"id":"00000000-0000-0000-0000-000000000000","name":"","avatar":"","is_follow":false,"is_owner":false,"medals_info":{},"show_tipping_switch":false},"a_cache":true,"u_cache":false,"is_favorite":false,"is_like":false,"is_available":true}}