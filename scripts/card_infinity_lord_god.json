; background-color: #0d1b2a; color: #e0e7ff; padding: 1.5em; border-radius: 0.8em; box-shadow: 0 0 1.5em #00d4ff; border: 0.1em solid #ffffff;}\n#chat-ui-x7k9p2m4 .light-sphere-area {position: relative; height: 10em; background: linear-gradient(135deg, #0d1b2a, #1e3a5f); border-bottom: 0.1em solid #00d4ff; margin-bottom: 1.5em; box-shadow: 0 0 1em #00d4ff inset; border-radius: 0.5em 0.5em 0 0;}\n#chat-ui-x7k9p2m4 .light-sphere {width: 5em; height: 5em; background: radial-gradient(circle, #ffffff 10%, #00d4ff 50%, transparent 70%); border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 2em #00d4ff; transition: transform 0.3s ease;}\n#chat-ui-x7k9p2m4 .light-sphere:hover {transform: translate(-50%, -50%) scale(1.2) rotate(15deg);}\n#chat-ui-x7k9p2m4 .main-god {position: absolute; top: 0.5em; left: 0.5em; color: #00d4ff; font-size: 1.5em; font-weight: bold; text-shadow: 0 0 0.5em #00d4ff; letter-spacing: 0.1em;}\n#chat-ui-x7k9p2m4 .title-box {border: 0.15em solid #00d4ff; border-radius: 0.4em; padding: 0.8em; margin-bottom: 1.5em; background: #1e3a5f; box-shadow: 0 0 0.8em #00d4ff inset;}\n#chat-ui-x7k9p2m4 .title-box h1 {color: #00d4ff; text-align: center; margin: 0; text-shadow: 0 0 0.8em #00d4ff; font-size: 1.8em;}\n#chat-ui-x7k9p2m4 .title-box p {color: #b0c4ff; text-align: center; margin: 0.3em 0 0; font-size: 1em;}\n#chat-ui-x7k9p2m4 article {display: grid; grid-template-columns: 1fr; gap: 1.5em;} /* Adjusted for single box */\n#chat-ui-x7k9p2m4 .status-box {background-color: #1e3a5f; padding: 1em; border-radius: 0.4em; border: 0.1em solid #00d4ff; box-shadow: 0 0 0.5em #00d4ff;}\n#chat-ui-x7k9p2m4 .status-box h3 {color: #00d4ff; margin-top: 0; text-shadow: 0 0 0.5em #00d4ff;}\n#chat-ui-x7k9p2m4 .status-box p {margin: 0.5em 0; font-size: 0.9em;}\n#chat-ui-x7k9p2m4 .status-box span {color: #b0c4ff;}\n#chat-ui-x7k9p2m4 section details {margin-bottom: 0.8em;}\n#chat-ui-x7k9p2m4 section summary {background-color