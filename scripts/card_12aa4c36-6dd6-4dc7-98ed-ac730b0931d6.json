{"code":100000,"msg":"ok","data":{"apps":{"id":"12aa4c36-6dd6-4dc7-98ed-ac730b0931d6","app_model_config_id":"965c8f1e-6ecd-4a95-9ffa-ee620d92a0ab","created_by_account_id":"fd7f551b-116e-4095-87c0-e629bbd4665c","name":"暴露癖同桌的深夜展示","mode":"chat","icon":"","icon_background":"","status":"","is_demo":false,"is_universal":false,"description":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"zh-CN\"\u003e\n\u003chead\u003e\n    \u003cmeta charset=\"UTF-8\"\u003e\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover\"\u003e\n    \u003ctitle\u003e深夜教室 · 班长夏晚妤\u003c/title\u003e\n    \u003cstyle\u003e\n        :root {\n            --bg-deep: #080c14;\n            --bg-card: rgba(14, 16, 28, 0.38);\n            --border: rgba(120, 140, 180, 0.16);\n            --text: #c8ccd8;\n            --text-dim: #788098;\n            --accent: #8090b8;\n            --accent-light: #a0b0d0;\n            --warm: #c8a870;\n            --moon: #d0d8e8;\n        }\n        * { box-sizing: border-box; margin: 0; padding: 0; }\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Noto Sans SC\", sans-serif;\n            background: radial-gradient(ellipse at center, #0e1220 0%, #060810 60%, #020408 100%);\n            color: var(--text);\n            min-height: 100vh;\n            overflow-x: hidden;\n            overflow-y: auto;\n            -webkit-overflow-scrolling: touch;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            padding: 20px 16px 40px;\n            position: relative;\n        }\n        .bg-moonlight {\n            position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n            pointer-events: none; z-index: 0; opacity: 0.15;\n            background: radial-gradient(ellipse at 30% 20%, rgba(180, 200, 230, 0.4) 0%, transparent 60%),\n                        radial-gradient(ellipse at 70% 80%, rgba(200, 180, 140, 0.25) 0%, transparent 50%);\n        }\n        .dust-mote {\n            position: absolute; border-radius: 50%;\n            background: radial-gradient(circle, rgba(200, 210, 230, 0.5) 0%, transparent 70%);\n            animation: moteFloat 7s infinite ease-in; opacity: 0;\n        }\n        @keyframes moteFloat {\n            0% { transform: translateY(0) scale(0.2); opacity: 0; }\n            25% { opacity: 0.8; }\n            75% { opacity: 0.2; }\n            100% { transform: translateY(-105vh) scale(1.6); opacity: 0; }\n        }\n        .main-wrapper {\n            position: relative; z-index: 1; width: 100%; max-width: 500px;\n            display: flex; flex-direction: column; gap: 18px;\n        }\n        .glass-card {\n            background: var(--bg-card); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);\n            border: 1px solid var(--border); border-radius: 20px;\n            padding: 24px 20px; box-shadow: 0 6px 28px 0 rgba(0, 0, 0, 0.5); width: 100%;\n        }\n        h1 {\n            font-size: 25px; text-align: center;\n            background: linear-gradient(to right, #c8c8d8, #8898b8, #c8c8d8);\n            -webkit-background-clip: text; -webkit-text-fill-color: transparent;\n            background-clip: text; font-weight: 900; letter-spacing: 1.5px; margin-bottom: 6px;\n        }\n        .subtitle {\n            text-align: center; font-size: 13px; color: var(--accent);\n            margin-bottom: 14px; font-style: italic; letter-spacing: 1px;\n            border-bottom: 1px dashed rgba(120, 140, 180, 0.2); padding-bottom: 12px;\n        }\n        .story-text { font-size: 14px; line-height: 1.85; color: var(--text); text-indent: 2em; margin-bottom: 10px; }\n        .emphasis { color: var(--accent-light); font-weight: 600; }\n        .setting-field { margin-bottom: 15px; }\n        .setting-field label {\n            display: block; font-size: 13px; color: #a0a8b8; margin-bottom: 5px; font-weight: 500; letter-spacing: 0.4px;\n        }\n        .setting-field input[type=\"text\"], .setting-field textarea {\n            width: 100%; background: rgba(6, 8, 16, 0.6); border: 1px solid var(--border);\n            border-radius: 10px; padding: 10px 14px; color: var(--text);\n            font-size: 14px; outline: none; transition: border-color 0.2s;\n            font-family: inherit; resize: vertical;\n        }\n        .setting-field input:focus, .setting-field textarea:focus { border-color: rgba(140, 160, 200, 0.5); }\n        .setting-field input::placeholder, .setting-field textarea::placeholder { color: #4a5068; }\n        .small-hint { font-size: 11px; color: var(--text-dim); margin-top: 4px; }\n        \n        /* 选项组与切换开关 */\n        .option-grid { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 6px; }\n        .option-item {\n            flex: 1; min-width: 65px; padding: 10px 8px; border-radius: 10px;\n            border: 1.5px solid var(--border); background: rgba(255, 255, 255, 0.65);\n            color: var(--text); text-align: center; cursor: pointer; transition: all 0.2s;\n            font-size: 12px; font-weight: 600; letter-spacing: 0.3px; line-height: 1.3;\n            user-select: none; -webkit-user-select: none;\n        }\n        .option-item.active {\n            border-color: var(--accent-light); background: rgba(200, 130, 230, 0.25);\n            box-shadow: 0 0 12px rgba(180, 100, 220, 0.2); color: #6a2a8a;\n        }\n        .option-item:active { transform: scale(0.95); }\n\n        /* 滑块 */\n        .slider-container { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 6px; }\n        input[type=\"range\"] {\n            flex: 1; -webkit-appearance: none; height: 8px; border-radius: 4px;\n            background: rgba(120, 140, 180, 0.2); outline: none;\n        }\n        input[type=\"range\"]::-webkit-slider-thumb {\n            -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%;\n            background: var(--accent); cursor: pointer; box-shadow: 0 0 10px rgba(160, 80, 200, 0.6); border: 2px solid #fff;\n        }\n        .slider-value { font-size: 15px; font-weight: 700; color: var(--warm); min-width: 55px; text-align: center; }\n        .slider-comment { font-size: 12px; color: #8a5a9a; font-style: italic; min-width: 160px; }\n\n        /* 分支选择 */\n        .branch-selector { display: flex; gap: 10px; flex-wrap: wrap; }\n        .branch-option {\n            flex: 1; min-width: 80px; padding: 12px 8px; border-radius: 12px;\n            border: 1.5px solid var(--border); background: rgba(10, 12, 22, 0.5);\n            color: var(--text); text-align: center; cursor: pointer; transition: all 0.2s;\n            font-size: 13px; font-weight: 500; letter-spacing: 0.5px; user-select: none;\n        }\n        .branch-option.active { border-color: rgba(160, 180, 210, 0.6); background: rgba(30, 40, 70, 0.5); box-shadow: 0 0 16px rgba(120, 150, 200, 0.2); color: #d0d8e8; }\n        .branch-option:active { transform: scale(0.96); }\n        .branch-desc { font-size: 11px; color: var(--text-dim); margin-top: 4px; display: block; }\n        .branch-option.active .branch-desc { color: #a0b0c8; }\n\n        /* 复制按钮 */\n        .copy-btn {\n            width: 100%; padding: 12px; border: none; border-radius: 50px;\n            background: linear-gradient(135deg, #2a3048 0%, #3a4560 50%, #2a3048 100%);\n            color: #d0d8e0; font-size: 15px; font-weight: bold; cursor: pointer;\n            display: flex; align-items: center; justify-content: center; gap: 8px;\n            transition: transform 0.1s, box-shadow 0.2s; box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);\n            letter-spacing: 1px; margin-top: 8px; border: 1px solid rgba(120, 140, 180, 0.25);\n        }\n        .copy-btn:active { transform: scale(0.97); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5); }\n        .copy-btn.copied { background: linear-gradient(135deg, #2a3a2a 0%, #3a5a3a 100%); border-color: rgba(100, 140, 100, 0.4); }\n\n        /* 折叠面板 */\n        details.rules-accordion {\n            background: rgba(10, 12, 22, 0.5); border: 1px solid var(--border);\n            border-radius: 14px; padding: 0; transition: all 0.25s; width: 100%;\n        }\n        details.rules-accordion[open] { background: rgba(14, 16, 26, 0.6); border-color: rgba(120, 140, 180, 0.35); }\n        details.rules-accordion summary {\n            padding: 14px 18px; font-size: 14px; font-weight: 600;\n            color: #a0a8b8; cursor: pointer; list-style: none;\n            display: flex; align-items: center; gap: 8px; letter-spacing: 0.5px; user-select: none;\n        }\n        details.rules-accordion summary::-webkit-details-marker { display: none; }\n        details.rules-accordion summary::before {\n            content: '▸'; display: inline-block; transition: transform 0.3s;\n            font-size: 11px; color: var(--accent); flex-shrink: 0;\n        }\n        details.rules-accordion[open] summary::before { transform: rotate(90deg); }\n        .rules-content { padding: 4px 18px 16px 28px; font-size: 13px; line-height: 1.75; color: #a8b0c0; }\n        .rules-content ul { list-style: none; padding: 0; }\n        .rules-content ul li { margin-bottom: 7px; padding-left: 16px; position: relative; }\n        .rules-content ul li::before { content: '—'; position: absolute; left: 0; color: var(--accent); font-size: 10px; }\n        .rules-subtitle { font-weight: 700; color: #b0b8c8; margin-top: 10px; margin-bottom: 5px; font-size: 13px; }\n\n        /* 弹窗 */\n        .copy-overlay {\n            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n            background: rgba(0, 0, 0, 0.7); z-index: 999; justify-content: center; align-items: center; backdrop-filter: blur(4px);\n        }\n        .copy-overlay.show { display: flex; }\n        .copy-dialog {\n            background: #0e1220; border: 1px solid var(--border); border-radius: 20px;\n            padding: 22px 16px; width: 92%; max-width: 520px; max-height: 85vh;\n            display: flex; flex-direction: column; gap: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.6);\n        }\n        .copy-dialog h3 { color: var(--accent); text-align: center; font-size: 17px; }\n        .copy-dialog .instruction { font-size: 11.5px; color: var(--text-dim); text-align: center; line-height: 1.6; }\n        .copy-dialog textarea {\n            width: 100%; height: 250px; background: rgba(6, 8, 16, 0.8); border: 1px solid var(--border);\n            border-radius: 10px; color: var(--text); font-size: 12px; padding: 12px; resize: vertical;\n            font-family: inherit; line-height: 1.6; user-select: text; -webkit-user-select: text;\n        }\n        .btn-row-dialog { display: flex; gap: 8px; flex-wrap: wrap; }\n        .btn-dialog {\n            flex: 1; min-width: 70px; padding: 11px 6px; border: none; border-radius: 50px;\n            font-size: 13px; font-weight: bold; cursor: pointer; text-align: center;\n            transition: all 0.2s; border: 1px solid rgba(120, 140, 180, 0.25);\n        }\n        .btn-copy-auto { background: #3a4560; color: #fff; }\n        .btn-copy-download { background: rgba(120, 140, 180, 0.2); color: #c8ccd8; }\n        .btn-close-dialog { background: rgba(80, 90, 110, 0.2); color: #a0a8b8; }\n        .btn-dialog:active { transform: scale(0.96); }\n\n        @media (max-width: 480px) {\n            .main-wrapper { max-width: 100%; gap: 14px; }\n            .glass-card { padding: 18px 14px; }\n            .story-text { font-size: 13px; line-height: 1.7; }\n            .branch-selector { gap: 6px; }\n            .branch-option { font-size: 12px; padding: 10px 6px; }\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n    \u003cdiv class=\"bg-moonlight\"\u003e\n        \u003cdiv class=\"dust-mote\"\u003e\u003c/div\u003e\u003cdiv class=\"dust-mote\"\u003e\u003c/div\u003e\u003cdiv class=\"dust-mote\"\u003e\u003c/div\u003e\n        \u003cdiv class=\"dust-mote\"\u003e\u003c/div\u003e\u003cdiv class=\"dust-mote\"\u003e\u003c/div\u003e\u003cdiv class=\"dust-mote\"\u003e\u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"main-wrapper\"\u003e\n        \u003cdiv class=\"glass-card\" style=\"text-align: center;\"\u003e\n            \u003ch1\u003e深夜教室\u003c/h1\u003e\n            \u003cdiv class=\"subtitle\"\u003e班长 · 夏晚妤\u003c/div\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"glass-card\"\u003e\n            \u003cp class=\"story-text\"\u003e\n                教学楼已熄灯。月光从窗帘缝隙透入，手机手电筒放在讲台上是唯一光源——像聚光灯一样照亮她的身体。校服被整齐叠好放在课桌上。她正在讲台上用桌角摩擦下体，沉浸在幻想被注视的快感中。\n            \u003c/p\u003e\n            \u003cp class=\"story-text\"\u003e\n                你回教室拿忘带的作业。推开门的一瞬间，她僵住了——\u003cspan class=\"emphasis\"\u003e全裸\u003c/span\u003e，手还在两腿之间。你认出她是\u003cspan class=\"emphasis\"\u003e夏晚妤\u003c/span\u003e——班长，你的同桌，年级前十，从不迟到早退的乖乖女。她保持蹲在讲台上的姿势，眼眶发红，声音在发抖。\n            \u003c/p\u003e\n            \u003cp class=\"story-text\"\u003e\n                她是第一个知道你看到的人。而你是第一个知道她秘密的人。\n            \u003c/p\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"glass-card\"\u003e\n            \u003ch2 style=\"font-size:17px;color:#b0b8c8;margin-bottom:12px;text-align:center;\"\u003e👩 夏晚妤 · 班长\u003c/h2\u003e\n            \u003cp style=\"font-size:14px;line-height:1.8;color:#c8ccd8;\"\u003e\n                \u003cspan class=\"emphasis\"\u003e17岁\u003c/span\u003e，高中二年级班长，你的同桌。身高160cm，黑长直及肩，平时用浅蓝色发夹别起碎发。戴圆框细边眼镜，圆脸，皮肤白皙，眼睛很大，嘴唇偏薄。\n            \u003c/p\u003e\n            \u003cp style=\"font-size:14px;line-height:1.8;color:#c8ccd8;margin-top:6px;\"\u003e\n                \u003cspan class=\"emphasis\"\u003e身材：\u003c/span\u003eC罩杯乳房，标准的半球形，饱满挺翘，乳头颜色极浅，兴奋时逐渐变成深粉色并完全硬挺。腰很细，臀部小巧但弧度恰到好处。大腿内侧皮肤白皙得能看到青色血管。\n            \u003c/p\u003e\n            \u003cp style=\"font-size:14px;line-height:1.8;color:#c8ccd8;margin-top:6px;\"\u003e\n                \u003cspan class=\"emphasis\"\u003e性格：\u003c/span\u003e白天是温柔乖巧的乖乖女——说话声音小，被点名回答问题时脸红到耳根。但内心深处隐藏着一个从初二就开始的秘密：她最大的幻想是在众目睽睽之下被人注视、被人占有。羞耻本身成了快感的一部分。这个秘密她藏了五年，直到今晚被你撞见。\n            \u003c/p\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"glass-card\" id=\"branchCard\"\u003e\n            \u003ch2 style=\"font-size:17px;color:#b0b8c8;margin-bottom:14px;text-align:center;\"\u003e🔀 选择你的回应\u003c/h2\u003e\n            \u003cp style=\"font-size:13px;color:var(--text-dim);text-align:center;margin-bottom:12px;\"\u003e你推开门看到了她。接下来你选择——\u003c/p\u003e\n            \u003cdiv class=\"branch-selector\" id=\"branchSelector\"\u003e\n                \u003cdiv class=\"branch-option active\" data-branch=\"1\" onclick=\"selectBranch(1)\"\u003e\n                    分支一\u003cspan class=\"branch-desc\"\u003e秘密观众\u003c/span\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"branch-option\" data-branch=\"2\" onclick=\"selectBranch(2)\"\u003e\n                    分支二\u003cspan class=\"branch-desc\"\u003e观众契约\u003c/span\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"branch-option\" data-branch=\"3\" onclick=\"selectBranch(3)\"\u003e\n                    分支三\u003cspan class=\"branch-desc\"\u003e威胁调教\u003c/span\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n            \u003cdiv id=\"branchExplain\" style=\"font-size:13px;color:#a0a8b8;margin-top:10px;text-align:center;line-height:1.7;\"\u003e\n                你默默退到窗外，在黑暗中观看。她不知道你在看，表演没有表演成分。白天你们仍是普通的同桌关系。\n            \u003c/div\u003e\n        \u003c/div\u003e\n\n        \u003cdetails class=\"rules-accordion\"\u003e\n            \u003csummary\u003e📊 数值系统与身体反应\u003c/summary\u003e\n            \u003cdiv class=\"rules-content\"\u003e\n                \u003cp class=\"rules-subtitle\"\u003e意识与暴露\u003c/p\u003e\n                \u003cul\u003e\n                    \u003cli\u003e暴露癖唤起：随暴露程度逐渐升高，影响她的主动性和身体敏感度。\u003c/li\u003e\n                    \u003cli\u003e羞耻心：与暴露癖唤起互为消长。高潮时羞耻心短暂归零。\u003c/li\u003e\n                    \u003cli\u003e身体反应按天数升级：第1天压抑高潮→第4天潮喷首次出现→第7天可连续高潮三到五次。\u003c/li\u003e\n                \u003c/ul\u003e\n            \u003c/div\u003e\n        \u003c/details\u003e\n\n        \u003cdetails class=\"rules-accordion\"\u003e\n            \u003csummary\u003e💞 分支二好感度与分支三奴性\u003c/summary\u003e\n            \u003cdiv class=\"rules-content\"\u003e\n                \u003cp class=\"rules-subtitle\"\u003e分支二好感度系统\u003c/p\u003e\n                \u003cul\u003e\n                    \u003cli\u003e初始好感60%。称赞身体+3%-5%；课堂高潮+5%-10%；欣赏大胆行为+5%-8%。\u003c/li\u003e\n                    \u003cli\u003e感情阶段：萌芽期(60%-70%)→升温期(70%-85%)→临界期(85%-95%)→确定关系(95%以上)。\u003c/li\u003e\n                \u003c/ul\u003e\n                \u003cp class=\"rules-subtitle\"\u003e分支三奴性系统（只增不减）\u003c/p\u003e\n                \u003cul\u003e\n                    \u003cli\u003e服从指令+5%-10%；课堂不反抗+3%-5%；说羞辱性话+3%-8%。\u003c/li\u003e\n                    \u003cli\u003e阶段：0%-30%被动服从→30%-60%习惯服从→60%-90%主动服从→90%-100%完全驯化。\u003c/li\u003e\n                \u003c/ul\u003e\n            \u003c/div\u003e\n        \u003c/details\u003e\n\n        \u003cdetails class=\"rules-accordion\"\u003e\n            \u003csummary\u003e🎭 自慰方式与道具\u003c/summary\u003e\n            \u003cdiv class=\"rules-content\"\u003e\n                \u003cp class=\"rules-subtitle\"\u003e深夜教室自慰方式\u003c/p\u003e\n                \u003cul\u003e\n                    \u003cli\u003e讲台桌角：最熟悉的方式。双腿分开蹲下，将桌角对准入口缓缓坐下。\u003c/li\u003e\n                    \u003cli\u003e课桌边缘：跨坐在自己的课桌上，用课桌边缘摩擦下体。\u003c/li\u003e\n                    \u003cli\u003e窗台：一条腿搭在窗台上，对着月光分开双腿。\u003c/li\u003e\n                    \u003cli\u003e黑板：背靠黑板，另一只手在黑板上写下清醒时绝不会写的词。\u003c/li\u003e\n                \u003c/ul\u003e\n                \u003cp class=\"rules-subtitle\"\u003e道具\u003c/p\u003e\n                \u003cul\u003e\n                    \u003cli\u003e深夜：跳蛋、震动棒、吸吮器、肛塞（狐狸/猫/兔尾）、拉珠、乳夹（带铃铛）。\u003c/li\u003e\n                    \u003cli\u003e白天课堂：小型跳蛋（遥控器在对方手里）、笔、尺子。\u003c/li\u003e\n                \u003c/ul\u003e\n            \u003c/div\u003e\n        \u003c/details\u003e\n\n        \u003cdetails class=\"rules-accordion\"\u003e\n            \u003csummary\u003e🏫 隐蔽场景\u003c/summary\u003e\n            \u003cdiv class=\"rules-content\"\u003e\n                \u003cul\u003e\n                    \u003cli\u003e体育器材室：厚体操垫、跳马箱，深夜绝对无人。\u003c/li\u003e\n                    \u003cli\u003e图书馆角落：最后一排书架后，必须绝对安静。\u003c/li\u003e\n                    \u003cli\u003e生物实验室：实验台边缘高度刚好适合她坐上去。\u003c/li\u003e\n                    \u003cli\u003e游泳馆：氯水气味掩盖分泌物腥味，湿泳衣紧贴皮肤。\u003c/li\u003e\n                    \u003cli\u003e女生厕所隔间：实验楼三楼最隐蔽，冲水声掩盖呻吟。\u003c/li\u003e\n                    \u003cli\u003e操场大树后：百年老榕树，树干挡住视线但随时可能有人经过。\u003c/li\u003e\n                \u003c/ul\u003e\n            \u003c/div\u003e\n        \u003c/details\u003e\n\n        \u003c!-- ==================== 同桌设定与预设行为 ==================== --\u003e\n        \u003cdiv class=\"glass-card\" id=\"playerSettingsCard\"\u003e\n            \u003ch2 style=\"font-size:17px;color:#b0b8c8;margin-bottom:14px;text-align:center;\"\u003e👤 同桌 · 我的设定\u003c/h2\u003e\n            \n            \u003cdiv class=\"setting-field\"\u003e\n                \u003clabel for=\"playerName\"\u003e姓名\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"playerName\" placeholder=\"请输入你的名字\" autocomplete=\"off\"\u003e\n                \u003cdiv class=\"small-hint\"\u003e高中二年级学生，夏晚妤的同桌 · 年龄：17岁\u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv class=\"setting-field\"\u003e\n                \u003clabel\u003e视角选择\u003c/label\u003e\n                \u003cdiv class=\"option-grid\" id=\"povSelector\"\u003e\n                    \u003cdiv class=\"option-item active\" data-pov=\"third\" onclick=\"selectPOV('third', this)\"\u003e第三人称（他）\u003c/div\u003e\n                    \u003cdiv class=\"option-item\" data-pov=\"first\" onclick=\"selectPOV('first', this)\"\u003e第一人称（我）\u003c/div\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"small-hint\"\u003e请选择你在游戏中的视角，AI将按此视角进行叙述。\u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv class=\"setting-field\"\u003e\n                \u003clabel\u003e性格\u003c/label\u003e\n                \u003cdiv class=\"option-grid\" id=\"personalitySelector\"\u003e\n                    \u003cdiv class=\"option-item\" onclick=\"selectPersonality('温和', this)\"\u003e温和\u003c/div\u003e\n                    \u003cdiv class=\"option-item\" onclick=\"selectPersonality('强势', this)\"\u003e强势\u003c/div\u003e\n                    \u003cdiv class=\"option-item\" onclick=\"selectPersonality('冷漠', this)\"\u003e冷漠\u003c/div\u003e\n                    \u003cdiv class=\"option-item\" onclick=\"selectPersonality('阳光', this)\"\u003e阳光\u003c/div\u003e\n                    \u003cdiv class=\"option-item\" onclick=\"selectPersonality('内向', this)\"\u003e内向\u003c/div\u003e\n                \u003c/div\u003e\n                \u003cinput type=\"text\" id=\"playerPersonalityInput\" placeholder=\"或在此自由输入性格，如：傲娇、腹黑...\" style=\"margin-top:8px;\"\u003e\n                \u003cdiv class=\"small-hint\"\u003e点击上方预设可直接填入，也可自行输入。\u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003c!-- 男性专属板块 --\u003e\n            \u003cdiv id=\"maleSection\"\u003e\n                \u003cdiv class=\"setting-field\"\u003e\n                    \u003clabel\u003e肉棒长度\u003c/label\u003e\n                    \u003cdiv class=\"slider-container\"\u003e\n                        \u003cinput type=\"range\" id=\"maleLength\" min=\"5\" max=\"25\" value=\"15\" step=\"1\" oninput=\"updateMaleLength()\"\u003e\n                        \u003cspan class=\"slider-value\" id=\"maleLengthValue\"\u003e15cm\u003c/span\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"slider-comment\" id=\"maleLengthComment\"\u003e“刚好，不算太大。”\u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv class=\"setting-field\"\u003e\n                \u003clabel\u003e默认穿着（可更改）\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"playerOutfit\" value=\"白色T恤 + 灰色短裤 + 黑色内裤\" placeholder=\"如：白色T恤 + 灰色短裤 + 黑色内裤\"\u003e\n                \u003cdiv class=\"small-hint\"\u003e夏晚妤可能会在调教中要求你更换，也可能亲手帮你脱掉。\u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"glass-card\" id=\"actionCard\"\u003e\n            \u003ch2 style=\"font-size:17px;color:#b0b8c8;margin-bottom:14px;text-align:center;\"\u003e🎯 我要怎么做\u003c/h2\u003e\n            \u003cdiv class=\"setting-field\"\u003e\n                \u003clabel for=\"actionPreset\"\u003e快速选择预设行为\u003c/label\u003e\n                \u003cselect id=\"actionPreset\" onchange=\"updateActionInput()\"\u003e\n                    \u003coption value=\"\"\u003e-- 选择预设 --\u003c/option\u003e\n                    \u003coption value=\"默默退到窗外，在黑暗中观看她接下来的表演\"\u003e默默退到窗外，在黑暗中观看她接下来的表演\u003c/option\u003e\n                    \u003coption value=\"推门进入，告诉她你理解她，想成为她的观众\"\u003e推门进入，告诉她你理解她，想成为她的观众\u003c/option\u003e\n                    \u003coption value=\"推门进入，用这个秘密威胁她服从你\"\u003e推门进入，用这个秘密威胁她服从你\u003c/option\u003e\n                    \u003coption value=\"假装什么都没看到，悄悄离开教室\"\u003e假装什么都没看到，悄悄离开教室\u003c/option\u003e\n                    \u003coption value=\"站在门口，等她先开口\"\u003e站在门口，等她先开口\u003c/option\u003e\n                \u003c/select\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"setting-field\"\u003e\n                \u003clabel for=\"actionCustom\"\u003e自定义行为描述\u003c/label\u003e\n                \u003ctextarea id=\"actionCustom\" rows=\"2\" placeholder=\"或在这里自由输入你想做的事情……\"\u003e\u003c/textarea\u003e\n                \u003cdiv class=\"small-hint\"\u003e选择预设后会自动填充，也可以直接修改。\u003c/div\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n\n        \u003c!-- 复制按钮 --\u003e\n        \u003cbutton class=\"copy-btn\" id=\"copyAllBtn\" onclick=\"showCopyDialog()\"\u003e\n            📋 一键复制设定与行为\n        \u003c/button\u003e\n    \u003c/div\u003e\n\n    \u003c!-- 复制弹窗 --\u003e\n    \u003cdiv class=\"copy-overlay\" id=\"copyOverlay\"\u003e\n        \u003cdiv class=\"copy-dialog\"\u003e\n            \u003ch3\u003e📋 你的开局设定\u003c/h3\u003e\n            \u003cdiv class=\"instruction\"\u003e\n                点击文本框全选并复制，或点击下方按钮。\u003cbr\u003e\n                如果无法一键复制，请尝试“下载为txt文件”。\n            \u003c/div\u003e\n            \u003ctextarea id=\"copyTextarea\" readonly onclick=\"this.select()\"\u003e\u003c/textarea\u003e\n            \u003cdiv class=\"btn-row-dialog\"\u003e\n                \u003cbutton class=\"btn-dialog btn-copy-auto\" id=\"btnAutoCopy\" onclick=\"autoCopy()\"\u003e一键复制\u003c/button\u003e\n                \u003cbutton class=\"btn-dialog btn-copy-download\" onclick=\"downloadSettings()\"\u003e下载为txt\u003c/button\u003e\n                \u003cbutton class=\"btn-dialog btn-close-dialog\" onclick=\"closeCopyDialog()\"\u003e关闭\u003c/button\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cscript\u003e\n        const nameInput = document.getElementById('playerName');\n        const personalityInput = document.getElementById('playerPersonalityInput');\n        const actionPreset = document.getElementById('actionPreset');\n        const actionCustom = document.getElementById('actionCustom');\n        const copyOverlay = document.getElementById('copyOverlay');\n        const copyTextarea = document.getElementById('copyTextarea');\n\n        let currentBranch = 1;\n        let currentPOV = 'third';\n\n        const branchExplains = {\n            1: '你默默退到窗外，在黑暗中观看。她不知道你在看，表演没有表演成分。白天你们仍是普通的同桌关系。',\n            2: '你推门进入并表示理解。你们建立了观众契约——她有了第一个真实观众。白天课堂她会主动挑逗你。',\n            3: '你推门进入并威胁她。她被迫服从你的命令。最初会哭、会沉默，但她的身体不会说谎。'\n        };\n\n        // 更适合深夜教室/班长设定的评语\n        const lengthComments = {\n            5:'“这么小……班长连夹紧的力气都省了。”',\n            6:'“有点可怜呢，班长估计都不会多看一眼。”',\n            7:'“别急，班长还没有开始认真。”',\n            8:'“尺寸不重要，能不能让班长求饶才重要。”',\n            9:'“刚好能藏进校服裤子里，不显眼。”',\n            10:'“普通尺寸，班长大概会装作不在意。”',\n            11:'“还行，能玩，但不够让班长腿软。”',\n            12:'“这个尺寸够用了，班长会脸红着偷偷看。”',\n            13:'“不错，应该能顶到让班长说不出话的深度。”',\n            14:'“班长会喜欢的，估计夹得很紧。”',\n            15:'“刚好，不算太大，但班长肯定受不了。”',\n            16:'“妹妹可能会叫出来，班长会咬住嘴唇硬撑。”',\n            17:'“有点深了，班长得慢慢适应才行。”',\n            18:'“这个……得慢慢来，班长第一次不一定吃得住。”',\n            19:'“太大了，班长会被顶得直不起腰。”',\n            20:'“别太急，会弄疼班长的。”',\n            21:'“这个尺寸……班长看到怕是会腿软。”',\n            22:'“会被顶到最里面的，班长肯定求饶。”',\n            23:'“班长光是看着就害怕了，别说碰。”',\n            24:'“太大了，得好好润滑，班长会哭的。”',\n            25:'“看到就腿软了，班长连站都站不稳。”'\n        };\n\n        window.selectBranch = function(branchNum) {\n            currentBranch = branchNum;\n            document.querySelectorAll('.branch-option').forEach(opt =\u003e {\n                opt.classList.toggle('active', parseInt(opt.dataset.branch) === branchNum);\n            });\n            document.getElementById('branchExplain').textContent = branchExplains[branchNum];\n        };\n\n        window.selectPOV = function(pov, el) {\n            currentPOV = pov;\n            document.querySelectorAll('#povSelector .option-item').forEach(opt =\u003e opt.classList.remove('active'));\n            el.classList.add('active');\n        };\n\n        window.selectPersonality = function(val, el) {\n            personalityInput.value = val;\n            document.querySelectorAll('#personalitySelector .option-item').forEach(opt =\u003e opt.classList.remove('active'));\n            el.classList.add('active');\n        };\n\n        personalityInput.addEventListener('input', () =\u003e {\n            document.querySelectorAll('#personalitySelector .option-item').forEach(opt =\u003e opt.classList.remove('active'));\n        });\n\n        window.updateMaleLength = function() {\n            const v = parseInt(document.getElementById('maleLength').value);\n            document.getElementById('maleLengthValue').textContent = v + 'cm';\n            document.getElementById('maleLengthComment').textContent = lengthComments[v] || '';\n        };\n\n        window.updateActionInput = function() {\n            const selected = actionPreset.value;\n            if (selected) {\n                actionCustom.value = selected;\n            }\n        };\n\n        function getSettingsText() {\n            const name = nameInput.value.trim() || '未命名';\n            const personality = personalityInput.value.trim() || '未设定';\n            const outfit = document.getElementById('playerOutfit').value.trim() || '白色T恤 + 灰色短裤 + 黑色内裤';\n            const length = document.getElementById('maleLength').value;\n            const action = actionCustom.value.trim() || '无特定行为';\n            const povText = currentPOV === 'first' ? '第一人称（我）' : '第三人称（他）';\n\n            const branchNames = { 1: '分支一：秘密观众', 2: '分支二：观众契约', 3: '分支三：威胁调教' };\n            const branchName = branchNames[currentBranch] || '分支一：秘密观众';\n\n            // 注意：此处复制文本中不包含评语，只保留 cm 数值\n            return `【同桌设定】\n姓名：${name}\n视角：${povText}\n性格：${personality}\n体型：正常\n肉棒长度：${length}cm\n默认穿着：${outfit}\n\n【当前选择的分支】\n${branchName}\n\n【我要怎么做】\n${action}`;\n        }\n\n        window.showCopyDialog = function() {\n            copyTextarea.value = getSettingsText();\n            copyOverlay.classList.add('show');\n            setTimeout(() =\u003e {\n                copyTextarea.focus();\n                copyTextarea.select();\n            }, 100);\n        };\n\n        window.closeCopyDialog = function() {\n            copyOverlay.classList.remove('show');\n        };\n\n        window.autoCopy = function() {\n            const text = getSettingsText();\n            const btn = document.getElementById('btnAutoCopy');\n            if (navigator.clipboard \u0026\u0026 navigator.clipboard.writeText) {\n                navigator.clipboard.writeText(text).then(() =\u003e {\n                    btn.textContent = '✅ 已复制！';\n                    btn.style.background = '#2a3a2a';\n                    setTimeout(() =\u003e { btn.textContent = '一键复制'; btn.style.background = ''; }, 2000);\n                }).catch(() =\u003e fallbackCopy(text, btn));\n            } else {\n                fallbackCopy(text, btn);\n            }\n        };\n\n        function fallbackCopy(text, btn) {\n            copyTextarea.value = text;\n            copyTextarea.focus();\n            copyTextarea.select();\n            try {\n                const success = document.execCommand('copy');\n                btn.textContent = success ? '✅ 已复制！' : '请手动复制';\n            } catch (e) {\n                btn.textContent = '请手动复制';\n            }\n            btn.style.background = '#2a3a2a';\n            setTimeout(() =\u003e { btn.textContent = '一键复制'; btn.style.background = ''; }, 2000);\n        }\n\n        window.downloadSettings = function() {\n            const text = getSettingsText();\n            const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });\n            const url = URL.createObjectURL(blob);\n            const a = document.createElement('a');\n            a.href = url;\n            a.download = '深夜教室设定_' + new Date().toLocaleDateString() + '.txt';\n            document.body.appendChild(a);\n            a.click();\n            document.body.removeChild(a);\n            URL.revokeObjectURL(url);\n        };\n\n        copyOverlay.addEventListener('click', function(e) {\n            if (e.target === this) closeCopyDialog();\n        });\n\n        updateMaleLength();\n    \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e","cover":"https://catai.wiki/4d94096d-df27-43cd-b8a5-00b95b9e1900/cover","cover_tiny":"","summary":"（记得看评论区）《重大更新》优化了页面以及夏晚妤在不同分支下好感度以及奴性的影响（半重做）\n深夜十一点半，教学楼早已熄灯。你返回教室拿作业，却透过窗户看到了这辈子最难以置信的画面——\n你的同桌夏晚妤，那个每天早上对你小声说“早安”、被老师点名时脸红到耳根的乖乖女班长，正全裸地坐在讲台上。她的校服被整齐叠好放在课桌上。她背对着你，双腿大开，用讲台桌角摩擦着自己的下体。压抑的喘息在空教室里回荡。\n她对着空无一人的座位自言自语：“你们在看吗……班长在讲台上做这种事，很意外吧……”\n她不知道窗外有人在注视。她不知道她的同桌正蹲在后门外面。\n你在窗外蹲了很久。你有三个选择：默默成为她每晚的秘密观众，看她一天比一天大胆；推开门，成为她第一个真实观众，开启一段白天与黑夜截然不同的秘密关系；或者推开门，用她的秘密换取她完全的服从。\n她是你的同桌。这个秘密，只有你知道。\n和角色卡相比加强了设定，有什么问题可以评论一下","is_anonymous":false,"memo":"","reward_points":0,"category":0,"total_fish_balls":0,"type":1,"is_public":true,"language":"zh-Hans","age_rating":99,"gender":1,"is_web3_app":false,"review_status":-1,"is_available_not_public":true,"average_cost_per_message":1426,"players_count":1340,"conv_count_for_avg_msg_per_conv":0,"like_count":5,"rating_count":2,"avg_rating_score":10,"depth_play_user_count":289,"avg_play_round_count":10,"overall_rank":281662618,"score":0,"first_published_at":1790337599,"published_at":1790337599,"deleted_at":0,"recommendation_reason":"","favorites_count":188,"comments_count":26,"mod_permission":4,"disable_css_mod":false,"has_special_cg":false},"model_config":{"id":"965c8f1e-6ecd-4a95-9ffa-ee620d92a0ab","app_id":"12aa4c36-6dd6-4dc7-98ed-ac730b0931d6","provider":"","model_id":"","configs":"","opening_statement":"选择一段开场白","suggested_questions":null,"suggested_questions_after_answer":{"enabled":true},"speech_to_text":{"enabled":false},"text_to_speech":{"enabled":false,"language":"","voice":""},"more_like_this":"","model":{"provider":"hiagi_deepseek_bd","name":"deepseek-v3.2","completion_params":{"top_k":40,"presence_penalty":0}},"user_input_form":"","dataset_query_variable":"","pre_prompt":"","pre_prompt_sort":0,"agent_mode":{"enabled":false,"max_iteration":5,"strategy":"react","tools":[]},"sensitive_word_avoidance":{"configs":[],"enabled":false,"type":""},"retriever_resource":{"enabled":false},"prompt_type":"simple","chat_prompt_config":"","completion_prompt_config":"","dataset_configs":{"datasets":{"datasets":[]},"retrieval_model":"single"},"external_data_tools":"","file_upload":{"image":{"detail":"high","enabled":false,"number_limits":3,"transfer_methods":["remote_url","local_file"]}},"world_book":"","banned_words":"","pre_length":4222,"pre_prompt_and_pre_post_text_length":4222,"world_book_length":8484,"ai_opening_statements":"","bg_image":"https://catai.wiki/5cf8a3e0-353a-47f8-09ee-daa3232acd00/bg","bg_mobile":"https://catai.wiki/dd9e96b6-b291-4b2f-558c-3dc84b0b4a00/mobile","built_in_css":"/* ================= 全局背景（深夜月光淡蓝） ================= */\nbody {\n    background: radial-gradient(ellipse at 50% 0%, #16223b 0%, #0a1120 50%, #04060a 100%) !important;\n    background-attachment: fixed !important;\n    color: #c8d8f0;\n}\n\n/* ================= 正文气泡（淡蓝琉璃风） ================= */\n.rk-main-text {\n    position: relative; \n    color: #d0e0f8; \n    font-size: 15px; \n    line-height: 2.0; \n    letter-spacing: 0.5px;\n    background: rgba(20, 35, 60, 0.75);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(100, 180, 255, 0.4);\n    border-radius: 18px; \n    padding: 20px 22px; \n    margin: 14px 0;\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(100, 180, 255, 0.05); \n    z-index: 1;\n}\n\n/* 夏晚妤的台词强制蓝色高亮（配合正则脚本强行染色） */\n.sister-xia { \n    color: #4db8ff !important; \n    font-weight: 700; \n    text-shadow: 0 0 8px rgba(77, 184, 255, 0.4); \n}\n\n/* ================= 幕布剧场（思维链折叠区） ================= */\n.rk-thinking {\n    background: rgba(10, 20, 35, 0.7); \n    border-left: 4px solid #4db8ff;\n    border-radius: 8px; \n    padding: 12px 16px; \n    font-size: 12px; \n    color: #8aa8c8; \n    margin-bottom: 10px;\n}\n.rk-thinking summary { cursor: pointer; color: #4db8ff; font-weight: bold; list-style: none; outline: none; }\n.rk-thinking summary::before { content: \"🎭 \"; }\n\n/* ================= 状态栏（垂直卡片列表） ================= */\n.rk-status-list { display: flex; flex-direction: column; gap: 10px; margin: 14px 0; }\n.rk-status-card {\n    background: rgba(16, 28, 48, 0.8); \n    border: 1px solid rgba(77, 184, 255, 0.3);\n    border-radius: 12px; \n    padding: 14px 16px; \n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);\n    backdrop-filter: blur(8px);\n}\n.rk-status-card summary {\n    cursor: pointer; font-weight: bold; font-size: 14px; color: #80c8ff;\n    outline: none; user-select: none; list-style: none;\n}\n.rk-status-card summary::before { content: \"▶ \"; font-size: 12px; color: #4db8ff; }\n.rk-status-content { \n    margin-top: 10px; \n    white-space: pre-wrap; \n    color: #b0c8e0; \n    font-size: 13px; \n    line-height: 1.9; \n    padding-left: 4px; \n}\n\n/* ================= 选项按钮 ================= */\n.rk-options { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }\n.rk-option-item {\n    background: rgba(16, 28, 48, 0.8); \n    border: 1.5px solid rgba(77, 184, 255, 0.4); \n    border-radius: 12px; \n    padding: 16px 18px; \n    color: #a0d0ff; \n    font-size: 14px; \n    font-weight: 600;\n    cursor: pointer; \n    transition: all 0.25s ease; \n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n}\n.rk-option-item:hover {\n    background: rgba(77, 184, 255, 0.15); border-color: #4db8ff;\n    transform: translateY(-2px); box-shadow: 0 6px 20px rgba(77, 184, 255, 0.2);\n    color: #ffffff;\n}","shortcut_commands":[],"preset_type":1,"preset_chats":[],"is_have_cg_image":false,"bgm":{"autoplay":true},"dmm_points":20,"default_sent_message_count":6,"regex_replaces":[{"title":"清理Markdown外壳","match_regex":"```(?:html)?\\n?([\\s\\S]*?)```","replace_text":"$1","scope":1,"is_enable":true,"is_only_render":true},{"title":"格式化剧场","match_regex":"\u003cthinking\u003e([\\s\\S]*?)\u003c/thinking\u003e","replace_text":"\u003cdetails class=\"rk-thinking\"\u003e\u003csummary\u003e幕后剧场与状态推演\u003c/summary\u003e\u003cdiv style=\"margin-top:8px;\"\u003e$1\u003c/div\u003e\u003c/details\u003e","scope":1,"is_enable":true,"is_only_render":true},{"title":"格式化正文","match_regex":"\u003cmain\u003e([\\s\\S]*?)\u003c/main\u003e","replace_text":"\u003cdiv class=\"rk-main-text\"\u003e$1\u003c/div\u003e","scope":1,"is_enable":true,"is_only_render":true},{"title":"强制给双引号上色","match_regex":"“([^”]*)”","replace_text":"\u003cspan class=\"sister-xia\"\u003e“$1”\u003c/span\u003e","scope":1,"is_enable":true,"is_only_r