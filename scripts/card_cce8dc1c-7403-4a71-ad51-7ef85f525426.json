lock;\nfont-size: 0.92em;\nmargin: 5px 0;\ncolor: #54455a;\nfont-weight: 500;\nletter-spacing: 0.3px;\n}\nhd d:first-child {\nfont-weight: 700;\ncolor: #7a4a6a;\nfont-size: 1.02em;\n}\n\nhr {\nborder: none;\nheight: 2px;\nbackground: linear-gradient(to right, transparent, #e8a0b8, #a0b8e8, transparent);\nmargin: 20px 0;\nopacity: 0.6;\n}\n\n/* ── 正文区 ── */\narticle {\nbackground: rgba(255, 255, 255, 0.95);\nborder-radius: 18px;\npadding: 22px 28px;\nborder: 1px solid #f2dfe2;\nbox-shadow: 0 6px 24px rgba(230, 180, 195, 0.12);\nbackdrop-filter: blur(4px);\n}\narticle p {\nmargin: 10px 0;\ntext-indent: 2em;\nletter-spacing: 0.2px;\n}\n\n/* ── 折叠面板 ── */\ndetails {\nmargin-top: 16px;\nbackground: rgba(255, 255, 255, 0.9);\nborder-radius: 16px;\nborder: 1px solid #ecd5db;\noverflow: hidden;\nbox-shadow: 0 4px 18px rgba(215, 165, 185, 0.10);\ntransition: box-shadow 0.3s ease;\n}\ndetails:hover {\nbox-shadow: 0 6px 24px rgba(215, 165, 185, 0.2);\n}\ndetails summary {\npadding: 14px 24px;\ncursor: pointer;\nfont-weight: 650;\nfont-size: 1.02em;\nbackground: linear-gradient(90deg, #fdf0f5 0%, #f0ecff 100%);\ncolor: #6a4a6a;\nlist-style: none;\nuser-select: none;\ndisplay: flex;\nalign-items: center;\ngap: 8px;\nborder-bottom: 1px solid transparent;\ntransition: all 0.3s ease;\n}\ndetails[open] summary {\nborder-bottom: 1px solid #f0dde2;\nbackground: linear-gradient(90deg, #fde6ee 0%, #e4e6ff 100%);\n}\ndetails summary::-webkit-details-marker {\ndisplay: none;\n}\ndetails summary::before {\ncontent: '❀';\nfont-size: 0.9em;\ncolor: #c68aa0;\nmargin-right: 6px;\ntransition: transform 0.3s ease;\n}\ndetails[open] summary::before {\ncontent: '❁';\ntransform: rotate(180deg);\n}\n\ndetails p {\nmargin: 10px 24px;\npadding: 4px 0;\nfont-size: 0.95em;\nborder-bottom: 1px dashed #f5e8ea;\n}\ndetails p:last-child {\nborder-bottom: none;\n}\n\n/* ── 字段名标签 ── */\nf {\ndisplay: inline-block;\nfont-weight: 700;\ncolor: #a06880;\nmargin-right: 10px;\nfont-size: 0.9em;\nletter-spacing: 0.5px;\nbackground: linear-gradient(90deg, #ffeef2, #f2edff);\npadding: 2px 10px;\nborder-radius: 20px;\nborder: 1px solid #f0dce2;\n}\n\n/* ── 剧情选项（q引用块） ── */\nq {\ndisplay: block;\nmargin: 8px 24px;\npadding: 10px 18px;\nbackground: linear-gradient(90deg, #fbf4f6, #f4f2ff);\nborder-radius: 12px;\nborder-left: 4px solid #d4a0b8;\nborder-right: 1px solid #f0e4e6;\nfont-style: normal;\ncolor: #4a3a4a;\ntransition: background 0.2s;\n}\nq:hover {\nbackground: linear-gradient(90deg, #fdeef2, #e8e6ff);\n}\n\n/* ── 表格区（命运档案馆） ── */\ntable {\nwidth: 92%;\nmargin: 12px auto;\nborder-collapse: separate;\nborder-spacing: 0;\nbackground: #fcf8fa;\nborder-radius: 12px;\noverflow: hidden;\nbox-shadow: 0 2px 12px rgba(220, 180, 195, 0.08);\n}\nth {\nbackground: linear-gradient(90deg, #f9e8ee, #eee8ff);\ncolor: #6a4a6a;\npadding: 10px 12px;\nfont-weight: 650;\nfont-size: 0.92em;\ntext-align: left;\nborder-bottom: 1px solid #f0dfe4;\n}\ntd {\npadding: 9px 12px;\nborder-top: 1px solid #f5e9ec;\ncolor: #4a3a4a;\nfont-size: 0.92em;\n}\ntr:first-child th:first-child {\nborder-top-left-radius: 12px;\n}\ntr:first-child th:last-child {\nborder-top-right-radius: 12px;\n}\n\n/* ── 对话字体颜色增强（保持用户已有的font标签） ── */\narticle font[color=\"#1E90FF\"] {\ntext-shadow: 0 0 8px rgba(30, 144, 255, 0.15);\n}\narticle font[color=\"#9370DB\"] {\ntext-shadow: 0 0 8px rgba(147, 112, 219, 0.15);\n}\n\n/* ── 响应式适配 ── */\n@media (max-width: 640px) {\nai {\npadding: 16px 14px;\nborder-radius: 16px;\n}\narticle {\npadding: 16px 18px;\n}\ndetails summary {\npadding: 12px 16px;\n}\nq {\nmargin: 6px 14px;\npadding: 8px 12px;\n}\n}","shortcut_commands":[],"preset_type":1,"preset_chats":[],"is_have_cg_image":false,"bgm":{"autoplay":true},"dmm_points":20,"default_sent_message_count":6,"regex_replaces":[],"ai_variable_prompt":"","ai_variable_json":"","ai_variable_template":"","extend":{}},"tags":[{"id":"b2e178af-c72a-489c-b269-e6fb2bf025d0","name":"乱伦"},{"id":"a5bc9b34-db00-43a5-a6ff-50e8b612a4f4","name":"低消耗"},{"id":"1bf