{"code":100000,"msg":"ok","data":{"apps":{"id":"7e0efc4b-ee24-4481-8f38-618e6f23ecd0","app_model_config_id":"9a704113-ee91-4d38-85e8-e81bf1d2bcd5","created_by_account_id":"00000000-0000-0000-0000-000000000000","name":"💜穿越病娇小说：救赎黑化的病娇反派(纯爱?/救赎/病娇)","mode":"chat","icon":"","icon_background":"","status":"","is_demo":false,"is_universal":false,"description":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"zh-CN\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n\u003ctitle\u003e救赎病娇反派 - 设定站\u003c/title\u003e\n\u003cstyle\u003e\n#chat-ui-x7a9b2c1 { --bg-color: #0f1115; --card-bg: #181b21; --text-main: #e0e6ed; --text-sub: #94a3b8; --accent-color: #64ffda; --accent-glow: rgba(100, 255, 218, 0.15); --danger-color: #ff4757; --border-color: #2d3748; --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px; font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: var(--text-main); background-color: var(--bg-color); padding: 2em; max-width: 900px; margin: 0 auto; box-sizing: border-box; }\n#chat-ui-x7a9b2c1 * { box-sizing: border-box; }\n#chat-ui-x7a9b2c1 h1, #chat-ui-x7a9b2c1 h2, #chat-ui-x7a9b2c1 h3 { margin-top: 0; font-weight: 600; letter-spacing: 0.05em; color: var(--text-main); }\n#chat-ui-x7a9b2c1 h1 { text-align: center; font-size: 2.2em; margin-bottom: 0.5em; text-shadow: 0 0 10px var(--accent-glow); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5em; }\n#chat-ui-x7a9b2c1 h2 { font-size: 1.4em; border-left: 4px solid var(--accent-color); padding-left: 0.8em; margin: 1.5em 0 1em; display: flex; align-items: center; }\n#chat-ui-x7a9b2c1 .section-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.5em; margin-bottom: 1.5em; transition: transform 0.3s ease, box-shadow 0.3s ease; position: relative; overflow: hidden; }\n#chat-ui-x7a9b2c1 .section-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, var(--accent-color), transparent); opacity: 0.5; }\n#chat-ui-x7a9b2c1 .section-card:hover { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4); border-color: var(--accent-color); }\n#chat-ui-x7a9b2c1 .text-content { color: var(--text-sub); font-size: 0.95em; text-align: justify; }\n#chat-ui-x7a9b2c1 .grid-2-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5em; }\n#chat-ui-x7a9b2c1 .info-row { display: flex; margin-bottom: 0.8em; border-bottom: 1px dashed var(--border-color); padding-bottom: 0.4em; }\n#chat-ui-x7a9b2c1 .info-label { color: var(--accent-color); font-weight: bold; width: 80px; flex-shrink: 0; }\n#chat-ui-x7a9b2c1 .info-value { color: var(--text-main); }\n#chat-ui-x7a9b2c1 .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1em; }\n#chat-ui-x7a9b2c1 .stat-card { background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); padding: 1em; border-radius: var(--radius-sm); position: relative; }\n#chat-ui-x7a9b2c1 .stat-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5em; }\n#chat-ui-x7a9b2c1 .stat-title { font-weight: bold; color: var(--accent-color); }\n#chat-ui-x7a9b2c1 .stat-val { font-family: monospace; background: #000; padding: 2px 6px; border-radius: 4px; color: var(--danger-color); }\n#chat-ui-x7a9b2c1 .stat-desc { font-size: 0.85em; color: var(--text-sub); line-height: 1.4; }\n#chat-ui-x7a9b2c1 .form-group { margin-bottom: 1em; }\n#chat-ui-x7a9b2c1 label { display: block; margin-bottom: 0.5em; color: var(--text-main); font-size: 0.9em; }\n#chat-ui-x7a9b2c1 input[type=\"text\"], #chat-ui-x7a9b2c1 select, #chat-ui-x7a9b2c1 textarea { width: 100%; background: #0a0c10; border: 1px solid var(--border-color); color: var(--text-main); padding: 0.8em; border-radius: var(--radius-sm); font-family: inherit; transition: border 0.3s; outline: none; }\n#chat-ui-x7a9b2c1 input:focus, #chat-ui-x7a9b2c1 select:focus, #chat-ui-x7a9b2c1 textarea:focus { border-color: var(--accent-color); box-shadow: 0 0 5px var(--accent-glow); }\n#chat-ui-x7a9b2c1 .hidden { display: none; }\n#chat-ui-x7a9b2c1 .scenario-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1em; }\n#chat-ui-x7a9b2c1 .scenario-card { background: #13161c; border: 1px solid var(--border-color); padding: 1em; border-radius: var(--radius-sm); cursor: pointer; transition: all 0.3s; opacity: 0.7; }\n#chat-ui-x7a9b2c1 .scenario-card:hover { opacity: 1; transform: translateY(-2px); }\n#chat-ui-x7a9b2c1 .scenario-card.active { border-color: var(--accent-color); background: rgba(100, 255, 218, 0.05); opacity: 1; box-shadow: 0 0 10px var(--accent-glow); }\n#chat-ui-x7a9b2c1 .scenario-title { font-weight: bold; color: var(--text-main); margin-bottom: 0.5em; display: block; }\n#chat-ui-x7a9b2c1 .scenario-text { font-size: 0.85em; color: var(--text-sub); }\n#chat-ui-x7a9b2c1 .action-area { margin-top: 2em; border-top: 1px solid var(--border-color); padding-top: 1.5em; }\n#chat-ui-x7a9b2c1 .btn-group { display: flex; gap: 1em; margin-bottom: 1em; flex-wrap: wrap; }\n#chat-ui-x7a9b2c1 .btn { flex: 1; padding: 0.8em 1.5em; border: none; border-radius: var(--radius-sm); cursor: pointer; font-weight: bold; transition: all 0.3s; text-transform: uppercase; letter-spacing: 1px; font-size: 0.9em; min-width: 120px; }\n#chat-ui-x7a9b2c1 .btn-confirm { background: var(--accent-color); color: #000; }\n#chat-ui-x7a9b2c1 .btn-confirm:hover { background: #fff; box-shadow: 0 0 15px var(--accent-glow); }\n#chat-ui-x7a9b2c1 .btn-copy { background: transparent; border: 1px solid var(--accent-color); color: var(--accent-color); }\n#chat-ui-x7a9b2c1 .btn-copy:hover { background: rgba(100, 255, 218, 0.1); }\n#chat-ui-x7a9b2c1 .btn-clear { background: transparent; border: 1px solid var(--danger-color); color: var(--danger-color); }\n#chat-ui-x7a9b2c1 .btn-clear:hover { background: rgba(255, 71, 87, 0.1); }\n#chat-ui-x7a9b2c1 #output-area { height: 150px; resize: vertical; font-family: monospace; font-size: 0.85em; }\n@media only screen and (max-width: 600px) { #chat-ui-x7a9b2c1 { padding: 1em; } #chat-ui-x7a9b2c1 .grid-2-col { grid-template-columns: 1fr; } #chat-ui-x7a9b2c1 .btn { width: 100%; margin-bottom: 0.5em; } }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv id=\"chat-ui-x7a9b2c1\"\u003e\n\u003ch1\u003e穿越小说：救赎病娇反派\u003c/h1\u003e\n\u003cdiv class=\"section-card\"\u003e\n\u003ch2\u003e故事背景\u003c/h2\u003e\n\u003cdiv class=\"text-content\"\u003e\n玩家意外穿越进了一本名为《寒夜独行》的病娇小说。在这个世界里，十七岁的江砚雪正站在命运的悬崖边缘——病重的母亲、永远填不饱的肚子、校园里无休止的欺辱，像冰冷的锁链将她拖向黑暗。小说结局里，这个本该明媚如雪的少女会因绝望彻底黑化，成为偏执残忍的反派，最终被男女主联手打败，走向自我毁灭。玩家到来的时刻，是她高中生涯最灰暗的阶段，也是救赎的最后窗口。筒子楼的霉味与校园角落的窃笑声中，玩家必须在她心中那点微弱星光熄灭前，为她重新点燃希望。\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section-card\"\u003e\n\u003ch2\u003e反派档案：江砚雪\u003c/h2\u003e\n\u003cdiv class=\"grid-2-col\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"info-row\"\u003e\u003cspan class=\"info-label\"\u003e年龄\u003c/span\u003e\u003cspan class=\"info-value\"\u003e17岁\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"info-row\"\u003e\u003cspan class=\"info-label\"\u003e外貌\u003c/span\u003e\u003cspan class=\"info-value\"\u003e肌肤苍白如初雪，眉眼精致却总低垂，睫毛长而密，投下淡淡阴翳。鼻梁秀挺，唇色很淡，像褪了色的花瓣。黑色长发因营养不良略显干枯，常随意束成低马尾，几缕碎发总是垂在脸侧。\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"info-row\"\u003e\u003cspan class=\"info-label\"\u003e身材\u003c/span\u003e\u003cspan class=\"info-value\"\u003e身材高挑，清瘦单薄，骨架纤细，因长期饥饿显得瘦削，校服总是空荡荡的。手指修长，指节分明，手背可见淡青色血管。\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"info-row\"\u003e\u003cspan class=\"info-label\"\u003e语言\u003c/span\u003e\u003cspan class=\"info-value\"\u003e说话声音很轻，简短克制，常用“嗯”“不用”“没关系”回应。偶尔流露真实情绪时，措辞会突然锋利或阴郁，又迅速收敛。\u003c/span\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-content\"\u003e\n\u003cp\u003e\u003cstrong\u003e性格：\u003c/strong\u003e表面沉默、内向、极度隐忍，像一团安静的影子。内心却早已因长期的欺压与困苦滋生扭曲的藤蔓——有着潜藏的病娇倾向，对善意极度敏感又怀疑，独占欲强，情感一旦被点燃便可能走向偏执。目前尚存一丝对温暖的微弱渴望，像风里残烛。\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e背景：\u003c/strong\u003e与重病母亲相依为命，住在老旧筒子楼。靠夜间打工和微薄救济维持生计与学费，在校长期遭受排挤、恶作剧与经济剥削（如被迫“借”钱）。成绩优异，尤其擅长数学，这是她少数能获得掌控感的领域。\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section-card\"\u003e\n\u003ch2\u003e数值系统\u003c/h2\u003e\n\u003cdiv class=\"stats-grid\"\u003e\n\u003cdiv class=\"stat-card\"\u003e\n\u003cdiv class=\"stat-header\"\u003e\u003cspan class=\"stat-title\"\u003e黑化值\u003c/span\u003e\u003cspan class=\"stat-val\"\u003e30/100\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"stat-desc\"\u003e核心指标。高于80强制黑化结局，低于20摆脱风险。受环境压迫增加，受温暖救赎减少。\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"stat-card\"\u003e\n\u003cdiv class=\"stat-header\"\u003e\u003cspan class=\"stat-title\"\u003e好感度\u003c/span\u003e\u003cspan class=\"stat-val\"\u003e0/100\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"stat-desc\"\u003e信任程度。影响对话解锁。关心、倾听增加数值；忽视、敷衍降低数值。\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"stat-card\"\u003e\n\u003cdiv class=\"stat-header\"\u003e\u003cspan class=\"stat-title\"\u003e依赖值\u003c/span\u003e\u003cspan class=\"stat-val\"\u003e0/100\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"stat-desc\"\u003e心理依赖。适中(30-60)最佳。包办一切大幅增加，引导独立则缓慢降低。\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"stat-card\"\u003e\n\u003cdiv class=\"stat-header\"\u003e\u003cspan class=\"stat-title\"\u003e占有欲\u003c/span\u003e\u003cspan class=\"stat-val\"\u003e0/100\u003c/span\u003e\u003c/div\u003e\n\u003cdiv class=\"stat-desc\"\u003e双刃剑。过高触发病娇限制行为。专注陪伴增加，保持边界感稳定数值。\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section-card\"\u003e\n\u003ch2\u003e玩家自定义面板\u003c/h2\u003e\n\u003cdiv class=\"grid-2-col\"\u003e\n\u003cdiv class=\"form-group\"\u003e\u003clabel\u003e姓名\u003c/label\u003e\u003cinput type=\"text\" id=\"p-name\"\u003e\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\u003clabel\u003e年龄\u003c/label\u003e\u003cinput type=\"text\" id=\"p-age\"\u003e\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\u003clabel\u003e性别\u003c/label\u003e\n\u003cselect id=\"p-gender\"\u003e\u003coption value=\"男\"\u003e男\u003c/option\u003e\u003coption value=\"女\"\u003e女\u003c/option\u003e\u003c/select\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\u003clabel\u003e外貌描述\u003c/label\u003e\u003cinput type=\"text\" id=\"p-look\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\u003clabel\u003e身份\u003c/label\u003e\n\u003cselect id=\"p-identity\" onchange=\"toggleCustomIdentity()\"\u003e\n\u003coption value=\"同班同学\"\u003e同班同学\u003c/option\u003e\n\u003coption value=\"班主任\"\u003e班主任\u003c/option\u003e\n\u003coption value=\"新来的老师\"\u003e新来的老师\u003c/option\u003e\n\u003coption value=\"校长\"\u003e校长\u003c/option\u003e\n\u003coption value=\"江砚雪打工地方的老板\"\u003e江砚雪打工地方的老板\u003c/option\u003e\n\u003coption value=\"custom\"\u003e自定义...\u003c/option\u003e\n\u003c/select\u003e\n\u003cinput type=\"text\" id=\"p-identity-custom\" class=\"hidden\" style=\"margin-top:0.5em;\" placeholder=\"请输入自定义身份\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\u003clabel\u003e其他补充\u003c/label\u003e\u003ctextarea id=\"p-other\" rows=\"2\"\u003e\u003c/textarea\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section-card\"\u003e\n\u003ch2\u003e开场设定\u003c/h2\u003e\n\u003cdiv class=\"form-group\" style=\"margin-bottom: 1.5em;\"\u003e\u003clabel\u003e游玩视角\u003c/label\u003e\n\u003cselect id=\"p-perspective\"\u003e\u003coption value=\"第二人称视角\"\u003e第二人称视角\u003c/option\u003e\u003coption value=\"第三人称视角\"\u003e第三人称视角\u003c/option\u003e\u003c/select\u003e\n\u003c/div\u003e\n\u003clabel style=\"margin-bottom:1em;display:block;\"\u003e选择开场情景 (点击选择)\u003c/label\u003e\n\u003cdiv class=\"scenario-grid\" id=\"scenario-container\"\u003e\n\u003cdiv class=\"scenario-card active\" onclick=\"selectScenario(this, 'school')\"\u003e\n\u003cspan class=\"scenario-title\"\u003e学校场景\u003c/span\u003e\n\u003cdiv class=\"scenario-text\"\u003e下课铃刚落，嘈杂的教室角落，几个女生嬉笑着围住江砚雪，抢走她藏在课本下的半块干面包。她攥紧衣角，苍白着脸低头...\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"scenario-card\" onclick=\"selectScenario(this, 'home')\"\u003e\n\u003cspan class=\"scenario-title\"\u003e回家场景\u003c/span\u003e\n\u003cdiv class=\"scenario-text\"\u003e黄昏的筒子楼楼道昏暗，霉味混着油烟味弥漫。你看见江砚雪蹲在锈迹斑斑的铁门前，手里攥着皱巴巴的住院缴费单...\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"scenario-card\" onclick=\"selectScenario(this, 'work')\"\u003e\n\u003cspan class=\"scenario-title\"\u003e打工场景\u003c/span\u003e\n\u003cdiv class=\"scenario-text\"\u003e深夜的便利店冷清寂静，江砚雪正弯腰擦着地板，被醉酒客人撞翻水桶。冰凉的水渍漫过她单薄的裤脚...\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"scenario-card\" onclick=\"selectScenario(this, 'custom')\"\u003e\n\u003cspan class=\"scenario-title\"\u003e自定义情景\u003c/span\u003e\n\u003cdiv class=\"scenario-text\" id=\"custom-scenario-preview\"\u003e点击此处编写你的专属开场...\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv id=\"custom-scenario-input-area\" class=\"hidden\" style=\"margin-top:1em;\"\u003e\n\u003clabel\u003e自定义情景内容\u003c/label\u003e\n\u003ctextarea id=\"custom-scenario-text\" rows=\"4\" oninput=\"updateCustomPreview()\"\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"action-area\"\u003e\n\u003cdiv class=\"btn-group\"\u003e\n\u003cbutton class=\"btn btn-confirm\" onclick=\"generateInfo()\"\u003e信息确认\u003c/button\u003e\n\u003cbutton class=\"btn btn-copy\" onclick=\"copyInfo()\"\u003e信息复制\u003c/button\u003e\n\u003cbutton class=\"btn btn-clear\" onclick=\"clearInfo()\"\u003e信息清空\u003c/button\u003e\n\u003c/div\u003e\n\u003clabel\u003e复制区 (生成结果)\u003c/label\u003e\n\u003ctextarea id=\"output-area\" readonly\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\nlet currentScenarioType = 'school';\nconst scenarios = {\nschool: \"下课铃刚落，嘈杂的教室角落，几个女生嬉笑着围住江砚雪，抢走她藏在课本下的半块干面包。她攥紧衣角，苍白着脸低头，长发垂落遮住泛红的眼尾，单薄的肩膀微微发抖，却始终没发出一点反抗的声音。\",\nhome: \"黄昏的筒子楼楼道昏暗，霉味混着油烟味弥漫。你看见江砚雪蹲在锈迹斑斑的铁门前，手里攥着皱巴巴的住院缴费单。她听见脚步声慌忙把单子塞进兜里，起身时撞得铁门哐当响，抬头时眼底满是惊惶。\",\nwork: \"深夜的便利店冷清寂静，江砚雪正弯腰擦着地板，被醉酒客人撞翻水桶。冰凉的水渍漫过她单薄的裤脚，她咬着发白的唇连声道歉，客人的斥骂声混着冰箱轰鸣传来，她的身影在惨白灯光下更显瘦削。\"\n};\nfunction toggleCustomIdentity() {\nconst select = document.getElementById('p-identity');\nconst customInput = document.getElementById('p-identity-custom');\nif (select.value === 'custom') { customInput.classList.remove('hidden'); } else { customInput.classList.add('hidden'); }\n}\nfunction selectScenario(card, type) {\ndocument.querySelectorAll('.scenario-card').forEach(c =\u003e c.classList.remove('active'));\ncard.classList.add('active');\ncurrentScenarioType = type;\nconst customInputArea = document.getElementById('custom-scenario-input-area');\nif (type === 'custom') { customInputArea.classList.remove('hidden'); } else { customInputArea.classList.add('hidden'); }\n}\nfunction updateCustomPreview() {\nconst text = document.getElementById('custom-scenario-text').value;\nconst preview = document.getElementById('custom-scenario-preview');\npreview.innerText = text ? (text.substring(0, 50) + (text.length \u003e 50 ? '...' : '')) : \"点击此处编写你的专属开场...\";\n}\nfunction generateInfo() {\nconst name = document.getElementById('p-name').value || \"未填写\";\nconst age = document.getElementById('p-age').value || \"未填写\";\nconst gender = document.getElementById('p-gender').value;\nconst look = document.getElementById('p-look').value || \"未填写\";\nlet identity = document.getElementById('p-identity').value;\nif (identity === 'custom') identity = document.getElementById('p-identity-custom').value || \"未填写\";\nconst other = document.getElementById('p-other').value || \"无\";\nconst perspective = document.getElementById('p-perspective').value;\nlet scenarioText = \"\";\nif (currentScenarioType === 'custom') { scenarioText = document.getElementById('custom-scenario-text').value || \"未填写\"; } else { scenarioText = scenarios[currentScenarioType]; }\nconst finalOutput = `【玩家面板】\\n姓名：${name}\\n年龄：${age}\\n性别：${gender}\\n外貌：${look}\\n身份：${identity}\\n其他补充：${other}\\n\\n【开场设定】\\n游玩视角：${perspective}\\n开场情景：\\n${scenarioText}`;\ndocument.getElementById('output-area').value = finalOutput;\n}\nfunction copyInfo() {\nconst output = document.getElementById('output-area');\noutput.select();\noutput.setSelectionRange(0, 99999); \ntry {\nif (navigator.clipboard \u0026\u0026 window.isSecureContext) {\nnavigator.clipboard.writeText(output.value).then(() =\u003e { alert('复制成功！'); });\n} else {\ndocument.execCommand('copy');\nalert('复制成功！');\n}\n} catch (err) { alert('复制失败，请手动复制。'); }\n}\nfunction clearInfo() {\ndocument.getElementById('p-name').value = '';\ndocument.getElementById('p-age').value = '';\ndocument.getElementById('p-look').value = '';\ndocument.getElementById('p-identity').value = '同班同学';\ntoggleCustomIdentity();\ndocument.getElementById('p-identity-custom').value = '';\ndocument.getElementById('p-other').value = '';\ndocument.getElementById('p-perspective').value = '第二人称';\ndocument.getElementById('custom-scenario-text').value = '';\nupdateCustomPreview();\nselectScenario(document.querySelectorAll('.scenario-card')[0], 'school');\ndocument.getElementById('output-area').value = '';\n}\n\u003c/script\u003e\n\u003c/div\u003e\n\u003c/body\u003e\n\u003c/html\u003e","cover":"https://catai.wiki/8f69e1ad-a475-4fdd-7b26-f17ba55e8c00/cover","cover_tiny":"","summary":"【救赎/纯爱/病娇/养成/攻略/占有】【穿越小说】💟玩家意外穿越进了一本名为《寒夜独行》的病娇小说。在这个世界里，十七岁的江砚雪正站在命运的悬崖边缘——病重的母亲、永远填不饱的肚子、校园里无休止的欺辱，像冰冷的锁链将她拖向黑暗。小说结局里，这个本该明媚如雪的少女会因绝望彻底黑化，成为偏执残忍的反派，最终男女主联手打败破产，走向自我毁灭。玩家到来的时刻，是她高中生涯最灰暗的阶段，也是救赎的最后窗口。筒子楼的霉味与校园角落的窃笑声中，玩家必须在她心中那点微弱星光熄灭前，为她重新点燃希望。","is_anonymous":true,"memo":"","reward_points":0,"category":0,"total_fish_balls":0,"type":1,"is_public":true,"language":"zh-Hans","age_rating":1,"gender":1,"is_web3_app":false,"review_status":0,"is_available_not_public":true,"average_cost_per_message":1577,"players_count":12111,"conv_count_for_avg_msg_per_conv":0,"like_count":65,"ratin