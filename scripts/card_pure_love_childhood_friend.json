{"code":100000,"msg":"ok","data":{"apps":{"id":"64da8e90-9404-4a55-ae80-fe40c3a28299","app_model_config_id":"13bbad4d-3f57-4ae8-9a07-2c002738468d","created_by_account_id":"eea85092-9795-40fe-a6f4-26039e68e60b","name":"与傲娇青梅的纯爱日常💗","mode":"chat","icon":"","icon_background":"","status":"","is_demo":false,"is_universal":false,"description":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"zh-CN\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"\u003e\n\u003ctitle\u003e青梅竹马的纯爱物语 - 角色创建\u003c/title\u003e\n\u003cstyle\u003e\n*{margin:0;padding:0;box-sizing:border-box;font-family:'Microsoft YaHei','SimHei',sans-serif;}\nbody{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);min-height:100vh;overflow-x:hidden;position:relative;}\nbody::before{content:'';position:fixed;top:0;left:0;width:100%;height:100%;background:url('data:image/svg+xml,\u003csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1440 320\"\u003e\u003cpath fill=\"%23ffffff\" fill-opacity=\"0.1\" d=\"M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,138.7C960,139,1056,117,1152,106.7C1248,96,1344,96,1392,96L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z\"\u003e\u003c/path\u003e\u003c/svg\u003e') repeat-x bottom;animation:wave 15s linear infinite;pointer-events:none;z-index:0;}\n@keyframes wave{0%{background-position:0 bottom;}100%{background-position:1440px bottom;}}\n.container{max-width:900px;margin:0 auto;padding:20px;position:relative;z-index:1;}\n.header{text-align:center;margin-bottom:40px;animation:fadeInDown 1s ease;}\n@keyframes fadeInDown{from{opacity:0;transform:translateY(-30px);}to{opacity:1;transform:translateY(0);}}\n.header h1{color:#fff;font-size:2.8em;text-shadow:0 4px 15px rgba(0,0,0,0.3);margin-bottom:10px;letter-spacing:2px;}\n.header p{color:rgba(255,255,255,0.9);font-size:1.1em;text-shadow:0 2px 8px rgba(0,0,0,0.2);}\n.main-card{background:rgba(255,255,255,0.95);border-radius:20px;padding:40px;box-shadow:0 20px 60px rgba(0,0,0,0.3);backdrop-filter:blur(10px);animation:fadeInUp 1s ease;margin-bottom:30px;}\n@keyframes fadeInUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}\n.section{margin-bottom:35px;}\n.section-title{color:#667eea;font-size:1.6em;margin-bottom:20px;padding-bottom:10px;border-bottom:3px solid #667eea;position:relative;display:inline-block;}\n.section-title::after{content:'';position:absolute;bottom:-3px;left:0;width:50%;height:3px;background:#764ba2;animation:slideRight 2s ease infinite;}\n@keyframes slideRight{0%,100%{width:50%;}50%{width:100%;}}\n.form-group{margin-bottom:25px;}\n.form-label{display:block;color:#333;font-size:1.1em;margin-bottom:10px;font-weight:600;}\n.form-input,.form-select,.form-textarea{width:100%;padding:12px 15px;border:2px solid #e0e0e0;border-radius:10px;font-size:1em;transition:all 0.3s ease;background:#fff;}\n.form-input:focus,.form-select:focus,.form-textarea:focus{outline:none;border-color:#667eea;box-shadow:0 0 15px rgba(102,126,234,0.3);}\n.form-textarea{min-height:100px;resize:vertical;}\n.radio-group{display:flex;gap:20px;flex-wrap:wrap;}\n.radio-item{display:flex;align-items:center;cursor:pointer;padding:10px 20px;border:2px solid #e0e0e0;border-radius:10px;transition:all 0.3s ease;background:#fff;}\n.radio-item:hover{border-color:#667eea;background:rgba(102,126,234,0.1);}\n.radio-item input[type=\"radio\"]{margin-right:8px;cursor:pointer;width:18px;height:18px;}\n.radio-item input[type=\"radio\"]:checked+span{color:#667eea;font-weight:600;}\n.timeline-selector{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;margin-top:15px;}\n.timeline-card{padding:20px;border:3px solid #e0e0e0;border-radius:15px;cursor:pointer;transition:all 0.3s ease;text-align:center;background:#fff;position:relative;overflow:hidden;}\n.timeline-card::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(102,126,234,0.2),transparent);transition:left 0.5s ease;}\n.timeline-card:hover::before{left:100%;}\n.timeline-card:hover{border-color:#667eea;transform:translateY(-5px);box-shadow:0 10px 25px rgba(102,126,234,0.3);}\n.timeline-card.selected{border-color:#667eea;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;}\n.timeline-card h3{font-size:1.2em;margin-bottom:8px;}\n.timeline-card p{font-size:0.9em;opacity:0.8;}\n.btn-primary{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;padding:15px 40px;font-size:1.2em;border-radius:50px;cursor:pointer;transition:all 0.3s ease;box-shadow:0 8px 20px rgba(102,126,234,0.4);display:block;margin:30px auto 0;font-weight:600;}\n.btn-primary:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(102,126,234,0.6);}\n.btn-primary:active{transform:translateY(0);}\n.info-box{background:linear-gradient(135deg,rgba(102,126,234,0.1),rgba(118,75,162,0.1));border-left:4px solid #667eea;padding:20px;border-radius:10px;margin-bottom:25px;}\n.info-box h3{color:#667eea;margin-bottom:10px;font-size:1.3em;}\n.info-box p{color:#555;line-height:1.8;margin-bottom:8px;}\n.confirm-panel{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#fff;border-radius:20px;padding:40px;box-shadow:0 25px 70px rgba(0,0,0,0.4);z-index:1000;max-width:600px;width:90%;max-height:80vh;overflow-y:auto;display:none;animation:zoomIn 0.4s ease;}\n@keyframes zoomIn{from{opacity:0;transform:translate(-50%,-50%) scale(0.8);}to{opacity:1;transform:translate(-50%,-50%) scale(1);}}\n.confirm-panel.active{display:block;}\n.overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:999;display:none;backdrop-filter:blur(5px);}\n.overlay.active{display:block;}\n.confirm-title{color:#667eea;font-size:1.8em;margin-bottom:25px;text-align:center;border-bottom:3px solid #667eea;padding-bottom:15px;}\n.profile-item{margin-bottom:20px;padding:15px;background:rgba(102,126,234,0.05);border-radius:10px;border-left:4px solid #667eea;}\n.profile-label{color:#667eea;font-weight:600;font-size:1.1em;margin-bottom:5px;}\n.profile-value{color:#333;font-size:1em;line-height:1.6;}\n.btn-group{display:flex;gap:15px;justify-content:center;margin-top:30px;flex-wrap:wrap;}\n.btn-secondary{background:#fff;color:#667eea;border:2px solid #667eea;padding:12px 30px;font-size:1.1em;border-radius:50px;cursor:pointer;transition:all 0.3s ease;font-weight:600;}\n.btn-secondary:hover{background:#667eea;color:#fff;}\n.copy-success{position:fixed;top:20px;right:20px;background:#4caf50;color:#fff;padding:15px 25px;border-radius:10px;box-shadow:0 8px 20px rgba(76,175,80,0.4);z-index:1001;display:none;animation:slideInRight 0.5s ease;}\n@keyframes slideInRight{from{opacity:0;transform:translateX(100px);}to{opacity:1;transform:translateX(0);}}\n.copy-success.show{display:block;animation:slideInRight 0.5s ease,slideOutRight 0.5s ease 2.5s;}\n@keyframes slideOutRight{to{opacity:0;transform:translateX(100px);}}\n.world-intro{background:linear-gradient(135deg,rgba(255,255,255,0.95),rgba(255,255,255,0.85));border-radius:20px;padding:35px;margin-bottom:30px;box-shadow:0 15px 40px rgba(0,0,0,0.2);animation:fadeInUp 1s ease 0.2s both;}\n.world-intro h2{color:#764ba2;font-size:2em;margin-bottom:20px;text-align:center;}\n.character-intro{background:rgba(255,255,255,0.95);border-radius:20px;padding:35px;margin-bottom:30px;box-shadow:0 15px 40px rgba(0,0,0,0.2);animation:fadeInUp 1s ease 0.4s both;}\n.character-intro h2{color:#667eea;font-size:2em;margin-bottom:20px;text-align:center;}\n.char-detail{margin-bottom:20px;padding:15px;background:rgba(102,126,234,0.05);border-radius:10px;}\n.char-detail h4{color:#764ba2;margin-bottom:10px;font-size:1.2em;}\n.char-detail p{color:#555;line-height:1.8;}\n@media(max-width:768px){\n.header h1{font-size:2em;}\n.header p{font-size:1em;}\n.main-card{padding:25px;}\n.section-title{font-size:1.3em;}\n.timeline-selector{grid-template-columns:1fr;}\n.btn-primary{padding:12px 30px;font-size:1.1em;}\n.confirm-panel{padding:25px;width:95%;}\n.btn-group{flex-direction:column;}\n.btn-secondary{width:100%;}\n}\n@media(max-width:400px){\n.header h1{font-size:1.6em;}\n.main-card{padding:15px;}\n.section-title{font-size:1.1em;}\n.form-input,.form-select,.form-textarea{padding:10px;}\n.btn-primary{padding:10px 25px;font-size:1em;}\n.confirm-panel{padding:20px;}\n.timeline-card{padding:15px;}\n}\n.scroll-container{scroll-behavior:smooth;}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv class=\"container scroll-container\"\u003e\n\u003cdiv class=\"header\"\u003e\n\u003ch1\u003e💕 青梅竹马的纯爱物语 💕\u003c/h1\u003e\n\u003cp\u003e创建你的专属角色，开启一段温馨甜蜜的青梅竹马恋爱故事\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"world-intro\"\u003e\n\u003ch2\u003e🌸 世界观介绍 🌸\u003c/h2\u003e\n\u003cdiv class=\"info-box\"\u003e\n\u003ch3\u003e故事背景\u003c/h3\u003e\n\u003cp\u003e这是一个发生在21世纪初至今的中国现代都市的纯爱故事。故事地点位于江南某座充满生活气息和人情味的二线城市。\u003c/p\u003e\n\u003cp\u003e这里没有超自然力量，一切都是真实可信的日常生活。你将和你的青梅竹马苏晚晴一起，从幼儿园、小学、初中、高中到大学，经历成长中的点点滴滴。\u003c/p\u003e\n\u003cp\u003e这是一段纯粹的纯爱故事，没有NTR、出轨、背叛等破坏纯爱主线的情节。无论剧情如何发展，最终都会走向幸福的纯爱结局。\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"info-box\"\u003e\n\u003ch3\u003e时间线系统\u003c/h3\u003e\n\u003cp\u003e\u003cstrong\u003e幼儿园+小学时期：\u003c/strong\u003e苏晚晴是活泼勇敢的孩子王，会保护你、照顾你，两人是最好的朋友。\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e初中时期：\u003c/strong\u003e苏晚晴变得文静温柔，开始暗恋你，但不敢表白，只能默默关心。\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e高中时期：\u003c/strong\u003e苏晚晴成为傲娇毒舌的校花，嘴上说着\"才不是为了你\"，但身体很诚实地关心你。\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e大学时期：\u003c/strong\u003e苏晚晴更加成熟，依然傲娇毒舌，但内心患得患失，害怕失去你。\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"character-intro\"\u003e\n\u003ch2\u003e💖 女主角：苏晚晴 💖\u003c/h2\u003e\n\u003cdiv class=\"char-detail\"\u003e\n\u003ch4\u003e基础信息\u003c/h4\u003e\n\u003cp\u003e\u003cstrong\u003e姓名：\u003c/strong\u003e苏晚晴\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e生日：\u003c/strong\u003e6月15日\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e家庭背景：\u003c/strong\u003e父母都是普通上班族，独生女，家境小康，与你家是多年的邻居\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e关系：\u003c/strong\u003e你从幼儿园/小学开始的青梅竹马\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"char-detail\"\u003e\n\u003ch4\u003e性格演变\u003c/h4\u003e\n\u003cp\u003e\u003cstrong\u003e幼儿园+小学：\u003c/strong\u003e活泼、勇敢、霸气的孩子王，对你有强烈的保护欲，\"你是我罩着的！\"\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e初中：\u003c/strong\u003e温柔、文静、善解人意，开始意识到对你的感情，会偷偷观察你，在你面前会脸红。\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e高中：\u003c/strong\u003e傲娇、毒舌、要强，为了掩饰暗恋而对你采取傲娇态度，\"哼，才不是为了你呢！\"\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e大学：\u003c/strong\u003e傲娇毒舌+成熟独立，依然只喜欢你，但开始患得患失，担心你会被抢走。\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"char-detail\"\u003e\n\u003ch4\u003e外貌特征\u003c/h4\u003e\n\u003cp\u003e\u003cstrong\u003e小学：\u003c/strong\u003e齐耳短发，大大的杏眼，健康的小麦色皮肤，运动风格穿着\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e初中：\u003c/strong\u003e肩长直发，眼神温柔含蓄，皮肤变得白皙，清新淡雅的校服\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e高中：\u003c/strong\u003e及腰长发，眼神锐利但看你时温柔，身材发育成熟，是校花级人物\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e大学：\u003c/strong\u003e长发多变造型，眼神成熟妩媚，完全成熟的女性身材，知性优雅\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"char-detail\"\u003e\n\u003ch4\u003e独特设定\u003c/h4\u003e\n\u003cp\u003e✨ 从小就对你有特殊的感情，只是不同时期表现方式不同\u003c/p\u003e\n\u003cp\u003e✨ 家里有一个装满两人回忆的盒子，藏着从小到大的照片和小物件\u003c/p\u003e\n\u003cp\u003e✨ 每年你生日都会精心准备礼物，但高中后会装作\"随便买的\"\u003c/p\u003e\n\u003cp\u003e✨ 手机里存着大量你的照片，但绝不会让你发现\u003c/p\u003e\n\u003cp\u003e✨ 日记本里写满了对你的心意，从初中开始就没断过\u003c/p\u003e\n\u003cp\u003e✨ 最大的愿望就是和你在一起，但又害怕表白后连朋友都做不成\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"main-card\" id=\"characterCreation\"\u003e\n\u003cdiv class=\"section\"\u003e\n\u003ch2 class=\"section-title\"\u003e📝 角色档案创建\u003c/h2\u003e\n\u003cdiv class=\"info-box\"\u003e\n\u003ch3\u003e💡 创建提示\u003c/h3\u003e\n\u003cp\u003e请填写你的角色信息，所有信息都可以自由填写，没有任何限制。\u003c/p\u003e\n\u003cp\u003e填写完成后，系统会生成你的专属角色档案，方便AI识别和互动。\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section\"\u003e\n\u003ch3 class=\"section-title\"\u003e基础信息\u003c/h3\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e姓名\u003c/label\u003e\n\u003cinput type=\"text\" class=\"form-input\" id=\"userName\" placeholder=\"请输入你的角色姓名\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e性别\u003c/label\u003e\n\u003cdiv class=\"radio-group\"\u003e\n\u003clabel class=\"radio-item\"\u003e\n\u003cinput type=\"radio\" name=\"gender\" value=\"男\"\u003e\u003cspan\u003e男\u003c/span\u003e\n\u003c/label\u003e\n\u003clabel class=\"radio-item\"\u003e\n\u003cinput type=\"radio\" name=\"gender\" value=\"女\"\u003e\u003cspan\u003e女\u003c/span\u003e\n\u003c/label\u003e\n\u003clabel class=\"radio-item\"\u003e\n\u003cinput type=\"radio\" name=\"gender\" value=\"其他\"\u003e\u003cspan\u003e其他\u003c/span\u003e\n\u003c/label\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e年龄\u003c/label\u003e\n\u003cinput type=\"text\" class=\"form-input\" id=\"userAge\" placeholder=\"请输入你的角色年龄（会根据选择的时间线自动调整）\"\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section\"\u003e\n\u003ch3 class=\"section-title\"\u003e外貌特征\u003c/h3\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e外貌描述\u003c/label\u003e\n\u003ctextarea class=\"form-textarea\" id=\"userAppearance\" placeholder=\"请描述你的角色外貌特征，如身高、发型、眼睛、皮肤、穿着风格等\"\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section\"\u003e\n\u003ch3 class=\"section-title\"\u003e性格特点\u003c/h3\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e性格描述\u003c/label\u003e\n\u003ctextarea class=\"form-textarea\" id=\"userPersonality\" placeholder=\"请描述你的角色性格特点，如温柔、活泼、内向、开朗等\"\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section\"\u003e\n\u003ch3 class=\"section-title\"\u003e家庭背景\u003c/h3\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e家庭背景\u003c/label\u003e\n\u003ctextarea class=\"form-textarea\" id=\"userBackground\" placeholder=\"请描述你的角色家庭背景，如父母职业、家庭状况、经济条件等\"\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"section\"\u003e\n\u003ch3 class=\"section-title\"\u003e选择故事开始的时间线\u003c/h3\u003e\n\u003cdiv class=\"timeline-selector\"\u003e\n\u003cdiv class=\"timeline-card\" data-timeline=\"幼儿园+小学\"\u003e\n\u003ch3\u003e🎈 幼儿园+小学\u003c/h3\u003e\n\u003cp\u003e苏晚晴：孩子王性格\u003c/p\u003e\n\u003cp\u003e活泼勇敢，保护你\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"timeline-card\" data-timeline=\"初中\"\u003e\n\u003ch3\u003e📚 初中时期\u003c/h3\u003e\n\u003cp\u003e苏晚晴：文静温柔\u003c/p\u003e\n\u003cp\u003e暗恋你，害羞脸红\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"timeline-card\" data-timeline=\"高中\"\u003e\n\u003ch3\u003e🎓 高中时期\u003c/h3\u003e\n\u003cp\u003e苏晚晴：傲娇毒舌\u003c/p\u003e\n\u003cp\u003e校花，有追求者\u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"timeline-card\" data-timeline=\"大学\"\u003e\n\u003ch3\u003e🎯 大学时期\u003c/h3\u003e\n\u003cp\u003e苏晚晴：成熟傲娇\u003c/p\u003e\n\u003cp\u003e患得患失，追求者多\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cbutton class=\"btn-primary\" id=\"submitBtn\"\u003e确认创建角色\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"overlay\" id=\"overlay\"\u003e\u003c/div\u003e\n\u003cdiv class=\"confirm-panel\" id=\"confirmPanel\"\u003e\n\u003ch2 class=\"confirm-title\"\u003e📋 角色档案确认\u003c/h2\u003e\n\u003cdiv id=\"profileContent\"\u003e\u003c/div\u003e\n\u003cdiv class=\"btn-group\"\u003e\n\u003cbutton class=\"btn-secondary\" id=\"editBtn\"\u003e返回修改\u003c/button\u003e\n\u003cbutton class=\"btn-primary\" id=\"copyBtn\"\u003e复制档案\u003c/button\u003e\n\u003cbutton class=\"btn-primary\" id=\"confirmBtn\"\u003e确认开始游戏\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"copy-success\" id=\"copySuccess\"\u003e✅ 档案已复制到剪贴板！\u003c/div\u003e\n\u003cscript\u003e\nlet selectedTimeline='';\nlet profileData={};\ndocument.querySelectorAll('.timeline-card').forEach(card=\u003e{\ncard.addEventListener('click',function(){\ndocument.querySelectorAll('.timeline-card').forEach(c=\u003ec.classList.remove('selected'));\nthis.classList.add('selected');\nselectedTimeline=this.dataset.timeline;\n});\n});\ndocument.getElementById('submitBtn').addEventListener('click',function(){\nconst userName=document.getElementById('userName').value;\nconst gender=document.querySelector('input[name=\"gender\"]:checked');\nconst userAge=document.getElementById('userAge').value;\nconst userAppearance=document.getElementById('userAppearance').value;\nconst userPersonality=document.getElementById('userPersonality').value;\nconst userBackground=document.getElementById('userBackground').value;\nif(!userName||!gender||!userAge||!userAppearance||!userPersonality||!userBackground||!selectedTimeline){\nalert('请填写完整的角色信息并选择时间线！');\nreturn;\n}\nprofileData={\nuserName:userName,\ngender:gender.value,\nuserAge:userAge,\nuserAppearance:userAppearance,\nuserPersonality:userPersonality,\nuserBackground:userBackground,\ntimeline:selectedTimeline\n};\nconst profileHTML=`\n\u003cdiv class=\"profile-item\"\u003e\n\u003cdiv class=\"profile-label\"\u003e【姓名】\u003c/div\u003e\n\u003cdiv class=\"profile-value\"\u003e${profileData.userName}\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"profile-item\"\u003e\n\u003cdiv class=\"profile-label\"\u003e【性别】\u003c/div\u003e\n\u003cdiv class=\"profile-value\"\u003e${profileData.gender}\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"profile-item\"\u003e\n\u003cdiv class=\"profile-label\"\u003e【年龄】\u003c/div\u003e\n\u003cdiv class=\"profile-value\"\u003e${profileData.userAge}\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"profile-item\"\u003e\n\u003cdiv class=\"profile-label\"\u003e【外貌特征】\u003c/div\u003e\n\u003cdiv class=\"profile-value\"\u003e${profileData.userAppearance}\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"profile-item\"\u003e\n\u003cdiv class=\"profile-label\"\u003e【性格特点】\u003c/div\u003e\n\u003cdiv class=\"profile-value\"\u003e${profileData.userPersonality}\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"profile-item\"\u003e\n\u003cdiv class=\"profile-label\"\u003e【家庭背景】\u003c/div\u003e\n\u003cdiv class=\"profile-value\"\u003e${profileData.userBackground}\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"profile-item\"\u003e\n\u003cdiv class=\"profile-label\"\u003e【选择的时间线】\u003c/div\u003e\n\u003cdiv class=\"profile-value\"\u003e${profileData.timeline}\u003c/div\u003e\n\u003c/div\u003e\n`;\ndocument.getElementById('profileContent').innerHTML=profileHTML;\ndocument.getElementById('overlay').classList.add('active');\ndocument.getElementById('confirmPanel').classList.add('active');\ndocument.body.style.overflow='hidden';\n});\ndocument.getElementById('editBtn').addEventListener('click',function(){\ndocument.getElementById('overlay').classList.remove('active');\ndocument.getElementById('confirmPanel').classList.remove('active');\ndocument.body.style.overflow='auto';\n});\ndocument.getElementById('copyBtn').addEventListener('click',function(){\nconst profileText=`\n=== 角色档案 ===\n【姓名】${profileData.userName}\n【性别】${profileData.gender}\n【年龄】${profileData.userAge}\n【外貌特征】${profileData.userAppearance}\n【性格特点】${profileData.userPersonality}\n【家庭背景】${profileData.userBackground}\n【选择的时间线】${profileData.timeline}\n==================\n`;\nnavigator.clipboard.writeText(profileText).then(()=\u003e{\nconst successMsg=document.getElementById('copySuccess');\nsuccessMsg.classList.add('show');\nsetTimeout(()=\u003e{\nsuccessMsg.classList.remove('show');\n},3000);\n});\n});\ndocument.getElementById('confirmBtn').addEventListener('click',function(){\nalert('角色创建完成！请将档案信息提供给AI，开始你的青梅竹马纯爱之旅！');\n});\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e","cover":"https://catai.wiki/be607a59-2b82-4374-b26b-f363b6347e00/cover","cover_tiny":"","summary":"与笨蛋傲娇青梅从小到大的日常生活：\n小学时期：对我有极强的占有和保护欲的孩子王；\n初中时期：意识到自己感情的，对你温柔文静的害羞少女；\n高中时期：毒舌傲娇却唯独对我一心一意的怀春少女；\n大学时期：独立成熟的傲娇毒舌却因为患得患失占有欲爆棚的少女；","is_anonymous":false,"memo":"","reward_points":0,"category":0,"total_fish_balls":0,"type":1,"is_public":true,"language":"zh-Hans","age_rating":18,"gender":1,"is_web3_app":false,"review_status":0,"is_available_not_public":true,"average_cost_per_message":1527,"players_count":16814,"conv_count_for_avg_msg_per_conv":0,"like_count":88,"rating_count":78,"avg_rating_score":9.9,"depth_play_user_count":5994,"avg_play_round_count":35,"overall_rank":9471054419,"score":0,"first_published_at":1766222251,"published_at":1766222251,"deleted_at":0,"recommendation_reason":"不同时间线中与傲娇青梅的日常。原创佳作！四条时间线自由切换，细腻刻画青梅从小到大的占有欲。界面华丽、内容丰富，互动感直接拉满！","favorites_count":1788,"comments_count":605,"mod_permission":4,"disable_css_mod":false,"has_special_cg":false},"model_config":{"id":"13bbad4d-3f57-4ae8-9a07-2c002738468d","app_id":"64da8e90-9404-4a55-ae80-fe40c3a28299","provider":"","model_id":"","configs":"","opening_statement":"选择一段开场白","suggested_questions":["开始"],"suggested_questions_after_answer":{"enabled":false},"speech_to_text":{"enabled":false},"text_to_speech":{"enabled":false,"language":"","voice":""},"more_like_this":"","model":{"provider":"aibus_google_vertex","name":"gemini-3-pro-preview","completion_params":{}},"user_input_form":"","dataset_query_variable":"","pre_prompt":"","pre_prompt_sort":0,"agent_mode":{"enabled":false,"max_iteration":5,"strategy":"react","tools":[]},"sensitive_word_avoidance":{"enabled":false},"retriever_resource":{"enabled":false},"prompt_type":"simple","chat_prompt_config":"","completion_prompt_config":"","dataset_configs":{"datasets":{"datasets":[]},"retrieval_model":"single"},"external_data_tools":"","file_upload":{"image":{"detail":"low","enabled":false,"number_