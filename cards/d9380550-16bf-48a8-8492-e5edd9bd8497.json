{"code":100000,"msg":"ok","data":{"apps":{"id":"d9380550-16bf-48a8-8492-e5edd9bd8497","app_model_config_id":"e714f430-8e83-4cfe-a686-3ddbe4bd59ba","created_by_account_id":"00000000-0000-0000-0000-000000000000","name":"🏪24小时便利店：色情店员的无套内射服务💰(NTL/人妻/萝莉/少女/御姐)","mode":"chat","icon":"","icon_background":"","status":"","is_demo":false,"is_universal":false,"description":"\u003cstyle\u003e\n.cvs-app{--bg:#fdf8f2;--card:#ffffff;--line:#ecdfd0;--ink:#3b3530;--ink2:#8a7d70;--main:#d98a4e;--main-d:#c4743a;--blue:#6a9bb5;--pink:#d98aa0;--green:#8fb886;--purple:#a89ac5;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;background:linear-gradient(180deg,#fdf8f2,#faf3ea);color:var(--ink);line-height:1.75;border:1px solid var(--line);border-radius:22px;max-width:920px;margin:0 auto;padding:0;overflow:hidden;font-size:15px;letter-spacing:.2px;box-shadow:0 12px 40px rgba(180,140,90,.1)}\n.cvs-app *{box-sizing:border-box}\n.cvs-app .hd{background:linear-gradient(135deg,#fbe9d2,#f7d9bd 55%,#f3cdac);padding:30px 26px 26px;text-align:center;position:relative;border-bottom:1px solid #f0dcc4;scroll-margin-top:14px}\n.cvs-app .hd .badge{display:inline-block;font-size:12px;letter-spacing:3px;color:#b0794a;background:rgba(255,255,255,.7);border:1px solid #eed3b6;border-radius:999px;padding:3px 14px;margin-bottom:12px;font-weight:700}\n.cvs-app .hd h1{margin:0;font-size:29px;letter-spacing:2px;color:#6b4a2c;font-weight:800}\n.cvs-app .hd p{margin:9px 0 0;font-size:13.5px;color:#9a7a58;letter-spacing:1px}\n.cvs-app .nav{display:flex;flex-wrap:wrap;gap:9px;padding:16px 20px;background:#fffdf9;border-bottom:1px solid var(--line);justify-content:center}\n.cvs-app .nav-btn{font-family:inherit;cursor:pointer;border:1px solid #e9d8c4;background:#fff;color:#856b4e;padding:7px 16px;border-radius:999px;font-size:13.5px;font-weight:600;transition:all .22s ease;box-shadow:0 1px 2px rgba(180,140,90,.07)}\n.cvs-app .nav-btn:hover{transform:translateY(-2px);border-color:var(--main);color:var(--main-d);background:#fff8f0;box-shadow:0 5px 14px rgba(216,138,78,.2)}\n.cvs-app .nav-btn:active{transform:translateY(0)}\n.cvs-app .wrap{padding:22px 20px 30px;display:flex;flex-direction:column;gap:22px}\n.cvs-app .sec{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px 22px 24px;position:relative;box-shadow:0 3px 14px rgba(190,155,110,.07);scroll-margin-top:14px}\n.cvs-app .sec::before{content:\"\";position:absolute;left:0;top:22px;bottom:22px;width:4px;border-radius:0 4px 4px 0;background:var(--accent,var(--main));opacity:.85}\n.cvs-app .sec-title{display:flex;align-items:center;gap:11px;margin:0 0 16px;padding-bottom:13px;border-bottom:2px dashed #efe3d4;font-size:18.5px;font-weight:800;color:#5d4a37;letter-spacing:.5px}\n.cvs-app .sec-title .ico{width:30px;height:30px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-radius:10px;font-size:15px;background:var(--accent,var(--main));color:#fff;box-shadow:0 3px 8px rgba(0,0,0,.12)}\n.cvs-app .sec-title .top-btn{margin-left:auto;font-family:inherit;cursor:pointer;font-size:12px;font-weight:600;color:#a08464;background:#fdf6ee;border:1px solid #eeddc9;border-radius:8px;padding:4px 10px;transition:all .2s}\n.cvs-app .sec-title .top-btn:hover{color:var(--main-d);border-color:var(--main);background:#fff4e8}\n.cvs-app .sec p{margin:0 0 12px;color:#4b4239;font-size:14.5px}\n.cvs-app .sec p:last-child{margin-bottom:0}\n.cvs-app ol.bg-list{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:11px}\n.cvs-app ol.bg-list li{position:relative;padding:12px 14px 12px 46px;background:#fdf9f3;border:1px solid #f0e4d5;border-radius:12px;font-size:14px;color:#4b4239;transition:all .2s}\n.cvs-app ol.bg-list li:hover{border-color:#e9cfa8;background:#fffaf2;transform:translateX(3px)}\n.cvs-app ol.bg-list li .n{position:absolute;left:14px;top:12px;width:22px;height:22px;border-radius:7px;background:linear-gradient(135deg,#e8a35c,#d4813f);color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center}\n.cvs-app ol.bg-list li strong{color:#b5602c;font-weight:700}\n.cvs-app .table-wrap{overflow-x:auto;border-radius:14px;border:1px solid #f0e2d0;margin-top:6px}\n.cvs-app table{border-collapse:collapse;width:100%;min-width:340px;font-size:14px}\n.cvs-app thead th{background:linear-gradient(135deg,#fbead4,#f7ddc2);color:#8a5a2a;font-weight:800;padding:10px 14px;text-align:left;letter-spacing:.5px;white-space:nowrap}\n.cvs-app tbody td{padding:9px 14px;border-top:1px solid #f4e9db;color:#4b4239}\n.cvs-app tbody tr:nth-child(even){background:#fdfaf5}\n.cvs-app tbody tr:hover{background:#fff6ea}\n.cvs-app tbody td:first-child{font-weight:700;color:#c4743a;white-space:nowrap}\n.cvs-app .staff-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}\n.cvs-app .staff{border:1px solid var(--sc,#e9dcc9);border-radius:16px;padding:16px;background:linear-gradient(180deg,#fffdfb,#fdf8f2);position:relative;overflow:hidden;transition:all .25s}\n.cvs-app .staff::after{content:\"\";position:absolute;right:-30px;top:-30px;width:90px;height:90px;border-radius:50%;background:var(--sc,#e9dcc9);opacity:.12}\n.cvs-app .staff:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(190,155,110,.18)}\n.cvs-app .staff-hd{display:flex;align-items:center;gap:11px;margin-bottom:12px;position:relative;z-index:1}\n.cvs-app .avatar{width:44px;height:44px;flex:0 0 auto;border-radius:14px;background:linear-gradient(135deg,var(--sc,#e9dcc9),#fff);border:2px solid var(--sc,#e9dcc9);display:flex;align-items:center;justify-content:center;font-size:19px;font-weight:800;color:#6b5340}\n.cvs-app .staff-hd h4{margin:0;font-size:16.5px;color:#4b3a29;font-weight:800;letter-spacing:.5px}\n.cvs-app .staff-hd .role{font-size:12px;color:#fff;background:var(--sc,#e9dcc9);border-radius:999px;padding:2px 9px;display:inline-block;margin-top:3px;font-weight:600;letter-spacing:.5px}\n.cvs-app .staff dl{margin:0;position:relative;z-index:1}\n.cvs-app .staff dl\u003ediv{display:flex;gap:9px;padding:5px 0;border-top:1px dashed #f1e6d7;font-size:13.5px}\n.cvs-app .staff dl\u003ediv:first-child{border-top:none}\n.cvs-app .staff dt{flex:0 0 62px;color:var(--sc,#c4743a);font-weight:700;text-align:right}\n.cvs-app .staff dd{margin:0;color:#514639;flex:1}\n.cvs-app .staff dd.limit{color:#c05656;font-weight:600}\n.cvs-app .form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\n.cvs-app .field{display:flex;flex-direction:column;gap:6px}\n.cvs-app .field.full{grid-column:1/-1}\n.cvs-app .field label{font-size:13px;font-weight:700;color:#8a6f52;letter-spacing:.5px}\n.cvs-app .field label span{color:#c4743a}\n.cvs-app .field input[type=text],.cvs-app .field textarea{width:100%;font-family:inherit;font-size:14px;padding:9px 12px;border:1px solid #e6d8c8;border-radius:11px;background:#fffdfa;color:#3b3530;transition:all .2s;resize:vertical;line-height:1.65}\n.cvs-app .field input:focus,.cvs-app .field textarea:focus{outline:none;border-color:var(--main);box-shadow:0 0 0 3px rgba(216,138,78,.15);background:#fff}\n.cvs-app .field input::placeholder,.cvs-app .field textarea::placeholder{color:#c4b6a5}\n.cvs-app .sc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\n.cvs-app .sc-card{font-family:inherit;text-align:left;cursor:pointer;border:1.6px solid #ecdcc9;border-radius:13px;background:#fffdfa;padding:13px 15px;transition:all .22s;position:relative}\n.cvs-app .sc-card:hover{border-color:#e0b988;background:#fffaf2;transform:translateY(-2px);box-shadow:0 6px 16px rgba(216,138,78,.13)}\n.cvs-app .sc-card.active{border-color:var(--main);background:linear-gradient(135deg,#fff4e8,#ffece0);box-shadow:0 0 0 3px rgba(216,138,78,.14)}\n.cvs-app .sc-card.active::before{content:\"✓\";position:absolute;right:11px;top:10px;width:20px;height:20px;border-radius:50%;background:var(--main);color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center}\n.cvs-app .sc-card .day{display:inline-block;font-size:12px;font-weight:800;color:#fff;background:linear-gradient(135deg,#e8a35c,#d4813f);border-radius:7px;padding:2px 9px;margin-bottom:7px;letter-spacing:.5px}\n.cvs-app .sc-card .txt{font-size:13.5px;color:#5c5148;line-height:1.6}\n.cvs-app #custom-scenario-box{display:none;margin-top:13px;padding-top:13px;border-top:1px dashed #ecdcc9}\n.cvs-app textarea.output-area{width:100%;min-height:170px;max-height:340px;resize:vertical;font-family:inherit;font-size:14px;line-height:1.85;color:#4b4239;background:#fdfaf5;border:1.6px dashed #e6d0b4;border-radius:14px;padding:16px 18px;white-space:pre-wrap;word-break:break-word;transition:all .2s;overflow:auto;display:block}\n.cvs-app textarea.output-area:focus{outline:none}\n.cvs-app textarea.output-area.filled{border-style:solid;border-color:#dfc19c;background:#fffdf9}\n.cvs-app textarea.output-area::placeholder{color:#c0b19f;font-size:13.5px;line-height:1.75}\n.cvs-app .btn-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:16px;justify-content:center}\n.cvs-app .act-btn{font-family:inherit;cursor:pointer;border:none;border-radius:12px;padding:11px 26px;font-size:14.5px;font-weight:800;letter-spacing:1px;color:#fff;transition:all .22s;position:relative;box-shadow:0 4px 12px rgba(0,0,0,.1)}\n.cvs-app .act-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.16)}\n.cvs-app .act-btn:active{transform:translateY(0);box-shadow:0 3px 8px rgba(0,0,0,.12)}\n.cvs-app .act-btn.confirm{background:linear-gradient(135deg,#e9a35c,#d4813f)}\n.cvs-app .act-btn.copy{background:linear-gradient(135deg,#7fb3cc,#5a8fa8)}\n.cvs-app .act-btn.clear{background:linear-gradient(135deg,#d9909a,#c07a8a)}\n.cvs-app .act-btn.done{background:linear-gradient(135deg,#8fb886,#6da06a)}\n.cvs-app .tip{text-align:center;font-size:12.5px;color:#a89478;margin-top:12px;letter-spacing:.5px}\n@media (max-width:640px){.cvs-app .hd h1{font-size:23px}.cvs-app .staff-grid{grid-template-columns:1fr}.cvs-app .form-grid{grid-template-columns:1fr}.cvs-app .sc-grid{grid-template-columns:1fr}.cvs-app .nav{padding:12px 14px;gap:7px}.cvs-app .nav-btn{padding:6px 12px;font-size:12.5px}.cvs-app .wrap{padding:16px 13px 24px;gap:16px}.cvs-app .sec{padding:17px 15px 19px}.cvs-app .sec-title{font-size:16.5px}.cvs-app .btn-row{gap:9px}.cvs-app .act-btn{padding:10px 18px;font-size:13.5px;flex:1;min-width:100px}}\n\u003c/style\u003e\n\u003cdiv class=\"cvs-app\" id=\"cvs-app\"\u003e\n\u003cheader class=\"hd\" id=\"cvs-top\"\u003e\n\u003cdiv class=\"badge\"\u003eSPECIAL STORE\u003c/div\u003e\n\u003ch1\u003e24小时便利店\u003c/h1\u003e\n\u003cp\u003e竭诚为您服务\u003c/p\u003e\n\u003c/header\u003e\n\u003cnav class=\"nav\"\u003e\n\u003cbutton type=\"button\" class=\"nav-btn\" data-target=\"#sec-bg\"\u003e社会背景\u003c/button\u003e\n\u003cbutton type=\"button\" class=\"nav-btn\" data-target=\"#sec-store\"\u003e便利店介绍\u003c/button\u003e\n\u003cbutton type=\"button\" class=\"nav-btn\" data-target=\"#sec-staff\"\u003e店员介绍\u003c/button\u003e\n\u003cbutton type=\"button\" class=\"nav-btn\" data-target=\"#sec-player\"\u003e玩家面板\u003c/button\u003e\n\u003cbutton type=\"button\" class=\"nav-btn\" data-target=\"#sec-scenario\"\u003e开场情景\u003c/button\u003e\n\u003cbutton type=\"button\" class=\"nav-btn\" data-target=\"#sec-output\"\u003e复制输出\u003c/button\u003e\n\u003c/nav\u003e\n\u003cdiv class=\"wrap\"\u003e\n\u003csection class=\"sec\" id=\"sec-bg\" style=\"--accent:#6a9bb5\"\u003e\n\u003ch2 class=\"sec-title\"\u003e\u003cspan class=\"ico\"\u003e世\u003c/span\u003e一、社会背景\u003cbutton type=\"button\" class=\"top-btn\" data-target=\"#cvs-top\"\u003e↑ 回到顶部\u003c/button\u003e\u003c/h2\u003e\n\u003col class=\"bg-list\"\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e1\u003c/span\u003e\u003cstrong\u003e经济形势：\u003c/strong\u003e近两年全球性经济衰退蔓延至国内，失业率飙升至近十年峰值，大量企业倒闭或大规模裁员。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e2\u003c/span\u003e\u003cstrong\u003e就业困境：\u003c/strong\u003e应届大学生毕业即失业成为普遍现象，中年职员被优化后难以再就业，零工经济盛行但收入微薄。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e3\u003c/span\u003e\u003cstrong\u003e物价压力：\u003c/strong\u003e房租、食品、教育、医疗等基本生活成本持续上涨，普通家庭入不敷出，积蓄快速消耗。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e4\u003c/span\u003e\u003cstrong\u003e道德松动：\u003c/strong\u003e在生存压力下，社会风气逐渐转变，灰色产业暗中滋生，人们对边缘行为的容忍度提高。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e5\u003c/span\u003e\u003cstrong\u003e执法现状：\u003c/strong\u003e相关部门在明面上维持打击姿态，但实际执法力度因经济困境明显减弱，只要不引发公众事件便鲜少干预。\u003c/li\u003e\n\u003c/ol\u003e\n\u003c/section\u003e\n\u003csection class=\"sec\" id=\"sec-store\" style=\"--accent:#d98a4e\"\u003e\n\u003ch2 class=\"sec-title\"\u003e\u003cspan class=\"ico\"\u003e店\u003c/span\u003e二、便利店介绍\u003cbutton type=\"button\" class=\"top-btn\" data-target=\"#cvs-top\"\u003e↑ 回到顶部\u003c/button\u003e\u003c/h2\u003e\n\u003col class=\"bg-list\"\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e1\u003c/span\u003e\u003cstrong\u003e名称与位置：\u003c/strong\u003e店名「24小时便利店」，坐落于城市边缘老旧居民区，周边是密集的出租屋与老小区，人流以底层劳动者和租客为主。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e2\u003c/span\u003e\u003cstrong\u003e店面规模：\u003c/strong\u003e约四十平米，装修陈旧但整洁，货架陈列日常用品、烟酒、零食、饮料和速食品。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e3\u003c/span\u003e\u003cstrong\u003e经营者：\u003c/strong\u003e店长姓张，五十多岁秃顶中年男人，原为普通小店主，因连锁便利店挤压濒临倒闭，后从外地引入特殊经营模式。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e4\u003c/span\u003e\u003cstrong\u003e运营方式：\u003c/strong\u003e表面与普通便利店无异，特殊服务仅面向「懂行」熟客。结账时小票印有消费金额与对应服务代码，当消费金额超过一定数目，店员可以给顾客提供一些特殊服务。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e5\u003c/span\u003e\u003cstrong\u003e私密空间：\u003c/strong\u003e收银台后方原员工休息室被改造为私密隔间，内设简易床垫、湿巾、纸巾等。\u003c/li\u003e\n\u003cli\u003e\u003cspan class=\"n\"\u003e6\u003c/span\u003e\u003cstrong\u003e员工激励：\u003c/strong\u003e每完成一单，店员按比例抽取提成作为小费，因此店员有强烈动机引导顾客提高消费金额，渴望顾客高消费。\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp style=\"margin-top:16px;font-weight:800;color:#b5602c;font-size:14.5px;letter-spacing:.5px\"\u003e▎定价体系（消费金额可累加享受对应服务）\u003c/p\u003e\n\u003cdiv class=\"table-wrap\"\u003e\n\u003ctable\u003e\n\u003cthead\u003e\u003ctr\u003e\u003cth\u003e消费金额\u003c/th\u003e\u003cth\u003e可享服务\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\u003ctd\u003e100元\u003c/td\u003e\u003ctd\u003e隔衣摸胸\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e500元\u003c/td\u003e\u003ctd\u003e亲吻\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e800元\u003c/td\u003e\u003ctd\u003e伸衣摸胸\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e1000元\u003c/td\u003e\u003ctd\u003e摸小穴\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e1500元\u003c/td\u003e\u003ctd\u003e手交\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e2000元\u003c/td\u003e\u003ctd\u003e足交\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e3000元\u003c/td\u003e\u003ctd\u003e口交\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e4000元\u003c/td\u003e\u003ctd\u003e戴套做爱\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e5000元\u003c/td\u003e\u003ctd\u003e无套做爱\u003c/td\u003e\u003c/tr\u003e\n\u003ctr\u003e\u003ctd\u003e10000元\u003c/td\u003e\u003ctd\u003e无限制做爱含肛交\u003c/td\u003e\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003csection class=\"sec\" id=\"sec-staff\" style=\"--accent:#d98aa0\"\u003e\n\u003ch2 class=\"sec-title\"\u003e\u003cspan class=\"ico\"\u003e员\u003c/span\u003e三、店员介绍\u003cbutton type=\"button\" class=\"top-btn\" data-target=\"#cvs-top\"\u003e↑ 回到顶部\u003c/button\u003e\u003c/h2\u003e\n\u003cdiv class=\"staff-grid\"\u003e\n\u003carticle class=\"staff\" style=\"--sc:#e8a35c\"\u003e\n\u003cdiv class=\"staff-hd\"\u003e\u003cspan class=\"avatar\"\u003e李\u003c/span\u003e\u003cdiv\u003e\u003ch4\u003e李佳怡\u003c/h4\u003e\u003cspan class=\"role\"\u003e青春少女\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n\u003cdl\u003e\n\u003cdiv\u003e\u003cdt\u003e年龄\u003c/dt\u003e\u003cdd\u003e20岁\u003c/dd\u003e\u003c/di