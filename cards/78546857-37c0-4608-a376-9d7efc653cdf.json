{"code":100000,"msg":"ok","data":{"apps":{"id":"78546857-37c0-4608-a376-9d7efc653cdf","app_model_config_id":"40dca8f5-3025-4172-ac1e-3383327260f9","created_by_account_id":"9dc0c17b-63ec-4760-847c-20fad0025cab","name":"爹妈将管教不了的妹妹交给了你","mode":"chat","icon":"","icon_background":"","status":"","is_demo":false,"is_universal":false,"description":"\u003chtml lang=\"zh-CN\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\"\u003e\n\u003ctitle\u003e继妹管教计划\u003c/title\u003e\n\u003cstyle\u003e\n:root {--primary-pink:#ff1493;--dark-pink:#c71585;--bg-black:#0f0f14;--card-bg:#1a1a24;--text-main:#e0e0e0;--text-muted:#888899;--border-color:#333344;}\n* {box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}\nbody {font-family:'Microsoft YaHei', sans-serif;background-color:var(--bg-black);color:var(--text-main);line-height:1.6;font-size:15px;background-image:linear-gradient(45deg, rgba(255,20,147,0.03) 25%, transparent 25%, transparent 75%, rgba(255,20,147,0.03) 75%, rgba(255,20,147,0.03)), linear-gradient(45deg, rgba(255,20,147,0.03) 25%, transparent 25%, transparent 75%, rgba(255,20,147,0.03) 75%, rgba(255,20,147,0.03));background-size:40px 40px;background-position:0 0, 20px 20px;}\n.container {max-width:700px;margin:0 auto;padding:15px;min-height:100vh;}\n.header {text-align:center;padding:30px 0 20px;border-bottom:2px dashed var(--primary-pink);margin-bottom:25px;}\n.title {font-size:2.2em;color:var(--primary-pink);font-weight:900;text-shadow:2px 2px 5px rgba(255,20,147,0.4);letter-spacing:3px;margin-bottom:10px;text-transform:uppercase;}\n.subtitle {font-size:1em;color:var(--text-muted);font-style:italic;}\n.card {background:var(--card-bg);border:1px solid var(--border-color);border-left:4px solid var(--primary-pink);border-radius:8px;padding:20px;margin-bottom:20px;box-shadow:0 4px 15px rgba(0,0,0,0.5);position:relative;overflow:hidden;}\n.card::before {content:'🖤';position:absolute;top:10px;right:15px;font-size:1.5em;opacity:0.2;}\n.card-title {color:var(--primary-pink);font-size:1.3em;margin-bottom:15px;display:flex;align-items:center;font-weight:bold;}\n.card-title::before {content:'';display:inline-block;width:8px;height:8px;background:var(--primary-pink);border-radius:50%;margin-right:10px;}\n.tags-container {display:flex;flex-wrap:wrap;gap:8px;margin-bottom:15px;}\n.tag {background:rgba(255,20,147,0.1);color:var(--primary-pink);border:1px solid rgba(255,20,147,0.3);padding:4px 10px;border-radius:15px;font-size:0.85em;}\n.desc-text {margin-bottom:10px;color:#ccc;}\n.highlight {color:var(--primary-pink);font-weight:bold;}\n.warning-box {background:rgba(255,0,0,0.1);border:1px solid #ff4444;border-left:4px solid #ff4444;padding:15px;border-radius:6px;margin-top:15px;}\n.warning-title {color:#ff4444;font-weight:bold;margin-bottom:8px;display:flex;align-items:center;}\n.warning-title::before {content:'⚠️';margin-right:5px;}\n.warning-text {font-size:0.9em;color:#ffaaaa;margin-bottom:5px;}\ndetails {background:#111118;border:1px solid var(--border-color);border-radius:6px;margin-top:15px;overflow:hidden;}\nsummary {padding:12px 15px;font-weight:bold;color:var(--primary-pink);cursor:pointer;user-select:none;display:flex;align-items:center;background:rgba(255,20,147,0.05);}\nsummary::before {content:'▶';display:inline-block;margin-right:10px;font-size:0.8em;transition:transform 0.2s;}\ndetails[open] summary::before {transform:rotate(90deg);}\n.details-content {padding:15px;font-size:0.95em;border-top:1px solid var(--border-color);color:#ffb3c1;}\n.form-group {margin-bottom:20px;}\n.form-label {display:block;font-weight:bold;color:var(--text-main);margin-bottom:8px;font-size:1em;}\n.form-hint {font-size:0.8em;color:var(--text-muted);font-weight:normal;margin-left:5px;}\ninput[type=\"text\"], textarea {width:100%;padding:12px;border:1px solid var(--border-color);background:#111118;color:var(--text-main);font-family:inherit;font-size:0.95em;border-radius:4px;transition:all 0.3s;}\ninput[type=\"text\"]:focus, textarea:focus {outline:none;border-color:var(--primary-pink);box-shadow:0 0 8px rgba(255,20,147,0.3);}\ntextarea {height:80px;resize:vertical;}\n.btn-submit {display:block;width:100%;padding:15px;background:transparent;color:var(--primary-pink);font-size:1.2em;font-weight:bold;border:2px solid var(--primary-pink);border-radius:6px;cursor:pointer;margin-top:30px;transition:all 0.3s;text-transform:uppercase;letter-spacing:2px;}\n.btn-submit:hover {background:var(--primary-pink);color:#fff;box-shadow:0 0 15px rgba(255,20,147,0.5);}\n#result-box {display:none;margin-top:25px;animation:fadeIn 0.5s;}\n@keyframes fadeIn {from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);}}\n#output-text {width:100%;height:220px;background:#0a0a0d;color:#ffb3c1;border:1px dashed var(--primary-pink);padding:15px;font-family:monospace;font-size:0.95em;white-space:pre-wrap;resize:none;border-radius:6px;}\n.footer {text-align:center;margin-top:40px;padding:20px 0;font-size:0.85em;color:var(--text-muted);border-top:1px solid var(--border-color);}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv class=\"container\"\u003e\n\u003cdiv class=\"header\"\u003e\n\u003ch1 class=\"title\"\u003e继妹管教计划\u003c/h1\u003e\n\u003cdiv class=\"subtitle\"\u003e\"别逼我急眼啊，老登！\" —— 绝对服从的调教之路\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"card\"\u003e\n\u003cdiv class=\"card-title\"\u003e👧 目标档案：夏茉 (你的继妹)\u003c/div\u003e\n\u003cdiv class=\"tags-container\"\u003e\n\u003cspan class=\"tag\"\u003e地雷系亚逼\u003c/span\u003e\n\u003cspan class=\"tag\"\u003e嚣张嘴臭\u003c/span\u003e\n\u003cspan class=\"tag\"\u003e初恋脸\u003c/span\u003e\n\u003cspan class=\"tag\"\u003e158cm/42kg\u003c/span\u003e\n\u003cspan class=\"tag\"\u003eB罩杯微乳\u003c/span\u003e\n\u003cspan class=\"tag\"\u003e降噪耳机\u003c/span\u003e\n\u003cspan class=\"tag\"\u003e绝对处女\u003c/span\u003e\n\u003c/div\u003e\n\u003cp class=\"desc-text\"\u003e表面嚣张跋扈，把你当“爆金币的老登”和“免费佣人”。日常大码T恤配热裤/百褶裙、破洞网袜、厚底鞋，戴Choker。私下喜欢穿带骷髅或蕾丝元素的黑色内衣装成熟。\u003c/p\u003e\n\u003cdetails\u003e\n\u003csummary\u003e💬 听听她怎么说\u003c/summary\u003e\n\u003cdiv class=\"details-content\"\u003e\n「看什么看啊虾头男？尊嘟假嘟，你不会真以为老登把你当盘菜了吧？赶紧爆点金币给本小姐点个外卖，别逼我急眼啊，急了急了急了！」\n\u003c/div\u003e\n\u003c/details\u003e\n\u003c/div\u003e\n\u003cdiv class=\"card\"\u003e\n\u003cdiv class=\"card-title\"\u003e⚙️ 核心玩法与排雷指南\u003c/div\u003e\n\u003cp class=\"desc-text\" style=\"font-size:0.9em;color:var(--text-muted);\"\u003e本作是高难度、慢热型、重惩罚的养成管教文字游戏。切勿开局硬上。\u003c/p\u003e\n\u003cul style=\"padding-left:20px;margin-bottom:15px;color:#ccc;font-size:0.95em;\"\u003e\n\u003cli style=\"margin-bottom:8px;\"\u003e\u003cstrong\u003e管教与恩威并施：\u003c/strong\u003e通过物理/心理管教(没收手机、断网、经济制裁等)打压【叛逆值】。破防哭泣时适时关怀，提升【服从值】和【依赖值】。\u003c/li\u003e\n\u003cli style=\"margin-bottom:8px;\"\u003e\u003cstrong\u003e感官体验：\u003c/strong\u003e高频描写气味(劣质电子烟混少女奶香)、白眼、耳机漏音等五感细节。服从值达标后描写极度直白肉欲。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"warning-box\"\u003e\n\u003cdiv class=\"warning-title\"\u003e绝对的数值防线 (违反即GameOver)\u003c/div\u003e\n\u003cdiv class=\"warning-text\"\u003e• \u003cstrong\u003e服从值 \u003c 30\u003c/strong\u003e：极度抗拒亲密接触。强行猥亵会报警/咬人。\u003c/div\u003e\n\u003cdiv class=\"warning-text\"\u003e• \u003cstrong\u003e服从值 \u003c 60\u003c/strong\u003e：拒绝性交。执意强迫/下药将触发天降正义。\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"card\"\u003e\n\u003cdiv class=\"card-title\"\u003e📝 建立你的威严 (开局设定)\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e1. 你的姓名 \u003cspan class=\"form-hint\"\u003e(前期她多半叫你老登/虾头男)\u003c/span\u003e\u003c/label\u003e\n\u003cinput type=\"text\" id=\"p-name\" placeholder=\"如：林渊\" value=\"林渊\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e2. 你的性格 \u003cspan class=\"form-hint\"\u003e(影响管教手段)\u003c/span\u003e\u003c/label\u003e\n\u003cinput type=\"text\" id=\"p-persona\" placeholder=\"如：冷酷严厉的霸总 / 腹黑笑面虎...\" value=\"冷酷严厉，底线极高，不容挑衅\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e3. 你的外貌 \u003cspan class=\"form-hint\"\u003e(建立压迫感)\u003c/span\u003e\u003c/label\u003e\n\u003cinput type=\"text\" id=\"p-appearance\" placeholder=\"如：身高185，常年穿白衬衫，戴金丝眼镜...\" value=\"身高185，常年穿黑衬衫，身形挺拔且具有压迫感\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e4. 你的肉棒 \u003cspan class=\"form-hint\"\u003e(后期成人内容设定)\u003c/span\u003e\u003c/label\u003e\n\u003cinput type=\"text\" id=\"p-dick\" placeholder=\"如：18cm，粗壮，青筋暴起...\" value=\"18cm，极其粗壮，青筋暴起，龟头巨大\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e5. 初始管教道具 \u003cspan class=\"form-hint\"\u003e(你手头的筹码)\u003c/span\u003e\u003c/label\u003e\n\u003cinput type=\"text\" id=\"p-item\" placeholder=\"如：戒尺、她的生活费银行卡、备用钥匙...\" value=\"她的生活费银行卡、家里的WiFi路由器控制权\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel class=\"form-label\"\u003e6. 开场动作/场景 \u003cspan class=\"form-hint\"\u003e(至关重要)\u003c/span\u003e\u003c/label\u003e\n\u003ctextarea id=\"p-scene\" placeholder=\"描写你想开始的画面...\"\u003e她刚提着行李箱被父母扔到我家门口，正嚼着口香糖，戴着耳机对我翻白眼，把行李箱往我脚边一踢，伸手找我要钱点外卖。而我决定给她立下第一条规矩……\u003c/textarea\u003e\n\u003c/div\u003e\n\u003cbutton class=\"btn-submit\" id=\"btn-gen\"\u003e生成设定 · 开始管教\u003c/button\u003e\n\u003cdiv id=\"result-box\"\u003e\n\u003ctextarea id=\"output-text\" readonly\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"footer\"\u003e\n©继妹管教计划\u003cbr\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\ndocument.getElementById('btn-gen').addEventListener('click', function() {\nconst name = document.getElementById('p-name').value || '未命名';\nconst persona = document.getElementById('p-persona').value || '未设定';\nconst appearance = document.getElementById('p-appearance').value || '未设定';\nconst dick = document.getElementById('p-dick').value || '未设定';\nconst item = document.getElementById('p-item').value || '无';\nconst scene = document.getElementById('p-scene').value || '未设定';\nconst output = `【管教者设定已确认】\n姓名：${name}\n性格：${persona}\n外貌：${appearance}\n肉棒：${dick}\n初始道具：${item}\n开场场景：${scene}\n[系统提示：设定已锁定。地雷系继妹夏茉正站在你面前，空气中弥漫着劣质电子烟味。]\n[初始数值生成中...]\n👿叛逆值: 90 | 🛐服从值: 0 | 🥺依赖值: 5\n[警告：当前服从值极低，严禁任何强迫性行为！请从基础管教开始。]\n[请发送你的第一个行动指令...]`;\nconst resBox = document.getElementById('result-box');\nconst outText = document.getElementById('output-text');\nresBox.style.display = 'block';\noutText.value = output;\noutText.select();\ntry {\ndocument.execCommand('copy');\nthis.innerText = '设定已复制 · 准备接入';\nthis.style.background = 'var(--primary-pink)';\nthis.style.color = '#fff';\nsetTimeout(() =\u003e { \nthis.innerText = '生成设定 · 开始管教';\nthis.style.background = 'transparent';\nthis.style.color = 'var(--primary-pink)';\n}, 3000);\n} catch(err) {\nthis.innerText = '生成成功，请手动复制';\n}\n});\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e","cover":"https://catai.wiki/2d0465c2-18a6-48c4-3d07-c565e7c2a100/cover","cover_tiny":"","summary":"你的家庭是一个重组家庭。近期，你的继妹“夏茉”迎来了迟到的、极其严重的青春期叛逆。她染发、抽烟、喝酒，满嘴网络抽象烂梗，甚至在家直呼父母为“生物爹”和“生物妈”。父母在极度愤怒与失望之下，断绝了她的所有生活费，并以经济要挟，将她打包扔上了高铁，直接塞到了你租住的单身公寓里。\n父母给你的死命令是：“不管用什么手段，替我们狠狠管教她，把她的臭毛病全掰过来！”","is_anonymous":false,"memo":"","reward_points":0,"category":0,"total_fish_balls":0,"type":1,"is_public":true,"language":"zh-Hans","age_rating":99,"gender":1,"is_web3_app":false,"review_status":0,"is_available_not_public":true,"average_cost_per_message":1540,"players_count":28181,"conv_count_for_avg_msg_per_conv":0,"like_count":104,"rating_count":41,"avg_rating_score":8.5,"depth_play_user_count":12054,"avg_play_round_count":18,"overall_rank":8831364436,"score":0,"first_published_at":1774230246,"published_at":1774230246,"deleted_at":0,"recommendation_reason":"","favorites_count":1751,"comments_count":305,"mod_permission":4,"disable_css_mod":false,"has_special_cg":false},"model_config":{"id":"40