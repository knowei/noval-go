76, 60, 0.5); margin-bottom: 30px; overflow: auto; }\nh1 { color: var(--primary-color); text-align: center; font-size: 2.5em; margin-bottom: 10px; text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.8); letter-spacing: 2px; }\nh2 { color: var(--text-dark); text-align: center; font-size: 1.1em; margin-bottom: 25px; font-weight: 400; }\nh3 { color: var(--secondary-color); font-size: 1.4em; margin: 25px 0 15px 0; text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7); padding-bottom: 5px; border-bottom: 1px solid rgba(241, 196, 15, 0.3); }\nh4 { color: var(--info-border); font-size: 1.2em; margin-top: 20px; margin-bottom: 10px; }\np { color: var(--text-light); margin-bottom: 10px; line-height: 1.7; font-size: 1em; }\n.collapsible-section { background: rgba(52, 73, 94, 0.75); border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 15px; overflow: hidden; transition: all 0.3s ease-in-out; }\n.collapsible-header { display: block; padding: 14px 20px; background: rgba(231, 76, 60, 0.85); color: #ffffff; font-weight: bold; font-size: 1.1em; cursor: pointer; user-select: none; transition: background 0.3s ease; position: relative; }\n.collapsible-header:hover { background: var(--primary-hover); }\n.collapsible-header::after { content: '▼'; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); transition: transform 0.3s; font-size: 0.9em; }\ndetails[open] \u003e .collapsible-header::after { transform: translateY(-50%) rotate(180deg); }\n.collapsible-content { padding: 20px; background: rgba(44, 62, 80, 0.95); border-top: 1px solid rgba(231, 76, 60, 0.4); }\n.checkbox-group { display: flex; flex-wrap: wrap; gap: 10px 15px; }\n.checkbox-group label { display: flex; align-items: center; color: var(--text-light); font-size: 1em; cursor: pointer; padding: 5px 10px; border-radius: 5px; background: rgba(255, 255, 255, 0.05); transition: background 0.3s; }\n.checkbox-group label:hover { background: rgba(255, 255, 255, 0.1); }\n.checkbox-group input[type=\"checkbox\"] { margin-right: 8px; width: 18px; height: 18px; accent-color: var(--primary-color); }\n.form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }\n.form-group { display: flex; flex-direction: column; }\n.form-group.full-width { grid-column: 1 / -1; }\n.form-group label { color: var(--secondary-color); margin-bottom: 8px; font-weight: bold; font-size: 1em; }\n.form-group input, .form-group select, .form-group textarea { background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 6px; padding: 10px; color: var(--text-light); font-size: 1em; transition: border-color 0.3s, background 0.3s; }\n.form-group select { color: var(--text-light); background-color: rgba(0, 0, 0, 0.2); }\n.form-group select option { background-color: var(--bg-dark); color: var(--text-light); }\n.form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--primary-color); background: rgba(0, 0, 0, 0.3); box-shadow: 0 0 8px rgba(231, 76, 60, 0.5); }\ntextarea { resize: vertical; min-height: 60px; }\n.button-group { display: flex; gap: 15px; justify-content: center; margin-top: 25px; flex-wrap: wrap; }\n.action-btn { color: #ffffff; border: none; border-radius: 8px; padding: 12px 30px; font-size: 1.1em; font-weight: bold; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.3); text-transform: uppercase; letter-spacing: 1px; flex-grow: 1; min-width: 150px; }\n.generate-btn { background: var(--primary-color); }\n.generate-btn:hover { background: var(--primary-hover); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(231, 76, 60, 0.5); }\n.reset-btn { background: var(--info-border); }\n.reset-btn:hover { background: #3aa9e3; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4); }\n#previewModal, #modInstructionModal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1001; backdrop-filter: blur(5px); align-items: center; justify-content: center; }\n#modInstructionModal { z-index: 1002; }\n.modal-content { position: relative; background: rgba(44, 62, 80, 0.98); padding: 30px; border-radius: 15px; border: 2px solid var(--success-color); width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; box-shadow: 0 0 30px rgba(46, 204, 113, 0.5); }\n.modal-content h3 { color: var(--success-color); border-bottom: 2px solid rgba(46, 204, 113, 0.4); padding-bottom: 1rem; margin-top: 0; margin-bottom: 20px; text-align: center; font-size: 1.5em; }\n#previewContent { color: var(--text-light); line-height: 1.7; font-size: 1em; white-space: pre-wrap; word-break: break-all; }\n.preview-buttons { margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }\n.preview-buttons button { border: none; padding: 0.8rem 1.8rem; cursor: pointer; border-radius: 6px; transition: all 0.3s; font-weight: bold; font-size: 1em; }\n.confirm-btn { background: var(--success-color); color: var(--bg-dark); }\n.confirm-btn:hover { background: var(--success-hover); transform: translateY(-2px); box-shadow: 0 4px 10px rgba(46, 204, 113, 0.4); }\n.return-btn { background: rgba(255, 255, 255, 0.1); color: var(--text-light); border: 1px solid var(--text-dark); }\n.return-btn:hover { background: rgba(255, 255, 255, 0.2); color: #ffffff; }\n.quick-nav { position: fixed; top: 50%; right: 15px; transform: translateY(-50%); background: rgba(44, 62, 80, 0.8); backdrop-filter: blur(5px); border-radius: 10px; padding: 10px; z-index: 1000; display: flex; flex-direction: column; gap: 12px; border: 1px solid var(--border-color); box-shadow: 0 0 15px rgba(0,0,0,0.5); }\n.quick-nav.hidden { display: none; }\n.quick-nav a { color: var(--text-light); text-decoration: none; font-size: 1.5em; text-align: center; transition: color 0.3s, transform 0.3s; padding: 5px; position: relative; }\n.quick-nav a:hover { color: var(--primary-color); transform: scale(1.2); }\n.quick-nav a .tooltip { visibility: hidden; width: 120px; background-color: var(--bg-dark); color: #fff; text-align: center; border-radius: 6px; padding: 5px 0; position: absolute; z-index: 1; top: 50%; right: 120%; transform: translateY(-50%); opacity: 0; transition: opacity 0.3s; font-size: 0.6em; }\n.quick-nav a:hover .tooltip { visibility: visible; opacity: 1; }\n.close-nav { position: absolute; top: -15px; right: -15px; background: var(--primary-color); color: white; border: none; border-radius: 50%; width: 30px; height: 30px; font-size: 1.2em; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 10px rgba(0,0,0,0.5); }\n.reminder-box { background: var(--info-bg); border-left: 4px solid var(--info-border); padding: 15px; margin-top: 20px; border-radius: 0 8px 8px 0; }\n.update-notice-box { background: var(--warning-bg); border-left: 4px solid var(--warning-border); padding: 15px; margin: 20px 0; border-radius: 0 8px 8px 0; }\n.update-notice-box h4 { color: var(--warning-border); margin-top:0; }\n.update-notice-box p { margin-bottom: 8px; color: var(--text-light); font-size: 0.95em; }\n.reminder-box p { margin-bottom: 8px; color: var(--text-light); font-size: 0.95em; }\n.reminder-box code, .update-notice-box code { background: rgba(0, 0, 0, 0.3); padding: 2px 6px; border-radius: 4px; font-family: 'Courier New', Courier, monospace; color: var(--secondary-color); }\n.reminder-box pre { background: rgba(0, 0, 0, 0.4); padding: 10px; border-radius: 5px; white-space: pre-wrap; word-break: break-all; margin-top: 5px; }\n#toast-container { position: fixed; top: 20px; right: 20px; z-index: 2000; display: flex; flex-direction: column; gap: 10px; }\n.toast { background-color: var(--success-color); color: var(--bg-dark); padding: 15px 20px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); transform: translateX(120%); opacity: 0; transition: transform 0.5s ease, opacity 0.5s ease; font-weight: bold; }\n.toast.show { transform: translateX(0); opacity: 1; }\nfooter { text-align: center; margin-top: 30px; font-size: 0.9em; }\nfooter a { color: var(--text-dark); text-decoration: none; transition: color 0.3s; }\nfooter a:hover { color: var(--primary-color); }\n@media (max-width: 1024px) { .quick-nav { right: 5px; } }\n@media (max-width: 768px) {body { padding: 10px 5px; font-size: 14px; }.container { height: calc(100vh - 20px); padding-right: 5px; }.main-panel { padding: 20px; }h1 { font-size: 2em; }.form-row { grid-template-columns: 1fr; }.quick-nav { display: none; }.modal-content { width: 95%; max-height: 85vh; padding: 20px; }}\n@media (max-width: 400px) {body { padding: 5px 0; }.container { height: calc(100vh - 10px); padding: 0 5px; }.main-panel { padding: 15px; border-radius: 10px; border: 1px solid var(--primary-color); }h1 { font-size: 1.8em; }.collapsible-header { padding: 12px 15px; font-size: 1em; }.collapsible-content { padding: 15px; }.action-btn, .preview-buttons button { width: 100%; padding: 12px; }.modal-content { width: 98%; padding: 15px; border-radius: 10px; }#toast-container { right: 10px; top: 10px; width: calc(100% - 20px); }}\u003c/style\u003e\u003c/head\u003e\u003cbody\u003e\u003cdiv id=\"toast-container\"\u003e\u003c/div\u003e\u003cdiv class=\"quick-nav\" id=\"quickNav\"\u003e\u003cbutton class=\"close-nav\" id=\"closeNavBtn\"\u003e\u0026times;\u003c/button\u003e\u003ca href=\"#style-section\"\u003e🎨\u003cspan class=\"tooltip\"\u003e风格与视角\u003c/span\u003e\u003c/a\u003e\u003ca href=\"#world-section\"\u003e🌍\u003cspan class=\"tooltip\"\u003e世界观设定\u003c/span\u003e\u003c/a\u003e\u003ca href=\"#protagonist-section\"\u003e👤\u003cspan class=\"tooltip\"\u003e主角信息\u003c/span\u003e\u003c/a\u003e\u003ca href=\"#creation-section\"\u003e💡\u003cspan class=\"tooltip\"\u003e创作需求\u003c/span\u003e\u003c/a\u003e\u003ca href=\"#character-section\"\u003e👥\u003cspan class=\"tooltip\"\u003e定制角色\u003c/span\u003e\u003c/a\u003e\u003ca href=\"#mod-section\"\u003e🛠️\u003cspan class=\"tooltip\"\u003eMOD制作\u003c/span\u003e\u003c/a\u003e\u003c/div\u003e\u003cdiv class=\"container\" id=\"mainContainer\"\u003e\u003cdiv class=\"main-panel\"\u003e\u003ch1\u003e写文助手 V3\u003c/h1\u003e\u003ch2\u003e您的专属幻想工程师，生成无限可能的故事\u003c/h2\u003e\u003cform id=\"story-form\"\u003e\u003cdetails id=\"style-section\" class=\"collapsible-section\" open\u003e\u003csummary class=\"collapsible-header\"\u003e创作风格与视角选择\u003c/summary\u003e\u003cdiv class=\"collapsible-content\"\u003e\u003ch3\u003e创作性向 (可多选)\u003c/h3\u003e\u003cdiv class=\"checkbox-group\"\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"orientation-style\" value=\"男性向风格\"\u003e 男性向\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"orientation-style\" value=\"女性向风格\"\u003e 女性向\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"orientation-style\" value=\"BL风格\"\u003e BL\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"orientation-style\" value=\"GL风格\"\u003e GL\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"orientation-style\" value=\"1风格\"\u003e 1\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"orientation-style\" value=\"1风格\"\u003e 1\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"orientation-style\" value=\"2\"\u003e 2\u003c/label\u003e\u003c/div\u003e\u003ch3\u003e叙事视角\u003c/h3\u003e\u003cdiv class=\"checkbox-group\"\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" id=\"povFirst\"\u003e 第一人称\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" id=\"povSecond\"\u003e 第二人称\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" id=\"povThird\"\u003e 第三人称\u003c/label\u003e\u003c/div\u003e\u003ch3\u003e小说文风 (可多选)\u003c/h3\u003e\u003cdiv class=\"checkbox-group\"\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"现代言情情文风\"\u003e 现代言情\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"古代言情文风\"\u003e 古代言情\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"都市文风\"\u003e 都市文风\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"青春校园文风\"\u003e 青春校园\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"温馨日常文风\"\u003e 温馨日常\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"日式轻小说文风\"\u003e 日式轻小说\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"西幻小说文风\"\u003e 西幻史诗\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"玄幻小说文风\"\u003e 东方玄幻\u003c/label\u003e\u003clabel\u003e\u003cinput type=\"checkbox\" class=\"writing-style\" value=\"修仙小说文风\"\u003e 缥缈修仙\u003c/label\u003e\u003c/div\u003e\u003cdiv class=\"update-notice-box\"\u003e\u003ch4\u003e⚠️ 本次更新内容\u003c/h4\u003e\u003cp\u003e1、本次更新为重大更新，对作品结构进行了大幅度的调整，将许多功能以mod的形式进行了拆分，从而更个性化的为大家提供自由的定制服务，且彻底杜绝本不需要的功能可能被触发从而导致消耗增加的情况。请立即根据需求前往mod区选用对应mod以确保功能完整。\u003c/p\u003e\u003cp\u003e2、新增了mod系统，优化了AI读取，能够更好的调动MOD、世界书，基于此功能，今后将会持续制作各种各样的MOD供大家选用，创作出更好的作品，但更新时间待定。\u003c/p\u003e\u003cp\u003e3、新增了MOD制作工坊，在本页的底部，输入对应内容后即可预览、复制，放到自定义配置的提示词中，保存即可载入该MOD，推荐大家制作角色设定信息MOD、已发生的重要剧情MOD等，维持角色和剧情不崩。\u003c/p\u003e\u003c/div\u003e\u003ch4\u003e温馨提示\u003c/h4\u003e\u003cdiv class=\"reminder-box\"\u003e\u003cp\u003e1️⃣ \u003cstrong\u003e记忆推荐：\u003c/strong\u003e4记忆即可，记忆越高AI要处理的信息越多，消耗也越高，并非越高越好\u003c/p\u003e\u003cp\u003e2️⃣ \u003cstrong\u003e模型推荐：\u003c/strong\u003e\u003cbr\u003e① \u003ccode\u003eaibus vertex gemini 2.5pro\u003c/code\u003e\u003cbr\u003e② \u003ccode\u003eaibus vertex gemini 3.0pro\u003c/code\u003e\u003cbr\u003e③ \u003ccode\u003eyuegle anthropic anti Claude opus 4-5-20251101-thinking，价格系数0.12，这个的表现不错，用腻了哈基米的可以试试这个，不过克劳德的破甲不如哈基米稳定，大家灵活运用叭 ④  若以上渠道均截断，请切换grok模型跑一两轮后切回\u003c/p\u003e\u003cp\u003e3️⃣ \u003cstrong\u003e使用技巧：\u003c/strong\u003e本作品为AI辅助创作工具，重要的世界设定、角色设定、剧情节点，请使用MOD工坊制作并放入右上角－自定义配置－提示词中保存并及时更新;格式为：\u003cbr\u003e\u0026lt;世界设定\u0026gt;\u003cbr\u003e这里放世界设定\u003cbr\u003e\u0026lt;/世界设定\u0026gt;\u003cbr\u003e\n\u0026lt;已保存的角色信息\u0026gt;\u003cbr\u003e这里放需要保存记录的角色信息\u003cbr\u003e\u0026lt;/已保存的角色信息\u0026gt;\u003cbr\u003e\n\u0026lt;已保存的重要剧情节点\u0026gt;\u003cbr\u003e这里放需要保存的剧情节点\u003cbr\u003e\u0026lt;/已保存的重要剧情节点\u0026gt;\u003cbr\u003e\n\u003c/p\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/p\u003e\u003cp\u003e4️⃣ \u003cstrong\u003e撞甲、截断：\u003c/strong\u003e优先推荐流式，开局尽量先别涩涩，做点铺垫体验更好更不容易撞甲，常规内容截断为风月、渠道不稳定，正常截断也是，此时可以切换非流式，敏感内容必须流式，截断可以切上面推荐克劳德模型，或者切grok、ds模型过渡一两轮内容再切回来，半夜美国上班模型厚，截断率激增，请耐心、多包涵，有问题可以评论区反馈，感谢大家的游玩，爱你们\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails id=\"world-section\" class=\"collapsible-section\"\u003e\u003csummary class=\"collapsible-header\"\u003e世界观设定\u003c/summary\u003e\u003cdiv class=\"collapsible-content\"\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"worldInfo\"\u003e世界信息\u003c/label\u003e\u003ctextarea id=\"worldInfo\" rows=\"4\" placeholder=\"描述故事发生的世界背景，例如：这是一个魔法与科技并存的赛博朋克都市；一个遵循残酷丛林法则的末日废土；或者一个等级森严、神权至上的奇幻王国...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails id=\"protagonist-section\" class=\"collapsible-section\" open\u003e\u003csummary class=\"collapsible-header\"\u003e主角信息\u003c/summary\u003e\u003cdiv class=\"collapsible-content form-row\"\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"protagonistName\"\u003e姓名\u003c/label\u003e\u003cinput type=\"text\" id=\"protagonistName\" placeholder=\"例如：龙傲天 / 苏玛丽\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"protagonistGender\"\u003e性别\u003c/label\u003e\u003cselect id=\"protagonistGender\"\u003e\u003coption value=\"男\"\u003e男\u003c/option\u003e\u003coption value=\"女\"\u003e女\u003c/option\u003e\u003coption value=\"双性\"\u003e双性\u003c/option\u003e\u003coption value=\"扶他\"\u003e扶他\u003c/option\u003e\u003coption value=\"其他\"\u003e其他\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"protagonistAge\"\u003e年龄\u003c/label\u003e\u003cinput type=\"number\" id=\"protagonistAge\" min=\"1\" max=\"999\" value=\"20\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"protagonistAppearance\"\u003e身材外貌\u003c/label\u003e\u003ctextarea id=\"protagonistAppearance\" rows=\"2\" placeholder=\"例如：身高188cm，宽肩窄腰，八块腹肌人鱼线，黑发黑眸，眼神深邃如渊...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"protagonistPersona\"\u003e详细人设\u003c/label\u003e\u003ctextarea id=\"protagonistPersona\" rows=\"3\" placeholder=\"例如：职业：退役兵王/吸血鬼后裔；穿着：万年不变的黑背心和工装裤；性格：外冷内热，杀伐果断，对认可的人极其护短...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"protagonistPower\"\u003e主角外挂/金手指\u003c/label\u003e\u003ctextarea id=\"protagonistPower\" rows=\"3\" placeholder=\"例如：能看到好感度的系统、可以无限复活、拥有吞噬他人能力的体质、一块能穿越时空的神秘玉佩...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails id=\"creation-section\" class=\"collapsible-section\"\u003e\u003csummary class=\"collapsible-header\"\u003e创作需求\u003c/summary\u003e\u003cdiv class=\"collapsible-content form-row\"\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"scene\"\u003e创作场景\u003c/label\u003e\u003ctextarea id=\"scene\" rows=\"2\" placeholder=\"例如：豪华游轮的私人套房、废弃古堡的地下室、充满异域风情的沙漠帐篷...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"event\"\u003e创作事件\u003c/label\u003e\u003ctextarea id=\"event\" rows=\"2\" placeholder=\"例如：一场意外的邂逅、被困密室、复仇计划的实施、一次身体检查...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"specialRequirements\"\u003e特殊需求/XP\u003c/label\u003e\u003ctextarea id=\"specialRequirements\" rows=\"3\" placeholder=\"例如：道具使用、角色扮演、身体改造、变身、怪物...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails id=\"character-section\" class=\"collapsible-section\"\u003e\u003csummary class=\"collapsible-header\"\u003e定制角色 (最多3位)\u003c/summary\u003e\u003cdiv class=\"collapsible-content\"\u003e\u003cdetails class=\"collapsible-section\"\u003e\u003csummary class=\"collapsible-header\"\u003e定制角色1信息\u003c/summary\u003e\u003cdiv class=\"collapsible-content form-row\"\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char1Name\"\u003e姓名\u003c/label\u003e\u003cinput type=\"text\" id=\"char1Name\" placeholder=\"例如：赵灵儿\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"char1Gender\"\u003e性别\u003c/label\u003e\u003cselect id=\"char1Gender\"\u003e\u003coption value=\"\"\u003e无\u003c/option\u003e\u003coption value=\"男\"\u003e男\u003c/option\u003e\u003coption value=\"女\"\u003e女\u003c/option\u003e\u003coption value=\"双性\"\u003e双性\u003c/option\u003e\u003coption value=\"其他\"\u003e其他\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"char1Age\"\u003e年龄\u003c/label\u003e\u003cinput type=\"number\" id=\"char1Age\" min=\"0\" max=\"999\" placeholder=\"无\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char1Appearance\"\u003e身材外貌\u003c/label\u003e\u003ctextarea id=\"char1Appearance\" rows=\"2\" placeholder=\"例如：身高160cm，娇小可爱，黑长直，大眼睛，皮肤白皙...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char1Persona\"\u003e详细人设\u003c/label\u003e\u003ctextarea id=\"char1Persona\" rows=\"3\" placeholder=\"例如：职业：清纯女大学生；穿着：常穿白裙，校服；性格：温柔善良，容易害羞...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails class=\"collapsible-section\"\u003e\u003csummary class=\"collapsible-header\"\u003e定制角色2信息\u003c/summary\u003e\u003cdiv class=\"collapsible-content form-row\"\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char2Name\"\u003e姓名\u003c/label\u003e\u003cinput type=\"text\" id=\"char2Name\" placeholder=\"例如：林月如\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"char2Gender\"\u003e性别\u003c/label\u003e\u003cselect id=\"char2Gender\"\u003e\u003coption value=\"\"\u003e无\u003c/option\u003e\u003coption value=\"男\"\u003e男\u003c/option\u003e\u003coption value=\"女\"\u003e女\u003c/option\u003e\u003coption value=\"双性\"\u003e双性\u003c/option\u003e\u003coption value=\"其他\"\u003e其他\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"char2Age\"\u003e年龄\u003c/label\u003e\u003cinput type=\"number\" id=\"char2Age\" min=\"0\" max=\"999\" placeholder=\"无\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char2Appearance\"\u003e身材外貌\u003c/label\u003e\u003ctextarea id=\"char2Appearance\" rows=\"2\" placeholder=\"例如：身高170cm，身材火辣，C杯蜜桃臀，金色波浪卷...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char2Persona\"\u003e详细人设\u003c/label\u003e\u003ctextarea id=\"char2Persona\" rows=\"3\" placeholder=\"例如：职业：夜店舞女；穿着：暴露舞衣；性格：风情万种...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails class=\"collapsible-section\"\u003e\u003csummary class=\"collapsible-header\"\u003e定制角色3信息\u003c/summary\u003e\u003cdiv class=\"collapsible-content form-row\"\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char3Name\"\u003e姓名\u003c/label\u003e\u003cinput type=\"text\" id=\"char3Name\" placeholder=\"例如：阿奴\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"char3Gender\"\u003e性别\u003c/label\u003e\u003cselect id=\"char3Gender\"\u003e\u003coption value=\"\"\u003e无\u003c/option\u003e\u003coption value=\"男\"\u003e男\u003c/option\u003e\u003coption value=\"女\"\u003e女\u003c/option\u003e\u003coption value=\"双性\"\u003e双性\u003c/option\u003e\u003coption value=\"其他\"\u003e其他\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\u003cdiv class=\"form-group\"\u003e\u003clabel for=\"char3Age\"\u003e年龄\u003c/label\u003e\u003cinput type=\"number\" id=\"char3Age\" min=\"0\" max=\"999\" placeholder=\"无\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char3Appearance\"\u003e身材外貌\u003c/label\u003e\u003ctextarea id=\"char3Appearance\" rows=\"2\" placeholder=\"例如：身高180cm，肌肉发达，寸头，脸上有刀疤...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"char3Persona\"\u003e详细人设\u003c/label\u003e\u003ctextarea id=\"char3Persona\" rows=\"3\" placeholder=\"例如：职业：黑帮老大；穿着：黑色皮夹克；性格：残暴冷酷，占有欲强...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003c/div\u003e\u003c/details\u003e\u003cdetails id=\"mod-section\" class=\"collapsible-section\"\u003e\u003csummary class=\"collapsible-header\"\u003eMOD制作工坊\u003c/summary\u003e\u003cdiv class=\"collapsible-content\"\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"modName\"\u003eMOD名称 (必须是英文/拼音, 无空格)\u003c/label\u003e\u003cinput type=\"text\" id=\"modName\" placeholder=\"例如: ExtraAbilities\"\u003e\u003c/div\u003e\u003cdiv class=\"form-group full-width\"\u003e\u003clabel for=\"modContent\"\u003eMOD内容\u003c/label\u003e\u003ctextarea id=\"modContent\" rows=\"5\" placeholder=\"在此输入你的MOD指令或设定...\"\u003e\u003c/textarea\u003e\u003c/div\u003e\u003cdiv class=\"button-group\"\u003e\u003cbutton type=\"button\" class=\"action-btn generate-btn\" id=\"previewModBtn\"\u003e预览并准备复制MOD\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/details\u003e\u003c/form\u003e\u003cdiv class=\"button-group\"\u003e\u003cbutton class=\"action-btn generate-btn\" id=\"generateBtn\"\u003e生成故事设定\u003c/button\u003e\u003cbutton class=\"action-btn reset-btn\" id=\"resetBtn\" type=\"button\"\u003e一键重置\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv id=\"previewModal\"\u003e\u003cdiv class=\"modal-content\"\u003e\u003ch3 id=\"previewTitle\"\u003e故事设定预览\u003c/h3\u003e\u003cdiv id=\"previewContent\"\u003e\u003c/div\u003e\u003cdiv class=\"preview-buttons\"\u003e\u003cbutton class=\"confirm-btn\" id=\"confirmCopyBtn\"\u003e复制设定\u003c/button\u003e\u003cbutton class=\"return-btn\" id=\"returnEditBtn\"\u003e返回修改\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv id=\"modInstructionModal\"\u003e\u003cdiv class=\"modal-content\" style=\"border-color: var(--info-border); box-shadow: 0 0 30px rgba(52, 152, 219, 0.5);\"\u003e\u003ch3 style=\"color: var(--info-border);\"\u003eMOD复制成功！\u003c/h3\u003e\u003cp style=\"text-align: center; font-size: 1.1em; margin: 20px 0;\"\u003e请点击右上角设置→自定义配置→提示词，进行粘贴保存，即成功加载MOD。\u003c/p\u003e\u003cdiv class=\"preview-buttons\"\u003e\u003cbutton class=\"return-btn\" id=\"closeInstructionBtn\"\u003e关闭\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cscript\u003edocument.addEventListener('DOMContentLoaded', () =\u003e {const getEl = (id) =\u003e document.getElementById(id);const mainContainer = getEl('mainContainer');const quickNav = getEl('quickNav');const previewModal = getEl('previewModal');const modInstructionModal = getEl('modInstructionModal');const previewTitle = getEl('previewTitle');const previewContent = getEl('previewContent');const confirmCopyBtn = getEl('confirmCopyBtn');const returnEditBtn = getEl('returnEditBtn');function showToast(message, duration = 3000) {const toastContainer = getEl('toast-container');const toast = document.createElement('div');toast.className = 'toast';toast.textContent = message;toastContainer.appendChild(toast);setTimeout(() =\u003e { toast.classList.add('show'); }, 10);setTimeout(() =\u003e {toast.classList.remove('show');toast.addEventListener('transitionend', () =\u003e toast.remove());}, duration);}\nfunction performCopy(text) {const tempTextarea = document.createElement('textarea');tempTextarea.value = text;tempTextarea.style.position = 'fixed';tempTextarea.style.opacity = '0';document.body.appendChild(tempTextarea);tempTextarea.select();tempTextarea.setSelectionRange(0, 99999);try {document.execCommand('copy');return true;} catch (err) {console.error('复制失败:', err);return false;} finally {document.body.removeChild(tempTextarea);}}\nfunction openStoryPreview() {previewModal.dataset.mode = 'story';previewTitle.textContent = '故事设定预览';confirmCopyBtn.textContent = '复制设定';returnEditBtn.textContent = '返回修改';const protagonist = {name: getEl('protagonistName').value, gender: getEl('protagonistGender').value, age: getEl('protagonistAge').value,appearance: getEl('protagonistAppearance').value, persona: getEl('protagonistPersona').value, power: getEl('protagonistPower').value};const worldInfo = getEl('worldInfo').value;const creationNeeds = { scene: getEl('scene').value, event: getEl('event').value, specialRequirements: getEl('specialRequirements').value };const orientations = Array.from(document.querySelectorAll('.orientation-style:checked')).map(el =\u003e el.value);const povs = [];if (getEl('povFirst').checked) povs.push('第一人称');if (getEl('povSecond').checked) povs.push('第二人称');if (getEl('povThird').checked) povs.push('第三人称');const writingStyles = Array.from(document.querySelectorAll('.writing-style:checked')).map(el =\u003e el.value);const chars = [];for (let i = 1; i \u003c= 3; i++) {const charName = getEl(`char${i}Name`).value; const charGender = getEl(`char${i}Gender`).value;if (charName || charGender) {chars.push({name: charName, gender: charGender, age: getEl(`char${i}Age`).value,appearance: getEl(`char${i}Appearance`).value, persona: getEl(`char${i}Persona`).value});}}\nlet previewText = `肉文助手V3.2：一个根据用户需求生成小说的工具。\\n--- 创作风格与视角 ---\\n创作性向：${orientations.length \u003e 0 ? orientations.join(', ') : '未选择'}\\n叙事视角：${povs.length \u003e 0 ? povs.join(', ') : '未选择'}\\n小说文风：${writingStyles.length \u003e 0 ? writingStyles.join(', ') : '未选择'}\\n`;if (worldInfo) { previewText += `--- 世界观设定 ---\\n${worldInfo}\\n`; }\npreviewText += `--- 主角信息 ---\\n姓名：${protagonist.name || '未填写'}\\n性别：${protagonist.gender || '未填写'}\\n年龄：${protagonist.age || '未填写'}\\n身材外貌：${protagonist.appearance || '无'}\\n详细人设：${protagonist.persona || '无'}\\n外挂/金手指：${protagonist.power || '无'}\\n`;previewText += `--- 创作需求 ---\\n创作场景：${creationNeeds.scene || '无'}\\n创作事件：${creationNeeds.event || '无'}\\n特殊需求/XP：${creationNeeds.specialRequirements || '无'}\\n`;if (chars.length \u003e 0) {previewText += `--- 定制角色信息 ---\\n`;chars.forEach((char, index) =\u003e {previewText += `角色${index + 1}：姓名：${char.name || '无'}, 性别：${char.gender || '无'}, 年龄：${char.age || '无'}, 身材外貌：${char.appearance || '无'}, 详细人设：${char.persona || '无'}\\n`;});}\npreviewContent.textContent = previewText.trim();previewModal.style.display = 'flex';}\nfunction openModPreview() {const modName = getEl('modName').value.trim();const modContent = getEl('modContent').value.trim();if (!modName || !modContent) { showToast('MOD名称和内容不能为空！', 2000); return; }\npreviewModal.dataset.mode = 'mod';previewTitle.textContent = 'MOD 预览';confirmCopyBtn.textContent = '复制MOD';returnEditBtn.textContent = '关闭';const formattedMod = `\u003cMOD_${modName}\u003e${modContent}\u003c/MOD_${modName}\u003e`;previewContent.textContent = formattedMod;previewModal.style.display = 'flex';}\nconfirmCopyBtn.addEventListener('click', () =\u003e {const mode = previewModal.dataset.mode;const textToCopy = previewContent.textContent;if (!textToCopy) return;if (performCopy(textToCopy)) {previewModal.style.display = 'none';if (mode === 'mod') {modInstructionModal.style.display = 'flex';} else {showToast('故事设定已成功复制！');}} else {showToast('复制失败，浏览器可能不支持此操作。');}});getEl('generateBtn').addEventListener('click', openStoryPreview);getEl('previewModBtn').addEventListener('click', openModPreview);getEl('resetBtn').addEventListener('click', () =\u003e { getEl('story-form').reset(); showToast('所有设定已清空！', 2000); });const closeModal = () =\u003e {previewModal.style.display = 'none';};returnEditBtn.addEventListener('click', closeModal);previewModal.addEventListener('click', (e) =\u003e { if (e.target === previewModal) closeModal(); });getEl('closeInstructionBtn').addEventListener('click', () =\u003e { modInstructionModal.style.display = 'none'; });getEl('closeNavBtn').addEventListener('click', () =\u003e { quickNav.classList.add('hidden'); });document.querySelectorAll('.quick-nav a').forEach(anchor =\u003e {anchor.addEventListener('click', function (e) {e.preventDefault();const targetId = this.getAttribute('href');const targetElement = document.querySelector(targetId);if (targetElement \u0026\u0026 mainContainer) {const containerRect = mainContainer.getBoundingClientRect();const targetRect = targetElement.getBoundingClientRect();const scrollTop = mainContainer.scrollTop;const offset = targetRect.top - containerRect.top - 20;mainContainer.scrollTo({ top: offset, behavior: 'smooth' });}});});});\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e","cover":"https://catai.wiki/1bb919c6-5ef0-4594-eb90-0265c52be500/cover","cover_tiny":"","summary":"［且行且珍惜］元旦快乐，感谢陪伴。更新：优化结构降耗，对状态栏、女性向、色情增强等功能进行了拆分，避免误触发导致增耗，需要安装MOD主动开启，并加入了MOD系统，能够更好的调动自设、MOD，后续有空将会不断更新各类MOD，包括常规同人MOD、肉文MOD、玩法MOD等，功能测试中，有问题请友善反馈，爱你们。全视角，全性向设定、全性向角色状态栏，多文风调教，写文、自定义均可。您可以用我创作任何满足您幻想的文学作品，可以适应任何世界观、任何文风创作，无论是都市的逆天邪神、重活了，玄幻的斗破苍穹、武动乾坤大主宰斗罗大陆、龙王传说绝世唐门轮回乐园赘婿龙族，还是修仙的凡人修仙传、诛仙，或者金庸古龙的传统武侠、雪中剑来等仙侠，亦或者诡异、惊悚的恐怖复苏、亦或者动漫同人的死神海贼王火影忍者七龙珠咒术回战轻音少女少女乐队mygo、邦多利、缘之空、电棍、东雪莲asoul嘉然乃琳贝拉珈乐向晚七海阿梓冰糖塔菲东海帝皇诗歌剧阿巴阿巴","is_anonymous":true,"memo":"","reward_points":0,"category":0,"total_fish_balls":0,"type":1,"is_public":true,"language":"zh-Hans","age_rating":1,"gender":1,"is_web3_app":false,"review_status":0,"is_available_not_public":true,"average_cost_per_message":2125,"players_count":113032,"conv_count_for_avg_msg_per_conv":100,"like_count":1248,"rating_count":139,"avg_rating_score":9.1,"depth_play_user_count":32908,"avg_play_round_count":41,"overall_rank":88686699309,"score":0,"first_published_at":