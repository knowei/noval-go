1. 整体字体与基础背景优化 */\nbody {\n    background-color: #fafaf5; /* 更明亮纯色背景，减少暗色 */\n    font-family: \"HYWenHei\", \"Microsoft YaHei\", sans-serif !important; /* 统一字体 */\n    color: #333; /* 全局字体颜色增强可读性 */\n}\n\n/* 2. 旅行者对话框 - 白金简洁风格（优化显示效果） */\ndiv.relative.inline-block.px-4.py-3.max-w-full.text-gray-900.bg-gray-100\\/90.rounded-xl.text-sm {\n    background: rgba(255, 255, 255, 0.95) !important; /* 让背景更接近纯白，减少半透明感 */\n    color: #2e2e2e !important; /* 改用更深的文字颜色，增强对比 */\n    border: 2px solid #d4b16a !important; /* 更饱和的金色边框，符合原神风格 */\n    border-radius: 15px 2px 15px 15px !important;\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15) !important; /* 改善阴影，使其更柔和 */\n    margin-left: auto;\n    display: table;\n    font-weight: bold; /* 提升字体清晰度和重要性 */\n}\n\n/* 3. AI回复框 - 派蒙/剧情对话风格（优化背景和字体明晰度） */\ndiv.relative.inline-block.px-4.py-3.w-full.bg-gray-100\\/90.rounded-xl.text-sm.text-gray-900 {\n    background: rgba(255, 255, 255, 0.98) !important; /* 更纯的羊皮纸色，减少灰度 */\n    color: #1e2b3f !important; /* 更深的灰蓝色，增强对比 */\n    border-left: 5px solid #d4b16a !important; /* 保持金边 */\n    border-radius: 4px 15px 15px 15px !important;\n    box-shadow: 4px 4px 8px rgba(0, 0, 0, 0.15) !important; /* 更温和的阴影 */\n    margin-bottom: 24px !important;\n    font-weight: 600; /* 增强字体明显 */\n}\n\n/* 4. 悬浮按钮通用样式 (mod、总结、流式) - 适应明亮背景 */\n.MuiButtonBase-root.MuiButton-root.MuiButton-outlined.css-1v19tbs {\n    background-color: #4a4a4a !important; /* 变暗以提升对比 */\n    color: #ffffff !important; /* 字体颜色变白 */\n    border: 1px solid #888; /* 更柔和的边框色 */\n    border-radius: 4px !important; /* 保持直角微圆角 */\n    font-weight: 600 !important;\n    transition: all 0.2s ease !important;\n    clip-path: polygon(10% 0%, 100% 0%, 90% 100%, 0% 100%);\n    padding: 6px 20px !important;\n}\n\n/* 悬浮按钮悬停动效 - 提升对比，视觉更明显 */\n.MuiButtonBase-root.MuiButton-root.MuiButton-outlined.css-1v19tbs:hover {\n    background-color: #5a5a5a !important;\n    color: #fff !important;\n    border-color: #d4b16a !important; /* 保持金色边框 */\n    transform: scale(1.05);\n}\n\n/* 5. 隐藏功能按钮（优化色调，增强辨识度） */\n.MuiButtonBase-root.MuiButton-root.MuiButton-outlined.css-1qqza4v {\n    background-color: #d4b16a !important; /* 明亮金色背景 */\n    color: #2b2b2b !important;\n    border-radius: 50% !important;\n    min-width: 40px !important;\n    width: 40px !important;\n    height: 40px !important;\n    border: 2px solid #ccc !important; /* 更淡的边框 */\n    box-shadow: 0 0 10px rgba(210, 172, 101, 0.3) !important; /* 柔和光晕 */\n}\n\n/* 6. 用户消息输入框美化 */\n.rc-textarea {\n    background: #fff !important; /* 纯白背景，增强清晰度 */\n    border: 2px solid #d4b16a !important; /* 金色边框，符合主题 */\n    border-radius: 8px !important;\n    color: #1e2b3f !important; /* 深色字体，易读 */\n    padding: 12px 16px !important;\n    font-weight: 600; /* 提升字体明显 */\n    font-size: 16px; /* 明显字体大小 */\n    outline: none !important;\n}\n\n/* 输入框焦点样式 */\n.rc-textarea:focus {\n    border-color: #d4b16a !important; /* 保持金色边框 */\n    box-shadow: 0 0 8px rgba(210, 172, 101, 0.4) !important; /* 柔光效果增强对比 */\n}\n\n/* 7. 输入框外层容器装饰（增加明显提示） */\n.relative.block.w-full:has(.rc-textarea)::before {\n    content: \"✦\";\n    position: absolute;\n    left: -20px;\n    top: 50%;\n    transform: translateY(-50%);\n    color: #d4b16a; /* 金色提示符号 */\n    font-size: 20px; /* 更大更明显 */\n    font-weight: bold;\n}\n\n/* 8. 滚动条 - 原神风格明亮化和改善可视性 */\n::-webkit-scrollbar {\n    width: 8px;\n}\n::-webkit-scrollbar-track {\n    background: rgba(255, 255, 255, 0.6); /* 更亮的轨道背景 */\n}\n::-webkit-scrollbar-thumb {\n    background: #d4b16a; /* 保持金色调 */\n    border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n    background: #fae392; /* 更亮的悬停色，便于辨认 */\n}","shortcut_commands":[],"preset_type":1,"preset_chats":[],"is_have_cg_image":false,"bgm":{"autoplay":true,"tracks":[{"id":"53eed117-42a5-4d18-b212-f4c9c1d81499","song":"少女-银月之庭【蓝花】","url":"https://bg-music.catai.wiki/music/5119f313-38ab-4929-a614-9a242de30166/53eed117-42a5-4d18-b212-f4c9c1d81499.mp3","cover":"https://bg-music.catai.wiki/covers/5119f313-38ab-4929