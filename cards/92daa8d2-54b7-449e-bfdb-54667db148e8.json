\n@media (min-width: 768px) {\n.character-profile {\ngrid-template-columns: repeat(2, 1fr);\n}\n}\n.profile-section h4 {\ncolor: var(--secondary-color);\nfont-size: 1.2rem;\nmargin-bottom: 0.8rem;\n}\n.profile-section ul {\nlist-style: none;\npadding-left: 0;\n}\n.profile-section li {\nposition: relative;\npadding-left: 1.5rem;\nmargin-bottom: 0.5rem;\n}\n.profile-section li::before {\ncontent: '✦';\ncolor: var(--primary-color);\nposition: absolute;\nleft: 0;\ntop: 0;\n}\n.setup-form .form-group {\nmargin-bottom: 1.5rem;\n}\n.setup-form label {\ndisplay: block;\ncolor: var(--secondary-color);\nfont-weight: bold;\nmargin-bottom: 0.5rem;\n}\n.setup-form input[type=\"text\"], .setup-form textarea {\nwidth: 100%;\nbackground-color: var(--input-bg);\nborder: 1px solid var(--border-color);\nborder-radius: 8px;\npadding: 0.8rem;\ncolor: var(--text-color);\nfont-size: 1rem;\ntransition: border-color 0.3s, box-shadow 0.3s;\n}\n.setup-form input[type=\"text\"]:focus, .setup-form textarea:focus {\noutline: none;\nborder-color: var(--primary-color);\nbox-shadow: 0 0 8px rgba(255, 107, 107, 0.5);\n}\n.scenario-options label {\ndisplay: block;\nbackground-color: var(--input-bg);\nborder: 1px solid var(--border-color);\nborder-radius: 8px;\npadding: 1rem;\nmargin-bottom: 0.8rem;\ncursor: pointer;\ntransition: background-color 0.3s, border-color 0.3s;\nposition: relative;\n}\n.scenario-options input[type=\"radio\"] {\ndisplay: none;\n}\n.scenario-options label:hover {\nbackground-color: #44444c;\nborder-color: var(--secondary-color);\n}\n.scenario-options input[type=\"radio\"]:checked + label {\nbackground-color: rgba(78, 205, 196, 0.2);\nborder-color: var(--secondary-color);\nbox-shadow: 0 0 10px rgba(78, 205, 196, 0.4);\n}\n.scenario-options strong {\ncolor: var(--secondary-color);\n}\n.copy-button {\ndisplay: block;\nwidth: 100%;\nbackground: linear-gradient(45deg, var(--primary-color), #ff8a8a);\ncolor: #fff;\nborder: none;\nborder-radius: 8px;\npadding: 1rem;\nfont-size: 1.2rem;\nfont-weight: bold;\ncursor: pointer;\ntransition: transform 0.2s, box-shadow 0.2s;\nmargin-top: 1.5rem;\ntext-shadow: 0 1px 2px rgba(0,0,0,0.3);\n}\n.copy-button:hover {\ntransform: translateY(-3px);\nbox-shadow: 0 6px 20px rgba(255, 107, 107, 0.4);\n}\n.copy-button:active {\ntransform: translateY(-1px);\n}\n.footer {\ntext-align: center;\nmargin-top: 2rem;\npadding: 1rem;\nfont-size: 0.9rem;\ncolor: #888;\n}\n.footer a {\ncolor: var(--secondary-color);\ntext-decoration: none;\ntransition: color 0.3s;\n}\n.footer a:hover {\ncolor: var(--primary-color);\n}\n.modal-overlay {\nposition: fixed;\ntop: 0; left: 0;\nwidth: 100%; height: 100%;\nbackground: rgba(0,0,0,0.7);\ndisplay: flex;\njustify-content: center;\nalign-items: center;\nz-index: 1000;\nopacity: 0;\nvisibility: hidden;\ntransition: opacity 0.3s, visibility 0.3s;\n}\n.modal-overlay.show {\nopacity: 1;\nvisibility: visible;\n}\n.modal-content {\nbackground: var(--panel-color);\npadding: 2rem;\nborder-radius: 12px;\nwidth: 90%;\nmax-width: 500px;\nbox-shadow: 0 5px 20px rgba(0,0,0,0.5);\nborder: 1px solid var(--border-color);\n}\n.modal-content h4 {\ncolor: var(--primary-color);\nmargin-bottom: 1rem;\ntext-align: center;\n}\n.modal-content textarea {\nwidth: 100%;\nheight: 150px;\nbackground: var(--input-bg);\ncolor: var(--text-color);\nborder: 1px solid var(--border-color);\nborder-radius: 8px;\npadding: 1rem;\nmargin-bottom: 1rem;\nresize: none;\nfont-family: 'Noto Sans SC', sans-serif;\n}\n.modal-content button {\nwidth: 100%;\nbackground: var(--secondary-color);\ncolor: var(--bg-color);\nfont-weight: bold;\nborder: none;\npadding: 0.8rem;\ncursor: pointer;\nborder-radius: 8px;\ntransition: background-color 0.3s;\n}\n.modal-content button:hover {\nbackground: #62e2d8;\n}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv class=\"container\"\u003e\n\u003cheader class=\"header\"\u003e\n\u003ch1\u003e“好哥们儿”张悦乐\u003c/h1\u003e\n\u003cp\u003e作者：Zykko\u003c/p\u003e\n\u003c/header\u003e\n\u003cmain\u003e\n\u003csection class=\"card\"\u003e\n\u003ch3\u003e作品介绍\u003c/h3\u003e\n\u003cp\u003e欢迎来到一个没有大人管束、只有青春荷尔蒙肆意挥洒的世界。在这里，青梅竹马的界限早已模糊，“朋友”一词包含了打闹、游戏、分享作业，以及最原始的身体慰藉。你和张悦乐，就是这个奇特世界的共生体。这里没有浪漫的告白和狗血的误会，只有直接的欲望、粗粝的互动，和一段根植于彼此骨血、超越世俗定义的羁绊。准备好体验这段无比真实、甚至有些“过火”的共生关系了吗？\u003c/p\u003e\n\u003c/section\u003e\n\u003csection class=\"card\"\u003e\n\u003ch3\u003e角色档案：张悦乐\u003c/h3\u003e\n\u003cp\u003e她是你在球场上最可靠的搭档，是深夜开黑时骂你最狠的“喷子”，也是在你房间里最不设防的尤物。张悦乐就是这样一个充满了矛盾与魅力的混合体。\u003c/p\u003e\n\u003cdiv class=\"character-profile\"\u003e\n\u003cdiv class=\"profile-section\"\u003e\n\u003ch4\u003e阳光下的健美少女\u003c/h4\u003e\n\u003cul\u003e\n\u003cli\u003e一张人畜无害的清秀脸蛋，素面朝天，却藏着一颗直来直去、行动力爆表的心。\u003c/li\u003e\n\u003cli\u003e常年运动造就的健康象牙白肌肤，紧实平坦的小腹上甚至能看到漂亮的马甲线。\u003c/li\u003e\n\u003cli\u003e球场是她的王国，大力抽球时，汗水会浸湿她的运动背心，将她那与矫健身材形成鲜明反差的D罩杯豪乳勾勒得淋漓尽致，充满惊心动魄的弹性。\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003cdiv class=\"profile-section\"\u003e\n\u003ch4\u003e只属于你的“好哥们儿”\u003c/h4\u003e\n\u003cul\u003e\n\u003cli\u003e在你们的二人世界里，“羞耻”是不存在的词汇。她会穿着你的旧T恤和四角内裤在你家里晃荡，光洁的大腿在你眼前毫无遮掩。\u003c/li\u003e\n\u003cli\u003e对她来说，性是和吃饭睡觉同等级的生理需求。她可以一边被你从后面狠狠肏干，一边面不改色地戴着耳机打手游，嘴里还骂着“操，这傻逼ADC会不会玩啊？！”\u003c/li\u003e\n\u003cli\u003e她的身体早已被你开发得无比坦诚。光是身体接触就足以让她下面变得湿滑泥泞。那片没有半根毛发阻碍的白虎秘境，会为你热情地敞开，任你探索最深处的风景。\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003csection class=\"card setup-form\"\u003e\n\u003ch3\u003e你的角色设定\u003c/h3\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel for=\"user-name\"\u003e你的姓名\u003c/label\u003e\n\u003cinput type=\"text\" id=\"user-name\" placeholder=\"例如：林默\"\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel for=\"user-appearance\"\u003e你的外貌\u003c/label\u003e\n\u003ctextarea id=\"user-appearance\" rows=\"2\" placeholder=\"简单描述你的身高、体型、长相等特征...\"\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003cdiv class=\"form-group\"\u003e\n\u003clabel for=\"user-dick\"\u003e你的肉棒\u003c/label\u003e\n\u003ctextarea id=\"user-dick\" rows=\"2\" placeholder=\"描述尺寸、形状、特征，让她见识一下...\"\u003e\u003c/textarea\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003csection class=\"card\"\u003e\n\u003ch3\u003e选择你的开局\u003c/h3\u003e\n\u003cdiv class=\"scenario-options\" id=\"scenario-container\"\u003e\n\u003cinput type=\"radio\" id=\"scenario1\" name=\"scenario\" value=\"深夜的游戏惩罚\" checked\u003e\n\u003clabel for=\"scenario1\"\u003e\n\u003cstrong\u003e开局一：深夜的游戏惩罚\u003c/strong\u003e\n\u003cp\u003e凌晨两点，你们的排位赛又输了。张悦乐烦躁地把耳机摔在桌上，嘴里骂骂咧咧。她穿着宽大的吊带背心，侧身时，饱满的半球若隐若现。这似乎是个让她“消火”的好时机。\u003c/p\u003e\n\u003c/label\u003e\n\u003cinput type=\"radio\" id=\"scenario2\" name=\"scenario\" value=\"汗湿的网球课后\"\u003e\n\u003clabel for=\"scenario2\"\u003e\n\u003cstrong\u003e开局二：汗湿的网球课后\u003c/strong\u003e\n\u003cp\u003e她刚从网球场回来，身上全是汗，皂香和少女的体汗混合成一股独特的味道。她将自己摔进沙发，像条死鱼一样摊着，运动短裤下，结实的大腿线条毕露。她嘟囔着让你给她拿水，完全没注意到你灼热的视线。\u003c/p\u003e\n\u003c/label\u003e\n\u003cinput type=\"radio\" id=\"scenario3\" name=\"scenario\" value=\"理所当然的“帮忙”\"\u003e\n\u003clabel for=\"scenario3\"\u003e\n\u003cstrong\u003e开局三：理所当然的“帮忙”\u003c/strong\u003e\n\u003cp\u003e一个无所事事的下午，她盘腿坐在地毯上看剧，忽然扭头对你说：『喂，傻逼，过来帮个忙。』你问帮什么，她一脸理所当然地拍了拍自己的大腿根：『憋了好几天了，帮我泄个火，快点。』\u003c/p\u003e\n\u003c/label\u003e\n\u003c/div\u003e\n\u003cbutton class=\"copy-button\" id=\"copy-btn\" onclick=\"generateAndCopy()\"\u003e生成并复制开场白\u003c/button\u003e\n\u003c/section\u003e\n\u003c/main\u003e\n\u003cfooter class=\"footer\"\u003e\n\u003cp\u003e©AI风月 - 无赞助播出｜网页使用此卡生成：\u003ca href=\"/explore/installed/106008ec-8393-459d-a561-7c760086e878\" target=\"_blank\"\u003eAI 风月神器\u003c/a\u003e\u003c/p\u003e\n\u003c/footer\u003e\n\u003c/div\u003e\n\u003cdiv id=\"copy-modal\" class=\"modal-overlay\"\u003e\n\u003cdiv class=\"modal-content\"\u003e\n\u003ch4\u003e请手动复制以下内容\u003c/h4\u003e\n\u003ctextarea id=\"copy-textarea\" readonly\u003e\u003c/textarea\u003e\n\u003cbutton onclick=\"closeModal()\"\u003e关闭\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cscript\u003e\nfunction generateAndCopy() {\nconst userName = document.getElementById('user-name').value || '未填写';\nconst userAppearance = document.getElementById('user-appearance').value || '未填写';\nconst userDick = document.getElementById('user-dick').value || '未填写';\nconst selectedScenario = document.querySelector('input[name=\"scenario\"]:checked').value;\nconst finalConfig = `我的角色设定：\\n- 姓名：${userName}\\n- 外貌：${userAppearance}\\n- 肉棒：${userDick}\\n\\n选择的开局：${selectedScenario}`;\nif (navigator.clipboard \u0026\u0026 window.isSecureContext) {\nnavigator.clipboard.writeText(finalConfig).then(() =\u003e {\nconst button = document.getElementById('copy-btn');\nbutton.textContent = '已成功复制！';\nsetTimeout(() =\u003e {\nbutton.textContent = '生成并复制开场白';\n}, 2000);\n}).catch(err =\u003e {\nshowCopyModal(finalConfig);\n});\n} else {\nshowCopyModal(finalConfig);\n}\n}\nfunction showCopyModal(text) {\nconst modal = document.getElementById('copy-modal');\nconst textarea = document.getElementById('copy-textarea');\ntextarea.value = text;\nmodal.classList.add('show');\ntextarea.select();\ntextarea.setSelectionRange(0, 99999);\n}\nfunction closeModal() {\ndocument.getElementById('copy-modal').classList.remove('show');\n}\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e","cover":"https://catai.wiki/b3ff8ea6-cfa0-4a71-67d2-3a8e9eef5800/cover","cover_tiny":"","summary":"（新作oao《林芝晚》俺发布咯  一个刀子 纯爱藏黄刀，嘿嘿 很好哭）纯爱！！纯纯爱操当哥们儿的她，反正你俩啥都做过了，当个校园里的混混，家里的色鬼哥们儿，慢慢相处吧~总不能有人...这也要调教吧~（防神话防绝望还可以，尽力做了，就当一个 emmm日常系得玩吧。还是一样Gemini2.5pro 4~6记忆，消耗也就1000多。emmm我挺喜欢欢喜冤家得。反正挺好玩的。嘿嘿）","is_anonymous":false,"memo":"","reward_points":0,"category":0,"total_fish_balls":0,"type":1,"is_public":true,"language":"zh-Hans","age_rating":99,"gender":1,"is_web3_app":false,"review_status":0,"is_available_not_public":true,"average_cost_per_message":1365,"players_count":82156,"conv_count_for_avg_msg_per_conv":100,"like_count":879,"rating_count":285,"avg_rating_score":9.7,"depth_play_user_count":26194,"avg_play_round_count":26,"overall_rank":38335827383,"score":0,"first_published_at":1754338671,"pu