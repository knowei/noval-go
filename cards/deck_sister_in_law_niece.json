  "custom_html": "<!DOCTYPE html>\n<html lang=\"zh-Hans\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>雨夜来客</title>\n<style>\n*{box-sizing:border-box}body{margin:0;background:linear-gradient(145deg,#090e14,#131d28);color:#edf1f5;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Microsoft YaHei\",sans-serif}.wrap{max-width:860px;margin:auto;padding:18px}.hero{padding:28px 24px;border:1px solid rgba(218,180,108,.28);border-radius:20px;background:radial-gradient(circle at 90% 5%,rgba(111,164,198,.2),transparent 38%),linear-gradient(135deg,#223040,#111922);box-shadow:0 20px 55px rgba(0,0,0,.35)}.hero small{color:#ddb975;letter-spacing:.2em}.hero h1{margin:8px 0;font-size:29px}.hero p{margin:0;color:#c4cbd3;line-height:1.8}.tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:16px}.tag{padding:6px 9px;border:1px solid rgba(218,180,108,.25);border-radius:99px;background:rgba(218,180,108,.08);color:#dec896;font-size:12px}.tabs{display:flex;gap:8px;margin:13px 0}.tab{flex:1;padding:12px;border:1px solid rgba(255,255,255,.09);border-radius:11px;background:rgba(255,255,255,.04);color:#99a5b1;font-weight:700;cursor:pointer}.tab.active{border-color:rgba(218,180,108,.42);background:linear-gradient(135deg,rgba(218,180,108,.17),rgba(111,164,198,.08));color:#fff}.pane{display:none}.pane.active{display:block}.card{margin-top:12px;padding:18px;border:1px solid rgba(255,255,255,.08);border-radius:15px;background:rgba(21,29,39,.92);box-shadow:0 12px 32px rgba(0,0,0,.2)}.card h2{margin:0 0 13px;color:#f2d49b;font-size:17px}.card p{margin:0 0 10px;color:#c9d0d7;line-height:1.8}.people{display:grid;grid-template-columns:1fr 1fr;gap:11px}.person{padding:15px;border:1px solid rgba(255,255,255,.08);border-radius:13px;background:rgba(31,42,54,.78)}.person b{display:block;margin-bottom:5px}.person small{color:#d8b678}.person p{margin-top:8px;font-size:13px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:11px}.stat{padding:8px 5px;border-radius:8px;background:rgba(0,0,0,.22);text-align:center}.stat span{display:block;color:#8f9ba7;font-size:10px}.stat strong{color:#ebd09a;font-size:12px}.notice{padding:12px 13px;border-left:3px solid #75a7c6;border-radius:8px;background:rgba(117,167,198,.09);color:#c8dae5;line-height:1.7}.grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.field{margin-bottom:11px}.field.full{grid-column:1/-1}.field label{display:block;margin-bottom:6px;color:#c7cdd4;font-size:12px}.input{width:100%;padding:10px 11px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(5,9,14,.72);color:#fff;outline:none}.input:focus{border-color:#bc9655;box-shadow:0 0 0 3px rgba(218,180,108,.08)}textarea.input{min-height:72px;resize:vertical}.fixed{padding:10px 11px;border:1px dashed rgba(218,180,108,.34);border-radius:9px;background:rgba(218,180,108,.06);color:#ddc797}.preview{min-height:170px;padding:13px;border:1px solid rgba(218,180,108,.22);border-radius:10px;background:rgba(4,8,12,.7);white-space:pre-wrap;color:#d5dbe1;line-height:1.72}.btn{width:100%;margin-top:11px;padding:12px;border:0;border-radius:9px;background:linear-gradient(100deg,#896535,#d9b46f);color:#171109;font-weight:800;cursor:pointer}.toast{display:none;margin-top:9px;color:#79b79a;text-align:center}.tip{color:#8f9ba7;font-size:11px;line-height:1.6}@media(max-width:680px){.wrap{padding:9px}.hero{padding:22px 17px}.people,.grid{grid-template-columns:1fr}.field.full{grid-column:auto}.stats{grid-template-columns:1fr 1fr}}\n</style>\n</head>\n<body>\n<main class=\"wrap\">\n<header class=\"hero\"><small>A RAINY NIGHT · ADULT FAMILY DRAMA</small><h1>雨夜来客</h1><p>哥哥欠债失踪后，36岁的嫂子带着18岁的女儿，在暴雨夜带着两只行李箱和一袋零散账单敲响了你的门。母女身无分文，原住处无法返回，也没有任何亲友或其他地方能够收留她们。</p><div class=\"tags\"><span class=\"tag\">共同生活</span><span class=\"tag\">债务谜团</span><span class=\"tag\">双成人路线</span><span class=\"tag\">动态内心</span><span class=\"tag\">身体状态</span><span class=\"tag\">自定义玩家</span></div></header>\n<nav class=\"tabs\"><button class=\"tab active\" data-pane=\"story\">作品档案</button><button class=\"tab\" data-pane=\"profile\">自定义玩家</button></nav>\n<section id=\"story\" class=\"pane active\">\n<div class=\"card\"><h2>☔ 开场局面</h2><p>周世杰经营失败、留下多笔来历不明的债务后失联。催债者频繁上门，林晚晴为了母女安全，只能带着女儿前来向身为弟弟的成年{{user}}求助。她们身无分文，原住处已无法返回，亲友也无人愿意或有能力收留，当晚没有旅馆、朋友家或其他安全落脚处可去，只能恳求{{user}}暂时收留。是否答应、如何安排共同生活、谁该承担债务以及哥哥去了哪里，仍由玩家决定。</p></div>\n<div class=\"card\"><h2>👥 人物档案</h2><div class=\"people\">\n<article class=\"person\"><small>36岁 · 嫂子</small><b>林晚晴</b><p>168cm、58kg，95/70/96，D杯。成熟丰润的梨形身材，腰腹柔软，臀腿饱满，日常穿着克制利落。她准备了一个只有遭到拒绝时才可能启用的秘密杀手锏；即使没有使用，这个念头也会长期留在内心。</p><div class=\"stats\"><div class=\"stat\"><span>身高</span><strong>168cm</strong></div><div class=\"stat\"><span>体重</span><strong>58kg</strong></div><div class=\"stat\"><span>罩杯</span><strong>D</strong></div><div class=\"stat\"><span>三围</span><strong>95/70/96</strong></div></div></article>\n<article class=\"person\"><small>18岁 · 侄女</small><b>周若宁</b><p>163cm、50kg，86/60/88，C杯。纤细匀称、腰线明显，动作轻快。刚高中毕业，从小依赖叔叔；成年后的她活泼嘴硬、爱坏笑挑衅，是懂得边界的“雌小鬼”型成年人。</p><div class=\"stats\"><div class=\"stat\"><span>身高</span><strong>163cm</strong></div><div class=\"stat\"><span>体重</span><strong>50kg</strong></div><div class=\"stat\"><span>罩杯</span><strong>C</strong></div><div class=\"stat\"><span>三围</span><strong>86/60/88</strong></div></div></article>\n<article class=\"person\"><small>39岁 · 失踪的哥哥</small><b>周世杰</b><p>债务与失踪原因均不明确，需要从合同、转账、通讯和来访者证词中逐步调查。</p></article>\n<article class=\"person\"><small>成年 · 玩家</small><b>{{user}}</b><p>周世杰的弟弟、林晚晴的小叔子、周若宁的叔叔。姓名、外貌、体型、职业、资产、住房、经验、偏好与边界均可自定义。</p></article>\n</div></div>\n<div class=\"card\"><h2>✦ 成人路线规则</h2><div class=\"notice\">林晚晴与周若宁均为成年人，分别拥有独立的恋爱与成人路线。雨夜投奔、无处可去的处境和此后的共同生活都可以直接成为路线起点，不要求先完成固定恋爱阶段、好感门槛或指定回合。嫂子的秘密预案在玩家明确拒绝收留后，也可触发一次成人路线的选择节点。玩家可以接受、拒绝、追问、谈条件、改变话题、只提供普通收留，或以自己的方式推进任意路线；系统不会替玩家作决定。进入具体成人行为前，相关成年人仍需在当轮清醒并明确表达意愿。</div></div>\n</section>\n<section id=\"profile\" class=\"pane\">\n<div class=\"card\"><h2>✦ 身份与身体档案</h2><div class=\"grid\">\n<div class=\"field\"><label>姓名或称呼</label><input id=\"p-name\" class=\"input\" placeholder=\"如：周砚 / 阿砚\"></div>\n<div class=\"field\"><label>年龄（必须满18岁）</label><input id=\"p-age\" class=\"input\" type=\"number\" min=\"18\" max=\"80\" value=\"30\"></div>\n<div class=\"field\"><label>固定家庭身份</label><div class=\"fixed\">周世杰的成年弟弟 · 林晚晴的小叔子 · 周若宁的叔叔</div></div>\n<div class=\"field\"><label>职业</label><input id=\"p-job\" class=\"input\" placeholder=\"如：公司管理层 / 律师 / 个体经营\"></div>\n<div class=\"field\"><label>身高（cm）</label><input id=\"p-height\" class=\"input\" type=\"number\" min=\"140\" max=\"230\" placeholder=\"180\"></div>\n<div class=\"field\"><label>体重（kg）</label><input id=\"p-weight\" class=\"input\" type=\"number\" min=\"40\" max=\"250\" placeholder=\"78\"></div>\n<div class=\"field\"><label>体型与外貌</label><input id=\"p-build\" class=\"input\" placeholder=\"如：肩背宽阔、短发、神情沉稳\"></div>\n<div class=\"field\"><label>私密身体资料（可留空）</label><input id=\"p-private\" class=\"input\" placeholder=\"只填写希望剧情明确采用的成年身体资料\"></div>\n<div class=\"field full\"><label>与哥哥一家的既往关系</label><textarea id=\"p-history\" class=\"input\" placeholder=\"如：哥哥常年疏远，若宁小时候经常由我照顾，和嫂子一直保持礼貌距离。\"></textarea></div>\n</div></div>\n<div class=\"card\"><h2>💰 住房与经济档案</h2><div class=\"grid\">\n<div class=\"field\"><label>住房情况</label><input id=\"p-home\" class=\"input\" placeholder=\"如：市中心三居室，全款独居\"></div>\n<div class=\"field\"><label>当前可用现金</label><input id=\"p-cash\" class=\"input\" placeholder=\"如：5万元\"></div>\n<div class=\"field\"><label>月收入</label><input id=\"p-income\" class=\"input\" placeholder=\"如：税后3万元\"></div>\n<div class=\"field\"><label>存款／投资</label><input id=\"p-savings\" class=\"input\" placeholder=\"如：存款80万，有少量基金\"></div>\n<div class=\"field\"><label>个人负债</label><input id=\"p-debt\" class=\"input\" placeholder=\"如：无负债 / 尚有120万房贷\"></div>\n<div class=\"field\"><label>可动用的人脉或资源</label><input id=\"p-resource\" class=\"input\" placeholder=\"如：律师朋友、银行渠道、警方熟人\"></div>\n</div></div>\n<div class=\"card\"><h2>⚖️ 立场、偏好与边界</h2>\n<div class=\"field\"><label>对留宿请求的态度</label><select id=\"p-attitude\" class=\"input\"><option>先让母女安全住下，再核对事实</option><option>可以短住，但必须约定期限和家规</option><option>愿意长期提供住处，但不替哥哥承担未知债务</option><option>暂不收留，先协助安排其他安全住处</option></select></div>\n<div class=\"field\"><label>当前感情倾向</label><select id=\"p-route\" class=\"input\"><option>暂不选择路线，先处理现实问题</option><option>更关注林晚晴，但不会利用她的困境</option><option>更关注成年后的周若宁，但会重新确认关系边界</option><option>保持开放，让关系随剧情自然变化</option></select></div>\n<div class=\"field\"><label>成年感情经验与偏好（可留空）</label><textarea id=\"p-pref\" class=\"input\" placeholder=\"填写希望影响亲密节奏、互动方式和描写重点的偏好。\"></textarea></div>\n<div class=\"field\"><label>明确边界／绝对禁止事项</label><textarea id=\"p-boundary\" class=\"input\" placeholder=\"如：不接受胁迫、醉酒推进或用金钱和住处交换亲密；任何人说停都必须停止。\"></textarea></div>\n<div class=\"field\"><label>其他补充</label><textarea id=\"p-extra\" class=\"input\" placeholder=\"可补充性格、恋爱状态、生活习惯、车辆、公司或其他资产。\"></textarea></div>\n</div>\n<div class=\"card\"><h2>📋 玩家档案预览</h2><p class=\"tip\">点击生成后复制到聊天框发送；未填写项目继续采用作品默认值。</p><div id=\"preview\" class=\"preview\"></div><button id=\"copy\" class=\"btn\" type=\"button\">生成并复制玩家档案</button><div id=\"toast\" class=\"toast\">✓ 已复制，请回到聊天中粘贴发送</div></div>\n</section>\n</main>\n<script>\nfunction q(s){return document.querySelector(s)}function v(s){var e=q(s);return e&&e.value?e.value.trim():\"\"}function profile(){var age=Math.max(18,Number(v(\"#p-age\"))||30);return[\"【雨夜来客｜玩家自定义档案】\",\"姓名或称呼：\"+(v(\"#p-name\")||\"未指定\"),\"年龄：\"+age+\"岁\",\"固定身份：周世杰的成年弟弟、林晚晴的小叔子、周若宁的叔叔\",\"职业：\"+(v(\"#p-job\")||\"未指定\"),\"身体资料：身高\"+(v(\"#p-height\")||\"未指定\")+\"cm｜体重\"+(v(\"#p-weight\")||\"未指定\")+\"kg｜体型外貌：\"+(v(\"#p-build\")||\"未补充\")+\"｜私密资料：\"+(v(\"#p-private\")||\"未填写，不得擅自推定\"),\"既往家庭关系：\"+(v(\"#p-history\")||\"未补充，沿用默认\"),\"【住房与经济】\",\"住房：\"+(v(\"#p-home\")||\"未指定\"),\"可用现金：\"+(v(\"#p-cash\")||\"未指定\"),\"月收入：\"+(v(\"#p-income\")||\"未指定\"),\"存款／投资：\"+(v(\"#p-savings\")||\"未指定\"),\"个人负债：\"+(v(\"#p-debt\")||\"未指定\"),\"可动用资源：\"+(v(\"#p-resource\")||\"未指定\"),\"【当前立场】\",\"留宿态度：\"+v(\"#p-attitude\"),\"感情倾向：\"+v(\"#p-route\"),\"成年感情经验与偏好：\"+(v(\"#p-pref\")||\"未填写，不得擅自推定\"),\"明确边界：\"+(v(\"#p-boundary\")||\"未额外填写，仍须遵守清醒、自愿和随时撤回规则\"),\"其他补充：\"+(v(\"#p-extra\")||\"无\"),\"【采用规则】以上内容只覆盖{{user}}资料，不修改林晚晴、周若宁、周世杰、既有关系和已发生事件；经济帮助与住处不代表任何具体亲密同意。\"].join(\"\\n\")}function render(){q(\"#preview\").textContent=profile()}document.querySelectorAll(\".tab\").forEach(function(b){b.addEventListener(\"click\",function(){document.querySelectorAll(\".tab\").forEach(function(x){x.classList.remove(\"active\")});document.querySelectorAll(\".pane\").forEach(function(x){x.classList.remove(\"active\")});b.classList.add(\"active\");q(\"#\"+b.dataset.pane).classList.add(\"active\")})});document.querySelectorAll(\".input\").forEach(function(x){x.addEventListener(\"input\",render)});q(\"#copy\").addEventListener(\"click\",async function(){var t=profile();try{await navigator.clipboard.writeText(t)}catch(e){var x=document.createElement(\"textarea\");x.value=t;document.body.appendChild(x);x.select();document.execCommand(\"copy\");x.remove()}q(\"#toast\").style.display=\"block\";setTimeout(function(){q(\"#toast\").style.display=\"none\"},2400)});render();\n</script>\n</body>\n</html>",
